"round" stroke-linejoin="round"><path d="M17.021 15.139H2.98V6.574L10 10.856l7.021-4.282v8.565zm0-10.277L10 9.144 2.979 4.862H17.02zm1.756 0c0-.943-.79-1.713-1.756-1.713H2.98c-.966 0-1.756.77-1.756 1.713v10.277c0 .942.79 1.712 1.756 1.712h14.04c.966 0 1.756-.77 1.756-1.712V4.862z"/></svg></a><a class="social-share__icon search-hidden-icon search-hidden-star"><div class="star-img"></div></a></div></div></div></div></div><div class="stream-item__fallback-image"><a class="stream-item__image ratio16x9" style="background-image: url(&quot;https://imageio.forbes.com/i-forbesimg/media/video/2023/11/16/6341247489112_still.jpg?format=jpg&amp;width=440&quot;)" href="https://www.forbes.com/video/6341247489112/" data-ga-track="undefined - Stream - Inside Former Google CEO Eric Schmidt's $1 Billion Philanthropic Troubles" aria-label="Graphic Inside Former Google CEO Eric Schmidt's $1 Billion Philanthropic Troubles"><div class="card__icon card__icon--preview">WATCH<svg version="1.1" class="fs-icon fs-icon--play-circle" xmlns="http://www.w3.org/2000/svg" x="0" y="0" viewBox="0 0 60 60" xml:space="preserve"><path class="fs-icon fs-icon--play" fill="#010101" d="M24.252 41.721V18.037l15.789 11.842z"/><path class="fs-icon fs-icon--circle" fill="#010101" d="M30 59.879c-16.542 0-30-13.457-30-30 0-16.542 13.458-30 30-30 16.543 0 30 13.458 30 30 0 16.543-13.457 30-30 30zm0-57.5c-15.164 0-27.5 12.336-27.5 27.5s12.336 27.5 27.5 27.5 27.5-12.336 27.5-27.5-12.336-27.5-27.5-27.5z"/></svg></div></a></div></article><div class="fbs-ad--moreon-wrapper" aria-hidden="true" role="presentation"><fbs-ad position="moreon"></fbs-ad></div><article class="stream-item et-promoblock-removeable-item et-promoblock-star-item" data-date="1699039639351" data-id="65454a3c5cb0ed21efba7f42" data-et-id="video/brightcove/6340439744112"><div class="stream-item__text"><div class="stream-item__date" data-date="1699039639351">Nov 3, 2023</div><a class="stream-item__title" data-ga-track="undefined - Stream - Former Google CEO Launched A $100 Million Company With His Girlfriend. It's Not Going Well" href="https://www.forbes.com/video/6340439744112/" aria-label="Click to watch video Former Google CEO Launched A $100 Million Company With His Girlfriend. It's Not Going Well"><h3>Former Google CEO Launched A $100 Million Company With His Girlfriend. It's Not Going Well</h3></a><div class="stream-item__description">Married billionaire Eric Schmidt launched Steel Perlot with 29-year-old entrepreneur Michelle Ritter while they were dating — a venture that has blurred his professional and personal life.</div><div><div class="stream-item__byline-social-wrapper"><span class="byline"><div class="byline__author-group"><div class="byline__author"><span class="byline__by">By</span><a class="byline__author-name" data-ga-track="undefined - Stream - Jonathan Palmer" href="https://www.forbes.com/sites/jonathanpalmer/">Jonathan Palmer</a><span class="byline__author-type">Forbes Staff</span></div></div></span><div class="social-share"><span class="social-share__arrow"><svg version="1.1" class="fs-icon fs-icon--share" xmlns="http://www.w3.org/2000/svg" x="0" y="0" viewBox="0 0 24 24" xml:space="preserve"><path fill-rule="evenodd" clip-rule="evenodd" d="M18 16.1c-.8 0-1.4.3-2 .8l-7.1-4.2c.1-.2.1-.5.1-.7s0-.5-.1-.7L16 7.2c.5.5 1.2.8 2 .8 1.7 0 3-1.3 3-3s-1.3-3-3-3-3 1.3-3 3c0 .2 0 .5.1.7L8 9.8C7.5 9.3 6.8 9 6 9c-1.7 0-3 1.3-3 3s1.3 3 3 3c.8 0 1.5-.3 2-.8l7.1 4.2c-.1.2-.1.4-.1.6 0 1.6 1.3 2.9 2.9 2.9s2.9-1.3 2.9-2.9-1.2-2.9-2.8-2.9z"/></svg></span><div class="social-share__icon-wrapper"><a class="social-share__icon social-share__icon--facebook" href="https://www.facebook.com/dialog/feed?app_id=123694841080850&amp;link=https%3A%2F%2Fwww.forbes.com%2Fvideo%2F6340439744112%2F&amp;picture=https%3A%2F%2Fimageio.forbes.com%2Fi-forbesimg%2Fmedia%2Fvideo%2F2023%2F11%2F03%2F6340439744112_still.jpg%3Fformat%3Djpg%26width%3D440&amp;name=Former%20Google%20CEO%20Launched%20A%20%24100%20Million%20Company%20With%20His%20Gir