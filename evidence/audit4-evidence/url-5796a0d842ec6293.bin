</script><script>(function(){
  function getCookie(n){
    var parts=document.cookie?document.cookie.split('; '):[];
    var i=0;
    while(i!==parts.length){
      var idx=parts[i].indexOf('=');
      if(idx > 0&&parts[i].substring(0,idx)===n)return parts[i].substring(idx+1);
      i++;
    }
    return '';
  }
  var hasZephrAccess=!!getCookie('fbs-zephr-access');
  var hasGpcSignal=!!navigator.globalPrivacyControl;
  if(!hasGpcSignal&&getCookie('gpcsignal')==='true')hasGpcSignal=true;
  if(!hasGpcSignal){
    var usp=getCookie('us_privacy')||getCookie('usprivacy');
    if(usp&&usp.charAt(2)&&usp.charAt(2).toLowerCase()==='y')hasGpcSignal=true;
  }
  var needsDsrLookup=window.forbes.isUsDpa&&hasZephrAccess;
  var needsGpcLookup=window.forbes.isStrictUsDpa&&(hasZephrAccess||hasGpcSignal);
  if(needsDsrLookup||needsGpcLookup){
    var s=document.createElement('style');
    s.id='ketch-suppression-styles';
    s.innerHTML='#ketch-banner{display:none!important}';
