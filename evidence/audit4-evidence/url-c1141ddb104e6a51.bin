    background-size: 115px auto;
}
.bitsbips-hero .aa-latest-post p,
.bitsbips-hero h3.divider {
    display: none;
}
.bitsbips-hero .aa-latest-post,
.bitsbips-hero .col-1 {
    position: relative;
    z-index: 1;
}
.bitsbips-hero .aa-latest-post:before {
    content: '';
    background-color: #000;
    width: 100%;
    height: 95%;
    position: absolute;
    z-index: -1;
    top: -15px;
    right: -15px;
}
.bitsbips-hero .col-1:before {
    content: '';
    background-color: #000;
    width: 100%;
    height: 55%;
    position: absolute;
    left: -20px;
    bottom: 0;
    z-index: -1;
}
.bitsbips-hero .aa-box{
	top: 30px;
}

.single-press-release .post-authors {
	display: none;
}
