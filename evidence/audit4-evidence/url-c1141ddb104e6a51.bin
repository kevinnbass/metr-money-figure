    <style id="wp-custom-css">
/* TEMPORARY
 * Hide the "Latest Episodes" section from the Bits and Bips page
 */
/* body.page-id-22808 section.block-archive {
    display: none;
} */
/* END: TEMPORARY */

/* Firefox */
@media (prefers-color-scheme: dark) {
    :root {
        color-scheme: light;
    }
}

/* Chrome */
@media (forced-colors: active) {
    :root {
        color-scheme: light;
    }
}

/* Gradient Fix
 * If the last block on a page has a gradient background, remove the margin from the footer to eliminate the white stripe between both sections
 */
body:has(.flex-sections .gradient-background:last-child) footer#main-footer {
    margin-top: 0;
}
/* END: Gradient Fix */

.visibility-wrapper.show-hide {
    display: none;
}

.meet-the-team p a {font-size:inherit;}
.home-before-menu {
	padding: 10px 0;
}
.gfield--type-honeypot {display:none;}

.single .post-content {
	font-size: 20px;
}
figure {
    width: 100% !important;
    margin: 0;
}
/* Home Sponsored Content */
.page-id-15446 .block-layout.home-feed {
    padding: 3em 0;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4),
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) {
    background-color: #000;
    color: #fff;
    padding: 15px;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) h3.feed-title,
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) h3.feed-title {
    font-size: 18px;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) h3 span,
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) h3 span {
    color: #fff;
    background: transparent;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title,
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title {
    color: #fff;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) .description,
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) .description {
    margin-bottom: 0;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title h3,
.page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title h3 {
    margin-bottom: 0;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title p, .page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) .post-title p {
    text-transform: uppercase;
    font-size: 14px;
    margin: 10px 0;
}
.page-id-15446 .cols-3 .column:last-child .v-feed:nth-child(4) .description p, .page-id-96 .cols-3 .column:last-child .v-feed:nth-child(4) .description p {
    margin-bottom: 0;
}

.single-sponsored_content .post-body ul {
    font-size: 20px;
    font-weight: 400 !important;
    line-height: 1.5;
    padding-left: 14px;
}

.post-authors {
    display: flex;
    gap: 20px;
	    flex-wrap: wrap;
}

.post-blurbs {
    display: flex;
    margin-bottom: 15px;
	gap: 15px;
}
.post-blurbs .post-blurb{
        background: linear-gradient(69deg, #f2a81c 0%, #c41f66 36%, #853be1 66%, #07d66e 92%);
        color: white;
        padding-left: 5px;
        padding-right: 5px;
        border-radius: 5px;
	        text-transform: uppercase;
        font-size: 15px;
	font-weight: 700;
}

.post-blurbs .post-blurb a{
	color:white;
	text-decoration:none;
}

.hl-ribbon-wrapper {
  display: flex;
  flex-direction: row;
  color: white;
  background-color: black;
  justify-content: center;
  align-items: center;
  padding: 7px 5px;
  column-gap: 30px;
}

.bitsbips-hero .aa-box {
    border: 10px solid #000;
	position: relative;
	z-index: 1;
}
.bitsbips-hero .aa-latest-post .image {
    border: 10px solid #000;
    margin-bottom: 0;
}
.bitsbips-hero .aa-latest-post .player {
    border: 10px solid #000;
}
.bitsbips-hero .aa-latest-post .player .logo {
