",\"current\":\"not-found\"},\"meta\":{},\"sections\":[]},\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],\"$L1a\",null]}]\n"])</script><script>self.__next_f.push([1,"1a:[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"$L1b\",null,{}]}]\n"])</script><script>self.__next_f.push([1,"1c:I[366829,[\"/_next/static/chunks/38tkq-jm_kjky.js\",\"/_next/static/chunks/1ntn7efqc-iiw.js\",\"/_next/static/chunks/0e3-jir0v5afw.js\",\"/_next/static/chunks/1miw4c2f-i_-1.js\",\"/_next/static/chunks/3k_473ybucr6n.js\",\"/_next/static/chunks/1tvhf8byxci3u.js\",\"/_next/static/chunks/0qoqb5gn1f_zl.js\",\"/_next/static/chunks/0e_1817chkmw2.js\",\"/_next/static/chunks/3wmg--cdb0p7j.js\",\"/_next/static/chunks/3-fnghd0zoogo.js\",\"/_next/static/chunks/1m2tuo2yn9z9q.js\",\"/_next/static/chunks/3otibxrfarvp1.js\"],\"default\"]\n23:I[27201,[\"/_next/static/chunks/38tkq-jm_kjky.js\",\"/_next/static/chunks/1ntn7efqc-iiw.js\"],\"IconMark\"]\n1d:T6f9,"])</script><script>self.__next_f.push([1,", which demonstrates the need for studying safety issues at scale.\n\nThe purpose of this research is to develop the technical components necessary to build large-scale models which have better implicit safeguards and require less after-training interventions, as well as to develop the tools necessary to further look inside these models to be confident that the safeguards actually work. The company is also building out teams and partnerships dedicated to exploring the policy and societal impacts of these models.\n\n“With this fundraise, we’re going to explore the predictable scaling properties of machine learning systems, while closely examining the unpredictable ways in which capabilities and safety issues can emerge at-scale,” said Anthropic co-founder and CEO Dario Amodei. “We’ve made strong initial progress on understanding and steering the behavior of AI systems, and are gradually assembling the pieces needed to make usable, integrated AI systems that benefit society.”\n\nAnthropic is now a growing team of around 40 people based in a plant-filled office in San Francisco, California, with plans to expand further this year. “Now that we’ve built out the organization, we’re focusing on ensuring Anthropic has the culture and governance to continue to responsibly explore and develop safe AI systems as we scale,” said Anthropic co-founder and President Daniela Amodei. “We’re excited about what’s ahead, and grateful to all be working together.”\n\nThe Series B follows the company raising $124 million in a Series A round in 2021. The Series B round was led by Sam Bankman-Fried, CEO of FTX. The round also included participation from Caroline Ellison, Jim McClave, Nishad Singh, Jaan Tallinn, and the Center for Emerging Risk Research (CERR)."])</script><script>self.__next_f.push([1,"1e:[]\n"])</script><script>self.__next_f.push([1,"6:[\"$\",\"$L18\",null,{\"children\":[null,[\"$\",\"$L19\",null,{\"isMinimalNavigation\":\"$undefined\",\"siteSettings\":{\"_createdAt\":\"2023-11-03T16:49:36Z\",\"_id\":\"13c6e1a1-6f38-400c-ae18-89d73b6ba991\",\"_rev\":\"XQe4R6LiqiY3ST7NppsXi8\",\"_system\":\"$17:props:children:1:props:siteSettings:_system\",\"_type\":\"siteSettings\",\"_updatedAt\":\"2026-09-11T15:26:27Z\",\"announcement\":null,\"claudeCta\":\"$17:props:children:1:props:siteSettings:claudeCta\",\"copyright\":\"© 2026 Anthropic PBC\",\"copyrightEu\":\"© 2026 Anthropic PBC. Services in the EU are provided by Anthropic Ireland Limited.\",\"footer\":\"$17:props:children:1:props:siteSettings:footer\",\"footerNavigation\":\"$17:props:children:1:props:siteSettings:footerNavigation\",\"headerNavigation\":\"$17:props:children:1:props:siteSettings:headerNavigation\",\"internalName\":\"anthropic.com Site Settings\",\"linkedInUsername\":\"anthropicresearch\",\"menu\":\"$17:props:children:1:props:siteSettings:menu\",\"meta\":\"$17:props:children:1:props:siteSettings:meta\",\"navigation\":\"$17:props:children:1:props:siteSettings:navigation\",\"search\":\"$17:props:children:1:props:siteSettings:search\",\"siteName\":\"Anthropic\",\"sitemapUrls\":\"$17:props:children:1:props:siteSettings:sitemapUrls\",\"twitterUsername\":\"AnthropicAI\",\"youtubeUsername\":\"anthropic-ai\"},\"page\":\"$undefined\",\"theme\":\"$undefined\",\"hideOnScroll\":\"$undefined\"}],[\"$\",\"main\",null,{\"id\":\"main-content\",\"className\":\"\",\"children\":[\"$\",\"article\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"page-wrapper PostDetail-module-scss-module__UQuRMa__hero\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__header\",\"children\":[[\"$\",\"div\",null,{\"className\":\"PostDetail-module-scss-module__UQuRMa__subjects body-3 bold\",\"children\":[[\"$\",\"span\",\"0\",{\"children\":\"Announcements\"}]]}],[\"$\",\"h1\",null,{\"className\":\"headline-1 PostDetail-module-scss-module__UQuRMa__title\",\"children\":\"Anthropic Raises Series B to build steerable, interpretable, robust AI systems\"}],[\"$\",\"div\",null,{\"className\":\"body-3 agate\",\"children\":\"Apr 29, 2022\"}],null]}],\"$undefined\"]}],[\"$\",\"div\",null,{\"className\":\"page-wrapper\",\"children\":[\"$\",\"$L1c\",null,{\"body\":[{\"_key\":\"3b5959bd2953\",\"_type\":\"block\",\"children\":[{\"_key\":\"3b5959bd29530\",\"_type\":\"span\",\"marks\":[],\"text\":\"Anthropic, an AI safety and research company, has raised $580 million in a Series B. The financing will help Anthropic build large-scale experimental infrastructure to explore and improve the safety properties of computationally intensive AI models.\\n\\nSince its founding at the beginning of 2021, Anthropic has conducted research into making systems that are more steerable, robust, and interpretable. On interpretability, it has made progress in mathematically \"},{\"_key\":\"3b5959bd29531\",\"_type\":\"span\",\"marks\":[\"0fe38c1340cd\"],\"text\":\"reverse engineering the behavior of small language models\"},{\"_key\":\"3b5959bd29532\",\"_type\":\"span\",\"marks\":[],\"text\":\" and begun to understand the source of \"},{\"_key\":\"3b5959bd29533\",\"_type\":\"span\",\"marks\":[\"1170fb1042df\"],\"text\":\"pattern-matching behavior in large language models\"},{\"_key\":\"3b5959bd29534\",\"_type\":\"span\",\"marks\":[],\"text\":\". On steerability and robustness, it has developed \"},{\"_key\":\"3b5959bd29535\",\"_type\":\"span\",\"marks\":[\"afde2ec70835\"],\"text\":\"baseline techniques to make large language models more “helpful and harmless”\"},{\"_key\":\"3b5959bd29536\",\"_type\":\"span\",\"marks\":[],\"text\":\", and followed this up with \"},{\"_key\":\"3b5959bd29537\",\"_type\":\"span\",\"marks\":[\"5ac9bdfd3eef\"],\"text\":\"reinforcement learning to further improve these properties\"},{\"_key\":\"3b5959bd29538\",\"_type\":\"span\",\"marks\":[],\"text\":\", as well as releasing a dataset to help other research labs train models that are more \"},{\"_key\":\"3b5959bd29539\",\"_type\":\"span\",\"marks\":[\"daf471da39b6\"],\"text\":\"aligned with human preferences\"},{\"_key\":\"3b5959bd295310\",\"_type\":\"span\",\"marks\":[],\"text\":\". It has also released an analysis of \"},{\"_key\":\"3b5959bd295311\",\"_type\":\"span\",\"marks\":[\"ef9968b385d9\"],\"text\":\"sudden changes in performance in large language models and the societal impacts of this phenomenon\"},{\"_key\":\"3b5959bd295312\",\"_type\":\"span\",\"marks\":[],\"text\":\"$1d\"}],\"markDefs\":[{\"_key\":\"0fe38c1340cd\",\"_type\":\"link\",\"href\":\"https://transformer-circuits.pub/2021/framework/index.html\"},{\"_key\":\"1170fb1042df\",\"_type\":\"link\",\"href\":\"https://transformer-circuits.pub/2022/in-context-learning-and-induction-heads/index.html\"},{\"_key\":\"afde2ec70835\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2112.00861\"},{\"_key\":\"5ac9bdfd3eef\",\"_type\":\"link\",\"href\":\"https://arxiv.org/abs/2204.05862\"},{\"_key\":\"daf471da39b6\",\"_type\":\"link\",\"href\":\"https://github.com/anthropics/hh-rlhf\"},{\"