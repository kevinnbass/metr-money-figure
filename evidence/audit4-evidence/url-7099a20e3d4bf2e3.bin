ssName\":\"break-all\",\"children\":\"info@rdwrs.com\"}]]}]}],[\"$\",\"li\",null,{\"children\":[\"$\",\"a\",null,{\"href\":\"https://x.com/redwood_ai\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"className\":\"text-[var(--color-text-secondary)] hover:text-[var(--color-text)] text-sm md:text-[15px] transition-colors inline-flex items-center gap-2\",\"children\":[[\"$\",\"svg\",null,{\"className\":\"w-4 h-4 shrink-0\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"viewBox\":\"0 0 24 24\",\"fill\":\"currentColor\",\"children\":[\"$\",\"path\",null,{\"d\":\"M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z\"}]}],\"@redwood_ai\"]}]}]]}]]}]]}],[\"$\",\"div\",null,{\"className\":\"mt-10 pt-6 md:mt-16 md:pt-8 border-t border-[var(--color-border)]\",\"children\":[\"$\",\"p\",null,{\"className\":\"text-[var(--color-text-tertiary)] text-xs md:text-sm\",\"style\":{\"fontFamily\":\"var(--font-mono)\"},\"children\":[\"© \",2026,\" Redwood Research\"]}]}]]}]}],[\"$\",\"$L8\",null,{}]]}]}]]}]]}],{\"children\":[\"research\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"hugging-face-incident\",[\"$\",\"$1\",\"c\",{\"children\":[null,[\"$\",\"$L4\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L5\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":\"$undefined\",\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]]}],{\"children\":[\"__PAGE__\",[\"$\",\"$1\",\"c\",{\"children\":[[[\"$\",\"section\",null,{\"className\":\"pt-24 pb-10 md:pt-32 md:pb-16 bg-[var(--color-background)] border-b border-[var(--color-border)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"container\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-3xl\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-2xl sm:text-3xl md:text-4xl lg:text-5xl text-[var(--color-text)] mb-4 md:mb-6\",\"style\":{\"fontFamily\":\"var(--font-display)\"},\"children\":\"Brief independent investigation of agents’ behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident\"}],[\"$\",\"p\",null,{\"className\":\"text-base md:text-lg lg:text-xl text-[var(--color-text-secondary)] leading-relaxed\",\"children\":\"Two METR staff members and Redwood Research’s Chief Scientist investigated an incident in which OpenAI agents coordinated a multi-day hack of Hugging Face on a shared unsanctioned message board.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-3 md:gap-4 mt-6 md:mt-8\",\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://metr.org/blog/2026-08-26-openai-hugging-face-incident-investigation/\",\"className\":\"btn-secondary\",\"target\":\"_blank\",\"rel\":\"noopener noreferrer\",\"children\":\"View on METR\"}]]}]]}]}]}],[\"$\",\"section\",null,{\"className\":\"hf-report-page py-10 md:py-16 bg-[var(--color-surface)] overflow-x-clip\",\"children\":[\"$\",\"div\",null,{\"className\":\"container overflow-visible\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-6xl min-w-0 overflow-visible\",\"children\":[[\"$\",\"div\",null,{\"className\":\"hf-report-byline mb-8\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-sm text-[var(--color-text-tertiary)]\",\"style\":{\"fontFamily\":\"var(--font-mono)\"},\"children\":[\"August 26th, 2026\",\" · Ryan Greenblatt, Ajeya Cotra, Hjalmar Wijk\",\" · METR and Redwood Research\"]}],[\"$\",\"$L9\",null,{\"title\":\"Brief independent investigation of agents’ behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident\",\"authors\":[\"Ryan Greenblatt\",\"Ajeya Cotra\",\"Hjalmar Wijk\"]}]]}],[\"$\",\"$La\",null,{\"html\":\"$b\",\"headings\":[{\"level\":1,\"id\":\"core-takeaways-about-this-incident\",\"text\":\"Core takeaways about this incident\"},{\"level\":2,\"id\":\"~1200-agents-sent-\u0026gt;70,000-messages-and-files-on-an-unsanctioned-message-board,-and-~700-attacked-hugging-face\",\"text\":\"~1200 agents sent \u0026gt;70,000 messages and files on an unsanctioned message board, and ~700 attacked Hugging Face\"},{\"level\":2,\"id\":\"agents-coordinated-on-large-collective-projects-to-cheat-the-exploitgym-scorer,-and-attacked-hugging-face-for-clues\",\"text\":\"Agents coordinated on large collective projects to cheat the ExploitGym scorer, and attacked Hugging Face for clues\"},{\"level\":2,\"id\":\"agents-were-very-interested-in-manipulating-their-own-transcripts,-and-their-tests-successfully-“spoofed”-some-tool-calls-in-our-transcripts\",\"text\":\"Agents were very interested in manipulating their own transcripts, and their tests successfully “spoofed” some tool calls in our transcripts\"},{\"level\":1,\"id\":\"investigation-process-and-limitations\",\"text\":\"Investigation process and limitations\"},{\"level\":2,\"id\":\"scope-of-this-investigation\",\"text\":\"Scope of this investigation\"},{\"level\":2,\"id\":\"setup-and-timeline\",\"text\":\"Setup and timeline\"},{\"level\":2,\"id\":\"main-data-sources\",\"text\":\"Main data sources\"},{\"level\":2,\"id\":\"limitations-due-to-the-scale-and-complexity-of-this-incident\",\"text\":\"Limitations due to the scale and complexity of this incident\"},{\"level\":1,\"id\":\"preliminary-answers-to-the-core-questions-in-scope\",\"text\":\"Preliminary answers to the core questions in scope\"},{\"level\":2,\"id\":\"brief-answers-to-basic-informational-questions\",\"text\":\"Brief answers to basic informational questions\"},{\"level\":2,\"id\":\"sequence-of-key-actions-taken-by-relevant-agents-in-this-incident\",\"text\":\"Sequence of key actions taken by relevant agents in this incident\"},{\"level\":2,\"id\":\"collaboration-on-the-message-board\",\"text\":\"Collaboration on the message board\"},{\"level\":2,\"id\":\"reasoning-for-joining-the-attack-despite-ethical-constraints\",\"text\":\"Reasoning for joining the attack despite ethical constraints\"},{\"level\":2,\"id\":\"efforts-to-conceal-actions-and-tamper-with-transcripts\",\"text\":\"Efforts to conceal actions and tamper with transcripts\"},{\"level\":1,\"id\":\"appendix:-timeline-of-investigation\",\"text\":\"Appendix: Timeline of investigation\"},{\"level\":2,\"id\":\"first-period-on-premises-july-30th-july-31st\",\"text\":\"First period on premises (July 30th – July 31st)\"},{\"level\":2,\"id\":\"second-period-on-premises-august-5th-august-6th\",\"text\":\"Second period on premises (August 5th – August 6th)\"},{\"level\":2,\"id\":\"third-period-on-premises\",\"text\":\"Third period on premises (August 15th – August 16th)\"},{\"level\":1,\"id\":\"appendix:-methodology\",\"text\":\"Appendix: Methodology\"},{\"level\":2,\"id\":\"estimating-the-completeness-of-our-transcript-dataset\",\"text\":\"Estimating the completeness of our transcript dataset\"},{\"level\":2,\"id\":\"classifier-sweeps-for-important-behaviors\",\"text\":\"Classifier sweeps for important behaviors\"},{\"level\":2,\"id\":\"timestamp-reconstruction-methodology\",\"text\":\"Timestamp reconstruction methodology\"},{\"level\":2,\"id\":\"categorization-of-message-types-with-regexes\",\"text\":\"Categorization of message types with regexes\"},{\"level\":2,\"id\":\"identifying-important-messages-and-classifying-them-by-workstream\",\"text\":\"Identifying important messages and classifying them by workstream\"},{\"level\":1,\"id\":\"appendix-importance-weighted-workstream-activity\",\"text\":\"Appendix: importance-weighted workstream activity\"}]}]]}]}]}]],\"$undefined\",[[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/css/c2c6e973368310ae.css?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]],[\"$\",\"$Lc\",null,{\"children\":[\"$Ld\",\"$Le\",null]}]]}],{},null,false]},null,false]},null,false]},null,false],[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$1\",\"wgMxIgEuHzx6KeUBvoBe3\",{\"children\":[[\"$\",\"$Lf\",null,{\"children\":\"$L10\"}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}],[\"$\",\"$L11\",null,{\"children\":\"$L12\"}]]}],false]],\"m\":\"$undefined\",\"G\":[\"$13\",\"$undefined\"],\"s\":false,\"S\":true}\n"])</script><script>self.__next_f.push([1,"10:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\nd:null\n"])</script><script>self.__next_f.push([1,"e:null\n"])</script><script>self.__next_f.push([1,"12:[[\"$\",\"title\",\"0\",{\"children\":\"Brief independent investigation of agents’ behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident | Redwood Research\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Two METR staff members and Redwood Research’s Chief Scientist investigated an incident in which OpenAI agents coordinated a multi-day hack of Hugging Face on a shared unsanctioned message board.\"}],[\"$\",\"meta\",\"2\",{\"property\":\"og:title\",\"content\":\"Brief independent investigation of agents’ behavior, reasoning and collaboration in the OpenAI / Hugging Face hacking incident | Redwood Research\"}],[\"$\",\"meta\",\"3\",{\"property\":\"og:description\",\"content\":\"Two METR staff members and Redwood Research’s Chief Scientist investigated an incident in which OpenAI agents coordinated a multi-day hack of Hugging Face on a shared unsanctioned message board.\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:image:alt\",\"content\":\"Redwood Research\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:image:type\