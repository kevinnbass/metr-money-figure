<!DOCTYPE html><html lang="en"><head><meta charSet="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="preload" href="/_next/static/media/636a5ac981f94f8b-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/98e207f02528a563-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="preload" href="/_next/static/media/d3ebbfd689654d3a-s.p.woff2" as="font" crossorigin="" type="font/woff2"/><link rel="stylesheet" href="/_next/static/css/3f5b0a44e2377e0f.css?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" data-precedence="next"/><link rel="stylesheet" href="/_next/static/css/c2c6e973368310ae.css?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" data-precedence="next"/><link rel="preload" as="script" fetchPriority="low" href="/_next/static/chunks/webpack-c4a1887361dd104b.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx"/><script src="/_next/static/chunks/4bd1b696-2c58032a904533a9.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/684-dbca9a1498ff5e26.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/main-app-70f3fd67bd0c0bda.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/874-1eb0d277ddd7ac28.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/63-69d719747d4671e0.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/app/layout-11f75eec142b29e2.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/app/research/hugging-face-incident/page-8f188a786651dff6.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><script src="/_next/static/chunks/app/page-527ed02d39ab4b33.js?dpl=dpl_G8PzvC5viZxZANbi7WcSKvgs1SUx" async=""></script><link rel="preload" href="https://www.googletagmanager.com/gtag/js?id=G-MW9GY1TQS1" as="script"/><meta name="next-size-adjust" content=""/><ti