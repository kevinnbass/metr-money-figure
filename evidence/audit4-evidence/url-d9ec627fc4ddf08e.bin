ng) / 2)" class="flex items-center"><a aria-label="The Guardian media coverage" href="/about-us/media-coverage"><img alt="The Guardian" loading="lazy" width="1152" height="464" decoding="async" data-nimg="1" class="h-10 w-auto lg:h-12 shrink-0" style="color:transparent" srcset="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FGUARDIAN.83698244.png&amp;w=1200&amp;q=100 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2FGUARDIAN.83698244.png&amp;w=3840&amp;q=100 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FGUARDIAN.83698244.png&amp;w=3840&amp;q=100"></a></div><div data-scope="marquee" data-part="item" dir="ltr" style="margin-inline:calc(var(--marquee-spacing) / 2)" class="flex items-center"><a aria-label="New Yorker media coverage" href="/about-us/media-coverage"><img alt="New Yorker" loading="lazy" width="1350" height="464" decoding="async" data-nimg="1" class="h-10 w-auto lg:h-12 shrink-0" style="color:transparent" srcset="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FNEW%20YORKER.ec6c99bd.png&amp;w=1920&amp;q=100 1x, /_next/image?url=%2F_next%2Fstatic%2Fmedia%2FNEW%20YORKER.ec6c99bd.png&amp;w=3840&amp;q=100 2x" src="/_next/image?url=%2F_next%2Fstatic%2Fmedia%2FNEW%20YORKER.ec6c99bd.png&amp;w=3840&amp;q=100"></a></div></div></div></div><div class="bg-subtle rounded-3xl p-8 md:p-20"><div class="flex flex-col gap-10 lg:grid lg:grid-cols-2 lg:gap-16"><div class="flex flex-col gap-8"><h3 class="text-3xl md:text-5xl tracking-tight text-balance">A better way to make a better world.</h3><div class="flex flex-col gap-3 mt-auto"><h4 class="text-2xl md:text-[28px] tracking-tight">Newsletter</h4><p class="text-base leading-snug text-balance">Join our monthly newsletter with stories and updates from across the effective giving community.</p><form class="flex flex-wrap gap-2 items-start" target="_blank"><input type="text" name="company" tabindex="-1" autocomplete="off" class="absolute -left-[9999px] size-px overflow-hidden opacity-0 pointer-events-none" value><div data-scope="field" data-part="root" id="field:::Rfil2p6:" role="group" class="flex w-full flex-col gap-1.5 flex-1 min-w-0"><input data-required id=":Rfil2p6:" required data-scope="field" data-part="input" type="email" name="EMAIL" placeholder="your@email.com" autocomplete="email" aria-label="Email address" class="w-full min-w-0 rounded-lg border border-primary bg-primary text-primary outline-none transition-[border-color,background-color,color,box-shadow] placeholder:text-muted hover:border-emphasized focus:border-focus focus:ring focus:ring-focus data-[disabled]:cursor-not-allowed data-[disabled]:border-primary data-[disabled]:bg-primary data-[disabled]:text-subtle data-[disabled]:opacity-60 disabled:cursor-not-allowed disabled:border-primary disabled:bg-primary disabled:text-subtle disabled:opacity-60 data-[invalid]:border-error data-[invalid]:ring data-[invalid]:ring-error data-[invalid]:text-error data-[invalid]:focus:border-error data-[invalid]:focus:ring-error aria-[invalid=true]:border-error aria-[invalid=true]:ring aria-[invalid=true]:ring-error aria-[invalid=true]:text-error aria-[invalid=true]:focus:border-error aria-[invalid=true]:focus:ring-error min-h-14 px-5 py-3.5 text-base leading-7" value></div><button type="submit" aria-label="Subscribe to newsletter" class="bg-emphasized size-14 rounded-lg shrink-0 flex items-center justify-center" disabled><div role="status" aria-label="Loading" class="flex items-center justify-center h-5"><svg aria-hidden="true" class="animate-spin stroke-red-primary" width="20" height="20" viewBox="0 0 44 44" xmlns="http://www.w3.org/2000/svg"><circle class="opacity-25" cx="22" cy="22" r="18" fill="none" stroke-width="4"/><circle cx="22" cy="22" r="18" fill="none" stroke-width="4" stroke-dasharray="80, 200" stroke-dashoffset="0" stroke-linecap="round"/></svg></div></button></form></div></div><div class="flex flex-col gap-10"><div class="flex flex-col gap-3"><h4 class="text-2xl md:text-[28px] tracking-tight">Get started</h4><p class="text-base leading-snug text-balance">Learn about effective giving, explore charity research, and discover how to maximise your impact.</p><div class="flex flex-col sm:flex-row gap-3"><a class="inline-flex items-center justify-center no-underline rounded-lg text-primary bg-emphasized hover:bg-emphasized/70 disabled:opacity-50 disabled:cursor-default transition font-normal py-2 px-6 text-sm leading-6 w-full sm:flex-1 !normal-case" href="/effective-giving-101">Effective giving 101</a><a class="inline-flex items-center justify-center no-underline rounded-lg text-primary bg-emphasized hover:bg-emphasized/70 disabled:opacity-50 disabled:cursor-default transition font-normal py-2 px-6 text-sm leading-6 w-full sm:flex-1 !normal-case" href="/guides-and-resources">Resources and guides</a></div></div><div class="flex flex-col gap-3"><h4 class="text-2xl md:text-[28px] tracking-tight">Take action</h4><p class="text-base leading-snug text-balance">Give effectively to the world&#x27;s most impactful charities. Your donation can save lives and reduce suffering.</p><div class="flex flex-col sm:flex-row gap-3"><a class="inline-flex items-center justify-center no-underline rounded-lg text-white bg-red-primary hover:bg-red-emphasized active:bg-red-700 disabled:opacity-25 disabled:cursor-disabled transition font-normal py-2 px-6 text-sm leading-6 w-full sm:flex-1 !normal-case" href="/donate"><span class="inline-flex items-center gap-2"><svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 16 16" fill="currentColor"><path d="M8 14.75L0 6.5L5.4 1.25L8 4L10.6 1.25L16 6.5Z"/></svg>Donate</span></a><a class="inline-flex items-center justify-center no-underline rounded-lg text-red-primary bg-transparent border border-red-primary hover:bg-emphasized/70 active:bg-emphasized disabled:opacity-50 disabled:cursor-default py-2 px-6 text-sm leading-6 w-full sm:flex-1 !font-normal !normal-case" href="/pledge"><span class="inline-flex items-center gap-2"><svg aria-hidden="true" class="size-4 shrink-0" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1.5L14.5 8L8 14.5L1.5 8Z"/></svg>Pledge</span></a></div></div></div></div></div><div class="bg-red-primary text-inverted rounded-3xl p-8 md:p-20"><div class="flex flex-col gap-10"><div class="flex flex-col gap-10 lg:grid lg:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)] lg:gap-12"><a class="self-start" href="/"><img alt="Giving What We Can" loading="lazy" width="144" height="144" decoding="async" data-nimg="1" class="size-24 md:size-36" style="color:transparent" src="/branding/gwwc-logo-mark-inverted.svg"></a><div class="grid grid-cols-2 gap-8 lg:grid-cols-3"><div><h3 class="text-2xl leading-tight">About</h3><ul role="list" class="mt-4 space-y-2"><li><a class="text-base hover:underline" href="/about-us">About Us</a></li><li><a class="text-base hover:underline" href="/about-us/contact-us">Contact Us</a></li><li><a class="text-base hover:underline" href="/about-us/team">Our Team</a></li><li><a class="text-base hover:underline" href="/about-us/members">Our Members</a></li><li><a class="text-base hover:underline" href="/events">Our Events</a></li><li><a class="text-base hover:underline" href="/about-us/our-mistakes">Our Mistakes</a></li><li><a class="text-base hover:underline" href="/donate">Donate</a></li></ul></div><div><h3 class="text-2xl leading-tight">Learn</h3><ul role="list" class="mt-4 space-y-2"><li><a class="text-base hover:underline" href="/best-charities">Our best charities</a></li><li><a class="text-base hover:underline" href="/pledge">Take A Giving Pledge</a></li><li><a class="text-base hover:underline" href="/get-involved">Get Involved</a></li><li><a class="text-base hover:underline" href="/get-involved/bequests">Make A Bequest</a></li><li><a class="text-base hover:underline" href="/guides-and-resources">Videos, Books, Podcasts</a></li><li><a class="text-base hover:underline" href="/faq">FAQs</a></li></ul></div><div class="col-span-2 lg:col-span-1"><h3 class="text-2xl leading-tight">Media</h3><ul role="list" class="mt-4 space-y-2"><li><a class="text-base hover:underline" href="/about-us/press-kit">Press Kit</a></li><li><a class="text-base hover:underline" href="/about-us/media-coverage">Media coverage</a></li><li><a class="text-base hover:underline" href="/pledge/stories">Case studies: People who pledge to give</a></li></ul></div></div></div><div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between sm:gap-12"><p class="text-lg md:text-xl leading-snug max-w-md"><span class="font-serif">Giving What We Can is a community of effective givers. We inspire people to give more, and give more effectively.</span></p><div class="flex flex-wrap gap-3 sm:justify-end shrink-0"><a href="https://facebook.com/givingwhatwecan" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 border border-white size-10 flex items-center justify-center rounded-full"><span class="sr-only">Facebook</span><svg class="size-5" fill="currentColor" viewBox="0 0 13 24" aria-hidden="true"><path d="M12.1491 13.5L12.8109 9.1875H8.60364V6.375C8.60364 5.15625 9.17091 4.03125 11.0618 4.03125H13V0.328125C13 0.328125 11.2509 0 9.59636 0C6.14545 0 3.87636 2.10938 3.87636 5.85938V9.1875H0V13.5H3.87636V24H8.60364V13.5H12.1491Z" fill="currentColor"/></svg></a><a href="https://x.com/givingwhatwecan" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 border border-white size-10 flex items-center justify-center rounded-full"><span class="sr-only">X/Twitter</span><svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 4l11.733 16h4.267l-11.733 -16z"/><path d="M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772"/></svg></a><a href="https://www.instagram.com/giving_what_we_can" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 border border-white size-10 flex items-center just