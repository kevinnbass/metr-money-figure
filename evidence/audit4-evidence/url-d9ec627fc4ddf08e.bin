 class="size-5" fill="currentColor" viewBox="0 0 25 18" aria-hidden="true"><path d="M24.4516 2.85938C24.1773 1.73438 23.309 0.84375 22.2578 0.5625C20.2925 0 12.5229 0 12.5229 0C12.5229 0 4.7075 0 2.74223 0.5625C1.69104 0.84375 0.822669 1.73438 0.548446 2.85938C0 4.82812 0 9.04688 0 9.04688C0 9.04688 0 13.2188 0.548446 15.2344C0.822669 16.3594 1.69104 17.2031 2.74223 17.4844C4.7075 18 12.5229 18 12.5229 18C12.5229 18 20.2925 18 22.2578 17.4844C23.309 17.2031 24.1773 16.3594 24.4516 15.2344C25 13.2188 25 9.04688 25 9.04688C25 9.04688 25 4.82812 24.4516 2.85938ZM9.96344 12.8438V5.25L16.4534 9.04688L9.96344 12.8438Z"/></svg></a><a href="https://www.linkedin.com/company/giving-what-we-can/" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 border border-white size-10 flex items-center justify-center rounded-full"><span class="sr-only">LinkedIn</span><svg class="size-5" fill="currentColor" viewBox="0 0 21 20" aria-hidden="true"><path d="M4.6875 20V6.62192H0.328125V20H4.6875ZM2.48438 4.83221C3.89062 4.83221 5.01562 3.71365 5.01562 2.37136C5.01562 1.07383 3.89062 0 2.48438 0C1.125 0 0 1.07383 0 2.37136C0 3.71365 1.125 4.83221 2.48438 4.83221ZM20.9531 20H21V12.6622C21 9.08277 20.1562 6.30872 15.75 6.30872C13.6406 6.30872 12.2344 7.42729 11.625 8.45638H11.5781V6.62192H7.40625V20H11.7656V13.3781C11.7656 11.6331 12.0938 9.97763 14.3438 9.97763C16.5938 9.97763 16.6406 11.9463 16.6406 13.5123V20H20.9531Z" fill="currentColor"/></svg></a><a href="https://www.tiktok.com/@givingwhatwecan" target="_blank" rel="noopener noreferrer" class="hover:opacity-80 border border-white size-10 flex items-center justify-center rounded-full"><span class="sr-only">TikTok</span><svg class="size-5" fill="currentColor" viewBox="0 0 21 24" aria-hidden="true"><path d="M21 9.84375V5.76562C20.9531 5.76562 20.9531 5.76562 20.9531 5.76562C19.8281 5.76562 18.75 5.4375 17.8594 4.82812C16.5469 3.98438 15.6094 2.625 15.3281 1.07812C15.2344 0.75 15.2344 0.421875 15.2344 0.09375C15.2344 0.046875 15.2344 0.046875 15.2344 0H11.1094V16.4062C11.1094 18.3281 9.51562 19.9219 7.59375 19.9219C5.67188 19.9219 4.07812 18.3281 4.07812 16.4062C4.07812 14.4844 5.67188 12.8906 7.59375 12.8906C7.96875 12.8906 8.29688 12.9375 8.67188 13.0781V8.85938C8.29688 8.8125 7.96875 8.76562 7.59375 8.76562C3.375 8.76562 0 12.1875 0 16.4062C0 20.625 3.375 24 7.59375 24C11.8125 24 15.2344 20.625 15.2344 16.4062V8.01562C16.8281 9.1875 18.7969 9.84375 20.9531 9.84375H21Z" fill="currentColor"/></svg></a></div></div></div></div><div class="text-muted flex flex-col gap-4"><p class="text-base">Giving What We Can UK (GWWC UK) is a charity in England and Wales (with registered charity number 1207964, registered company number 15442716, and is also a Netherlands registered tax-deductible entity ANBI 827647232). Giving What We Can USA Inc. (GWWC USA) is a 501(c)(3) nonprofit with EIN 93-3629215. GWWC UK and GWWC USA are separate charities that collaborate closely. For other locations read<!-- --> <a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker" href="/get-involved/tax-deductibility">advice on tax-deductibility by country</a>.</p><span class="inline-block py-2 my-2">© Giving What We Can – all rights reserved. Please<!-- --> <a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker" href="/about-us/contact-us">contact us</a> <!-- -->if you wish to redistribute, translate, or adapt this work.</span><div class="flex gap-2 flex-wrap"><a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker" href="/privacy">Privacy policy</a><span>|</span><a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker" href="/terms">Terms and Conditions</a><span>|</span><a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker" href="/cookie-notice">Cookie Notice</a><span class="w-full lg:flex-1 lg:text-right">Structured content powered by<!-- --> <a class="underline hover:underline hover:text-red-400 cursor-pointer text-grey-darker !text-primary" rel="noopener noreferrer" href="https://www.sanity.io/">Sanity.io</a></span></div></div></div></footer></div><div data-rht-toaster style="position:fixed;z-index:9999;top:16px;left:16px;right:16px;bottom:16px;pointer-events:none"></div></div><script id="__NEXT_DATA__" type="application/json">{"props":{"pageProps":{"initialPage":{"_createdAt":"2023-08-08T18:41:03Z","_id":"7ab07437-d2e7-40ce-9ed8-7d4d04ce2bd7","_rev":"be3C7ysj1QqQyrHso5uZ6Z","_type":"charity","_updatedAt":"2024-10-01T13:15:47Z","causeArea":{"path":"/cause-areas/reducing-global-catastrophic-risks","slug":{"_type":"slug","current":"reducing-global-catastrophic-risks"},"title":"Reducing global catastrophic risks"},"charityNoticeText":[{"_key":"eaaf3dc9deb6","_type":"block","children":[{"_key":"dd80f76c909f","_type":"span","marks":[],"text":"Please note that GWWC does not evaluate individual charities. Our "},{"_key":"b943e361334e","_type":"span","marks":["em","84cae871ac8f"],"text":"recommendations "},{"_key":"9ffc5bf6baaf","_type":"span","marks":[],"text":"are based on the research of third-party, impact-focused charity evaluators our research team has found to be particularly well-suited to help donors do the most good per dollar, according to their recent evaluator investigations. Our "},{"_key":"d93077bcb778","_type":"span","marks":["em","39bfa52d196a"],"text":"other supported programs"},{"_key":"5292fa62175c","_type":"span","marks":["strong"],"text":" "},{"_key":"e0dd63c0e7d7","_type":"span","marks":[],"text":"are those that align with our charitable purpose — they are working on a high-impact problem and take a reasonably promising approach (based on publicly-available information). \n\nAt Giving What We Can, we focus on the "},{"_key":"96c276124e62","_type":"span","marks":["strong"],"text":"effectiveness"},{"_key":"94d7009bdf4a","_type":"span","marks":[],"text":" of an organisation's work -- what the organisation is actually doing and whether their programs are making a big difference. Some others in the charity recommendation space focus instead on the ratio of admin costs to program spending, part of what we’ve termed the “overhead myth.” See "},{"_key":"61024ebc57bf","_type":"span","marks":["6ebf71b40938"],"text":"why overhead isn’t the full story"},{"_key":"5a8f23062f97","_type":"span","marks":[],"text":" and learn more about "},{"_key":"07672c0c3fe2","_type":"span","marks":["fa5d28b37554"],"text":"our approach to charity evaluation"},{"_key":"65611fd828dd","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"6ebf71b40938","_type":"link","blank":false,"locale":"en","path":"/blog/arent-the-best-charities-those-with-the-lowest-overhead-costs","reference":{"_ref":"d09d1231-3b45-4660-b47c-184e03afc642","_type":"reference"}},{"_key":"fa5d28b37554","_type":"link","blank":false,"locale":"en","path":"/our-research-and-approach","reference":{"_ref":"eccceecf-123e-460b-b3da-6bc5b82e1a2e","_type":"reference"}},{"_key":"84cae871ac8f","_type":"link","blank":false,"locale":"en","path":"/best-charities-to-donate-to-2026","reference":{"_ref":"19WWgKZWtauMC0Wqq0a6AW","_type":"reference"}},{"_key":"39bfa52d196a","_type":"link","blank":false,"href":"/donate/organizations#other-supported-programs"}],"style":"callout"}],"locale":"en","logo":{"_type":"image","asset":{"_ref":"image-892afc4c393a634feaff63daee7fb1a894a638b6-1050x1050-png","_type":"reference"}},"order":999,"pageBuilder":[{"_key":"9efd4a57683b","_type":"pageTitle","removePaddingAbove":"never","removePaddingBelow":"never","title":"METR (formerly called ARC Evals)"},{"_key":"721875125380","_type":"article","body":[{"_key":"51d9de4e86d2","_type":"youtube","title":"Safety evaluations and standards for AI | Beth Barnes | EAG Bay Area 23","youtubeVideoId":"Vb5g7jlNzOk"},{"_key":"b131c263d03d","_type":"block","children":[{"_key":"b1f1e967c278","_type":"span","marks":[],"text":"What problem is METR working on?"}],"markDefs":[],"style":"h2"},{"_key":"72f00a2096eb","_type":"block","children":[{"_key":"0c118f3939b40","_type":"span","marks":[],"text":"As AI systems become more powerful, it becomes increasingly important to ensure these systems are safe and aligned with our interests. A "},{"_key":"0c118f3939b41","_type":"span","marks":["225ab69e0be4"],"text":"growing number of experts"},{"_key":"0c118f3939b42","_type":"span","marks":[],"text":" are concerned that future AI systems pose an existential risk to humanity — and according to one study of machine learning researchers conducted by AI Impacts, the median respondent reported believing that there is a 5% chance of an “"},{"_key":"0c118f3939b43","_type":"span","marks":["ec32bc80a74e"],"text":"extremely bad outcome (e.g. human extinction)"},{"_key":"0c118f3939b44","_type":"span","marks":[],"text":"”. One way to prepare for this is to be able to evaluate current systems and "},{"_key":"0c118f3939b45","_type":"span","marks":["de8afe2e464a"],"text":"receive warning signs if new risks emerge"},{"_key":"0c118f3939b46","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"225ab69e0be4","_type":"link","href":"https://www.safe.ai/statement-on-ai-risk"},{"_key":"ec32bc80a74e","_type":"link","href":"https://aiimpacts.org/how-bad-a-future-do-ml-researchers-expect/"},{"_key":"de8afe2e464a","_type":"link","href":"https://www.deepmind.com/blog/an-early-warning-system-for-novel-ai-risks"}],"style":"normal"},{"_key":"52ba8d411896","_type":"block","children":[{"_key":"6488a3da61a80","_type":"span","marks":[],"text":"What does METR do?"}],"markDefs":[],"style":"h2"},{"_key":"bad719d11a02","_type":"block","children":[{"_key":"5fac6179c5220","_type":"span","marks":[],"text":"METR is contributing to the following AI governance approach:"}],"markDefs":[],"style":"normal"},{"_key":"0962d44b4b18","_type":"block","children":[{"_key":"9bc8d1dfbd320","_type":"span","marks":[],"text":"Before a new large-scale system is released, assess whether it is capable of potentially catastrophic activities."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"093ee3d7aa32","_type":"block","children":[{"_key":"a721f3590861","_type":"span","marks":[],"text":"If so, require strong guarantees that the system "},{"_key":"17f21cd9523c","_type":"span","marks":["em"],"text":"will not"},{"_key":"c5a1a2245e51","_type":"span","marks":[],"text":" carry out such activities."}],"level":1,"listItem":"number","markDefs":[],"style":"normal"},{"_key":"8b3a2d5e8438","_type":"block","children":[{"_key":"e74f593286740","_type":"span","marks":[],"text":"METR's current work focuses primarily on evaluating capabilities (the first step above), in particular a capability they call "},{"_key":"e74f593286741","_type":"span","marks":["strong"],"text":"autonomous replication"},{"_key":"e74f593286742","_type":"span","marks":[],"text":" — the ability of an AI system to survive on a cloud server, obtain money and compute resources, and use those resources to make more copies of itself."}],"markDefs":[],"style":"normal"},{"_key":"66ee4a3ce473","_type":"block","children":[{"_key":"2ef5320939320","_type":"span","marks":[],"text":"Evals was given early access to "},{"_key":"2ef5320939321","_type":"span","marks":["9bdf531c8823"],"text":"OpenAI’s"},{"_key":"2ef5320939322","_type":"span","marks":[],"text":" "},{"_key":"2ef5320939323","_type":"span","marks":["354ec12372a8"],"text":"GPT-4"},{"_key":"2ef5320939324","_type":"span","marks":[],"text":" and "},{"_key":"2ef5320939325","_type":"span","marks":["e9dbed2d151c"],"text":"Anthropic’s"},{"_key":"2ef5320939326","_type":"span","marks":[],"text":" "},{"_key":"2ef5320939327","_type":"span","marks":["4d1cbf83d0ed"],"text":"Claude"},{"_key":"2ef5320939328","_type":"span","marks":[],"text":" to assess them for safety. They determined that these systems are not capable of “"},{"_key":"2ef5320939329","_type":"span","marks":["d07be7d84f91"],"text":"fairly basic steps towards autonomous replication"},{"_key":"2ef53209393210","_type":"span","marks":[],"text":"” — but still, some of the steps they can take are already somewhat alarming. One "},{"_key":"2ef53209393211","_type":"span","marks":["27f389c2ab93"],"text":"highly"},{"_key":"2ef53209393212","_type":"span","marks":[],"text":" "},{"_key":"2ef53209393213","_type":"span","marks":["fbaa780f0a99"],"text":"publicised"},{"_key":"2ef53209393214","_type":"span","marks":[],"text":" example from METR’s assessment was that GPT-4 successfully pretended to be a vision-impaired human to convince a TaskRabbit worker to solve a CAPTCHA code."}],"markDefs":[{"_key":"9bdf531c8823","_type":"link","href":"https://openai.com/"},{"_key":"354ec12372a8","_type":"link","href":"https://openai.com/gpt-4"},{"_key":"e9dbed2d151c","_type":"link","href":"https://www.anthropic.com/"},{"_key":"4d1cbf83d0ed","_type":"link","href":"https://www.anthropic.com/index/introducing-claude"},{"_key":"d07be7d84f91","_type":"link","href":"https://evals.alignment.org/"},{"_key":"27f389c2ab93","_type":"link","href":"https://gizmodo.com/gpt4-open-ai-chatbot-task-rabbit-chatgpt-1850227471"},{"_key":"fbaa780f0a99","_type":"link","href":"https://www.foxbusiness.com/technology/openais-gpt-4-faked-being-blind-deceive-taskrabbit-human-helping-solve-captcha"}],"style":"normal"},{"_key":"981ee63e113f","_type":"block","children":[{"_key":"f8f70bfadbfb0","_type":"span","marks":[],"text":"Suppose AI systems "},{"_key":"f8f70bfadbfb1","_type":"span","marks":["em"],"text":"could "},{"_key":"f8f70bfadbfb2","_type":"span","marks":[],"text":"autonomously replicate, what are the risks?"}],"markDefs":[],"style":"normal"},{"_key":"9c512734059f","_type":"block","children":[{"_key":"233fc132a4b00","_type":"span","marks":[],"text":"They could become extremely powerful tools for malicious actors."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"9aa5ad181844","_type":"block","children":[{"_key":"740b782d3f120","_type":"span","marks":[],"text":"They could replicate, accrue power and resources, and use these to further their own goals. Without guarantees these goals are aligned with our own, this could have catastrophic — potentially even existential — consequences for humanity."},{"_key":"2fb162f4438e","_type":"span","marks":["sup","small","0897aaac2443"],"text":"1"}],"level":1,"listItem":"bullet","markDefs":[{"_key":"0897aaac2443","_type":"note","note":[{"_key":"1d242dc2e13a","_type":"block","children":[{"_key":"7e7ededd39f80","_type":"span","marks":[],"text":"For a more comprehensive breakdown of the catastrophic risks AI systems may bring, we recommend reading the "},{"_key":"22e55bba6d1d","_type":"span","marks":["0f851b9278d7"],"text":"Overview of Catastrophic AI Risks"},{"_key":"d86853e229cc","_type":"span","marks":[],"text":" from the "},{"_key":"617b52f3e323","_type":"span","marks":["1267f031dccd"],"text":"Center of AI Safety"},{"_key":"ac40758a1868","_type":"span","marks":[],"text":"."}],"markDefs":[{"_key":"0f851b9278d7","_type":"link","blank":false,"href":"https://arxiv.org/pdf/2306.12001.pdf"},{"_key":"1267f031dccd","_type":"link","blank":false,"href":"https://www.safe.ai/ai-risk"}],"style":"normal"}]}],"style":"normal"},{"_key":"4d9f7a83389d","_type":"block","children":[{"_key":"2e5d890c902a","_type":"span","marks":[],"text":"Therefore, METR is also exploring developing safety standards that could ensure that even systems "},{"_key":"864c30ede2641","_type":"span","marks":["em"],"text":"capable "},{"_key":"864c30ede2642","_type":"span","marks":[],"text":"or "},{"_key":"864c30ede2643","_type":"span","marks":["em"],"text":"powerful "},{"_key":"864c30ede2644","_type":"span","marks":[],"text":"enough to be dangerous won’t be. This could include security against theft by people who would use the system for harm, monitoring so that any surprising and unintended behaviour is quickly noticed and addressed, and sufficient alignment with human interests such that the system would not choose to take catastrophic actions (for example, reliably refusing to assist users seeking to use the system for harm)."}],"markDefs":[],"style":"normal"},{"_key":"d981b9b121ef","_type":"block","children":[{"_key":"e184cd517b900","_type":"span","marks":[],"text":"What evidence is there of METR's effectiveness?"},{"_key":"7dcd52199b67","_type":"span","marks":["00a8ad1c4422","sup"],"text":"1."}],"markDefs":[{"_key":"00a8ad1c4422","_type":"note","note":[{"_key":"7028f8012a19","_type":"block","children":[{"_key":"8ce246ec5ec30","_type":"span","marks":[],"text":"We have varying degrees of information about the cost-effectiveness of our supported programs. We have more information about programs that impact-focused evaluators (some of which our research team expects to investigate soon as part of their "},{"_key":"b22153a4f7ba","_type":"span","marks":["d6ffd61c9254"],"text":"evaluator investigations"},{"_key":"c2ee68d5399e","_type":"span","marks":[],"text":") have looked into, as well as programs that we’ve previously included on our "},{"_key":"35bebf926f97","_type":"span","marks":["8a8b78d27dee"],"text":"list of recommended charities"},{"_key":"af66e089a0a4","_type":"span","marks":[],"text":". We think it’s important to share the information we have with donors as we expect it will be useful in their donation decisions, but don’t want donors to mistakenly "},{"_key":"8ce246ec5ec31","_type":"span","marks":["em"],"text":"overweight"},{"_key":"8ce246ec5ec32","_type":"span","marks":[],"text":" the extent to which we share information about some charities and not others. Therefore, we want to clarify two things:"}],"markDefs":[{"_key":"d6ffd61c9254","_type":"link","blank":false,"locale":"en","path":"/why-and-how-gwwc-evaluates-the-evaluators","reference":{"_ref":"3213f5c8-5405-4ded-8661-b1500200cf92","_type":"reference"}},{"_key":"8a8b78d27dee","_type":"link","blank":false,"locale":"en","path":"/best-charities-to-donate-to-2026","reference":{"_ref":"19WWgKZWtauMC0Wqq0a6AW","_type":"reference"}}],"style":"normal"},{"_key":"516707ea40f1","_type":"block","children":[{"_key":"a6d5d42be03d0","_type":"span","marks":[],"text":"When we include information about an organisation’s cost-effectiveness, this may not be the "},{"_key":"a6d5d42be03d1","_type":"span","marks":["em"],"text":"only"},{"_key":"a6d5d42be03d2","_type":"span","marks":[],"text":" evidence that exists. It is simply the evidence the GWWC research team has at this time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"134a60a61c7a","_type":"block","children":[{"_key":"1322981554b10","_type":"span","marks":[],"text":"When we don’t include information about an organisation’s cost-effectiveness, this does not necessarily mean there is no such information. However, it does mean the GWWC research team isn’t privy to any more information at this time."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"}]}],"style":"h2"},{"_key":"195177dd3c91","_type":"block","children":[{"_key":"baf9bfbb17100","_type":"span","marks":[],"text":"After investigating METR's strategy and track record, Longview Philanthropy recommended a grant of $220,000 from its public fund in 2023. In reference to this grant, Longview shared that they thought METR had among the most promising and direct paths to impact on AI governance: “test models to see if they’re capable of doing extremely dangerous things; if they are, require strong guarantees that they won’t.”"}],"markDefs":[],"style":"normal"},{"_key":"e72bc04fa4e4","_type":"block","children":[{"_key":"d9eff9e15c890","_type":"span","marks":[],"text":"There are a few other positive indicators of the organisation’s cost-effectiveness:"}],"markDefs":[],"style":"normal"},{"_key":"ac03739a3ada","_type":"block","children":[{"_key":"df2c7a411cfe0","_type":"span","marks":[],"text":"METR is already partnered with OpenAI (the creators of ChatGPT and GPT-4) and Anthropic (the creators of Claude). This indicates a proof of concept of their primary work evaluating capabilities of AI systems prior to their release."}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"40ed79d79f95","_type":"block","children":[{"_key":"d1c18a6f53cb0","_type":"span","marks":[],"text":"METR has leadership with highly relevant experience and credentials:"}],"level":1,"listItem":"bullet","markDefs":[],"style":"normal"},{"_key":"277e5103cf9b","_type":"block","children":[{"_key":"3418b49355310","_type":"span","marks":[],"text":"The project is led by "},{"_key":"3418b49355311","_type":"span","marks":["fe48f1e8e6ba"],"text":"Beth Barnes"},{"_key":"3418b49355312","_type":"span","marks":[],"text":", a researcher who previously worked at "},{"_key":"3418b49355313","_type":"span","marks":["0fd030189035"],"text":"DeepMind"},{"_key":"3418b49355314","_type":"span","marks":[],"text":" and OpenAI."}],"level":2,"listItem":"bullet","markDefs":[{"_key":"fe48f1e8e6ba","_type":"link","href":"https://www.barnes.page/"},{"_key":"0fd030189035","_type":"link","href":"https://www.deepmind.com/"}],"style":"normal"},{"_key":"5559293cef95","_type":"block","children":[{"_key":"f037f27628350","_type":"span","marks":[],"text":"The Alignment Research Center (where METR was incubated) is led by "},{"_key":"f037f27628351","_type":"span","marks":["b00e98e255d0"],"text":"Paul Christiano"},{"_key":"f037f27628352","_type":"span","marks":[],"text":", who helped pioneer the main safety mechanism that frontier labs such as OpenAI, Anthropic, and DeepMind use to make their AI systems better aligned with human values."}],"level":2,"listItem":"bullet","markDefs":[{"_key":"b00e98e255d0","_type":"link","href":"https://paulfchristiano.com/"}],"style":"normal"},{"_key":"733dc6e77d63","_type":"block","children":[{"_key":"d2b96be2bc87","_type":"span","marks":[],"text":"As of July 2023, METR could make good use of millions of dollars in additional funding over the next 18 months.\n\nNote: At the time of Longview's grant, METR was the evaluations project at the Alignment Research Center. It now a standalone non profit. "}],"markDefs":[],"style":"normal"}],"excerpt":[{"_key":"f78ebc618266","_type":"block","children":[{"_key":"0a429f20edef0","_type":"span","marks":[],"text":"METR (formerly known as ARC Evals) was the "},{"_key":"0a429f20edef1","_type":"span","marks":["0427219b31a8"],"text":"evaluations project"},{"_key":"0a429f20edef2","_type":"span","marks":[],"text":" at the "},{"_key":"0a429f20edef3","_type":"span","marks":["30dedecc1b01"],"text":"Alignment Research Center"},{"_key":"344d4ffe95b6","_type":"span","marks":[],"text":" and is now a standalone non-profit. Its work assesses whether cutting-edge AI systems could pose catastrophic risks to civilization."}],"markDefs":[{"_key":"0427219b31a8","_type":"link","href":"https://evals.alignment.org/"},{"_key":"30dedecc1b01","_type":"link","href":"https://www.alignment.org/"}],"style":"normal"}],"removePaddingAbove":"never","removePaddingBelow":"never"}],"parentPage":{"_id":"0ef471c4-d453-4148-b68f-b4495442efdd","locale":"en","path":"/charities","title":"Charities"},"path":"/charities/arc-evals","purpose":[{"_key":"f78ebc618266","_type":"block","children":[{"_key":"0a429f20edef0","_type":"span","marks":[],"text":"METR (formerly called ARC Evals) is the "},{"_key":"0a429f20edef1","_type":"span","marks":["0427219b31a8"],"text":"evaluations project"},{"_key":"0a429f20edef2","_type":"span","marks":[],"text":" at the "},{"_key":"0a429f20edef3","_type":"span","marks":["30dedecc1b01"],"text":"Alignment Research Center"},{"_key":"0a429f20edef4","_type":"span","marks":[],"text":". Its work assesses whether cutting-edge AI systems could pose catastrophic risks to civilization."}],"markDefs":[{"_key":"0427219b31a8","_type":"link","href":"https://evals.alignment.org/"},{"_key":"30dedecc1b01","_type":"link","href":"https://www.alignment.org/"}],"style":"normal"}],"rating":"supportedNotListed","showCharityNotice":true,"slug":{"_type":"slug","current":"arc-evals"},"title":"METR (formerly called ARC Evals)","website":"https://evals.alignment.org/"},"preview":false,"contentLocale":"en","initialApolloState":{"ROOT_QUERY":{"__typename":"Query","allGlobalStatsList":[{"__typename":"GlobalStat","gwwcPledgesTotal":11208,"activeTryGivingPledgesTotal":1649,"tryGivingCompletedTotal":5516,"pledgersCountriesTotal":118,"pledgesDonationsTotal":"394245578.13218436613632815164","gwwcDonationsTotal":"596851083.06299539921386594518"}],"allProgramDetailsLegacies":{"__typename":"ProgramDetailsLegaciesConnection","edges":[{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"transformative-ai-fund","name":"EA Funds","program":"Transformative AI Fund","type":"NON_PROFIT","active":true,"hidden":false,"href":null,"isDataSharingPartner":true,"causeArea":"GLOBAL_CATASTROPHIC_RISKS"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"wild-animal-suffering-research","name":"Wild Animal Initiative","program":"Wild Animal Welfare Research and Field Building","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://www.wildanimalinitiative.org/","isDataSharingPartner":true,"causeArea":"ANIMAL_WELFARE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"innovations-for-poverty-action","name":"Innovations for Poverty Action","program":"","type":"NON_PROFIT","active":false,"hidden":false,"href":null,"isDataSharingPartner":true,"causeArea":"GLOBAL_HEALTH"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"healthier-hens","name":"Healthier Hens","program":"","type":"NON_PROFIT","active":false,"hidden":true,"href":"https://www.healthierhens.com/","isDataSharingPartner":true,"causeArea":"ANIMAL_WELFARE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"sentience-institute","name":"Sentience Institute","program":"","type":"NON_PROFIT","active":false,"hidden":false,"href":null,"isDataSharingPartner":true,"causeArea":"ANIMAL_WELFARE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"fish-welfare-initiative","name":"Fish Welfare Initiative","program":"Farmed Fish Welfare Improvements","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://www.fwi.fish","isDataSharingPartner":true,"causeArea":"ANIMAL_WELFARE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"acx-grants","name":"Astral Codex Ten","program":"ACX Grants Fund","type":"META","active":false,"hidden":true,"href":"https://astralcodexten.substack.com/p/apply-for-an-acx-grant","isDataSharingPartner":true,"causeArea":"EFFECTIVE_GIVING_OR_EFFECTIVE_ALTRUISM"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"ea-grants","name":"Centre for Effective Altruism","program":"EA Grants","type":"NON_PROFIT","active":false,"hidden":true,"href":null,"isDataSharingPartner":true,"causeArea":"EFFECTIVE_GIVING_OR_EFFECTIVE_ALTRUISM"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"community-building-grants","name":"Centre for Effective Altruism","program":"Community Building Grants","type":"META","active":false,"hidden":true,"href":null,"isDataSharingPartner":true,"causeArea":"EFFECTIVE_GIVING_OR_EFFECTIVE_ALTRUISM"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"animal-welfare","name":"EA Funds","program":"Animal Welfare Fund","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://funds.effectivealtruism.org/funds/animal-welfare","isDataSharingPartner":true,"causeArea":"ANIMAL_WELFARE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"new-incentives","name":"New Incentives","program":"Cash Incentives for Childhood Vaccinations","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://www.newincentives.org","isDataSharingPartner":true,"causeArea":"GLOBAL_HEALTH"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"ea-community","name":"EA Funds","program":"Effective Altruism Infrastructure Fund","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://funds.effectivealtruism.org/funds/ea-community","isDataSharingPartner":true,"causeArea":"EFFECTIVE_GIVING_OR_EFFECTIVE_ALTRUISM"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"european-environmental-policy","name":"Institute for European Environmental Policy","program":"European Environmental Policy Advancement","type":"NON_PROFIT","active":false,"hidden":false,"href":"https://www.ieep.eu","isDataSharingPartner":true,"causeArea":"CLIMATE_CHANGE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"industrious-labs","name":"Industrious Labs","program":"Heavy Industry Decarbonisation","type":"NON_PROFIT","active":true,"hidden":true,"href":"https://industriouslabs.org/","isDataSharingPartner":true,"causeArea":"CLIMATE_CHANGE"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"iodine-global-network","name":"Iodine Global Network","program":"Iodine Deficiency Protection","type":"NON_PROFIT","active":false,"hidden":true,"href":"https://www.ign.org","isDataSharingPartner":true,"causeArea":"GLOBAL_HEALTH"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"future-of-humanity-foundation","name":"Future of Humanity Foundation","program":"","type":"NON_PROFIT","active":false,"hidden":true,"href":null,"isDataSharingPartner":true,"causeArea":"GLOBAL_CATASTROPHIC_RISKS"}},{"__typename":"ProgramDetailsLegaciesEdge","node":{"__typename":"ProgramDetailsLegacy","slug":"action-for-happiness","name":"Action for Happiness","program":"Wellbeing Programs","type":"NON_PROFIT","active":true,"hidden":false,"href":"https://acti