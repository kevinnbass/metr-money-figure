<script>
  document.addEventListener("DOMContentLoaded", function(event) {
    addIdsToHeaders();

    const postContent = document.querySelector(".content");
    if (!postContent) return;
    // Embedded components (the interactive charts) use headings for their own
    // titles, which are not part of the document outline. tocbot's own
    // convention is .js-toc-ignore, so honour it both here and below —
    // otherwise those headings inflate the count that decides whether a TOC
    // appears at all, as well as appearing in it.
    const TOC_IGNORE = '.hoverover *, .js-toc-ignore, .js-toc-ignore *';
    const headings = Array.from(postContent.querySelectorAll('h1, h2, h3, h4, h5'))
      .filter(function (h) { return !h.matches(TOC_IGNORE); }).length;
    // Threshold also used in _layouts/post.html to decide the content
    // column offset when no TOC will appear.
    if (headings >= 4) {
      const tocSidebar = document.querySelector('.toc-sidebar');
      if (tocSidebar) {
        tocSidebar.classList.add('display-toc');
      }
      tocbot.init({
        // Where to render the table of contents.
        tocSelector: '.toc-container',
        // Where to grab the headings to build the table of contents.
        contentSelector: '.content',
        // Which headings to grab inside of the contentSelector element.
        headingSelector: 'h1, h2, h3, h4, h5',
        // Ensure correct positioning
        hasInnerContainers: true,
        ignoreSelector: TOC_IGNORE,
        headingsOffset: 180,
        scrollSmooth: false,
        scrollSmoothOffset: -72,
        collapseDepth: 2,
        disableTocScrollSync: false,
        // We toggle `.is-position-fixed` ourselves in handleTocSidebarPosition()
        // (below) so the switch point can track the header height live, rather
        // than tocbot's single hardcoded fixedSidebarOffset.
        positionFixedSelector: null,
        onClick: function(e) {
          const headerId = e.target.getAttribute('href').replace('#', '');
          openContentByHeaderId(headerId);
        }
      });

      // Position the TOC sidebar as the user scrolls.
      //
      // At rest the sidebar is `position: absolute` at `top: 130px` inside
      // `.content`. Once `.content` scrolls up to the top of the viewport we
      // switch it to `position: fixed` (still resolving to top:130px via the
      // cascade, so there's no visual jump). The switch point is therefore the
      // document offset of `.content`, which we measure live so it stays
      // correct regardless of header height — a long title/subheading pushes
      // `.content` down, which a single hardcoded offset can't track.
      function handleTocSidebarPosition() {
        const tocSidebar = document.querySelector('.toc-sidebar');
        const content = document.querySelector('.content');
        if (!tocSidebar || !content) return;

        const scrollTop = window.scrollY;
        const contentTop = content.getBoundingClientRect().top + scrollTop;
        tocSidebar.classList.toggle('is-position-fixed', scrollTop > contentTop);

        // Stop the fixed sidebar before its bottom reaches the featured
        // research section (present on posts, but not on all pages).
        const featuredResearch = document.querySelector('.featured-research-section');
        if (featuredResearch && tocSidebar.classList.contains('is-position-fixed')) {
          const sidebarHeight = tocSidebar.offsetHeight;
          const featuredResearchTop = featuredResearch.getBoundingClientRect().top + scrollTop;
          // The point where the sidebar bottom would hit the featured research section
          const stopPoint = featuredResearchTop - sidebarHeight - 160;
          if (scrollTop > stopPoint) {
            // Switch to absolute positioning, anchored at the stop point
            tocSidebar.classList.add('is-stopped');
            tocSidebar.style.top = (stopPoint - contentTop + 70) + 'px'; // 70px matches the original top offset
            return;
          }
        }
        tocSidebar.classList.remove('is-stopped');
        tocSidebar.style.top = '';
      }

      window.addEventListener('scroll', handleTocSidebarPosition);
      window.addEventListener('resize', handleTocSidebarPosition);
      handleTocSidebarPosition();

      // Make TOC fade when overlapping with tables, images, or figures.
      //
      // Fading only hides the sidebar; it still takes the pointer, and its
      // :hover rule then lifts it to z-index 20, above the content. Over a
      // static image that is harmless — it's how you bring a faded TOC back to
      // read it. Over something interactive it means the sidebar intercepts
      // hovers and clicks meant for the controls underneath, so those overlaps
      // make it click-through as well as faded.
      //
      // Anchors are deliberately not in CONTROLS: figcaptions carry footnote
      // links, and counting those would mark nearly every figure interactive
      // and cost the hover-to-reveal everywhere.
      const CONTROLS = 'button, input, select, textarea, summary';

      function handleTocOverlap() {
        const tocSidebar = document.querySelector('.toc-sidebar');
        if (!tocSidebar) return;
        const isVisible = tocSidebar.offsetWidth > 0 || tocSidebar.offsetHeight > 0;
        if (!isVisible) return;

        const tocRect = tocSidebar.getBoundingClientRect();
        const content = document.querySelector('.content');
        if (!content) return;

        const elements = content.querySelectorAll('table, img, figure');
        let isOverlapping = false;
        let overlapsControls = false;

        for (const el of elements) {
          const elRect = el.getBoundingClientRect();
          const horizontalOverlap = elRect.left < tocRect.right && elRect.right > tocRect.left;
          const verticalOverlap = elRect.top < tocRect.bottom && elRect.bottom > tocRect.top;

          if (horizontalOverlap && verticalOverlap) {
            isOverlapping = true;
            if (el.querySelector(CONTROLS)) {
              overlapsControls = true;
              break;
            }
          }
        }

        tocSidebar.classList.toggle('toc-faded', isOverlapping);
        tocSidebar.classList.toggle('toc-passthrough', overlapsControls);
      }

      window.addEventListener('scroll', handleTocOverlap);
      window.addEventListener('resize', handleTocOverlap);

      handleTocOverlap();

      // Update URL hash as the user scrolls, so refreshing restores position.
      // Uses replaceState to avoid polluting browser history.
      let hashUpdateTimer = null;
      window.addEventListener('scroll', function() {
        if (hashUpdateTimer) return;
        hashUpdateTimer = setTimeout(() => { hashUpdateTimer = null; }, 200);
        const activeLink = document.querySelector('.toc-container .is-active-link');
        if (activeLink) {
          const href = activeLink.getAttribute('href');
          if (href && href !== window.location.hash) {
            // Only update hash for visible headings (not inside closed details)
            const headingId = href.replace('#', '');
            const heading = document.getElementById(headingId);
            if (heading && heading.offsetParent !== null) {
              history.replaceState(null, '', href);
            }
          }
        }
      });

      window.setTimeout(() => {
        /* Solves a bug where the TOC links don't land on the right place
        https://github.com/tscanlin/tocbot/issues/254 */
        tocbot.refresh();
      }, 100);
    }
  });
</script>


<script type="application/javascript">
  document.addEventListener('DOMContentLoaded', () => {
    littlefoot.littlefoot({
      activateOnHover: true,
      dismissOnUnhover: true,
      activateCallback: function(tooltip, button) {
        const match = button.id.match(/lf-fnref:(\d+):?\d*/);
        if (match) {
          const downLink = tooltip.querySelector('.littlefoot__content .a-fn-ref-raw');
          // move it inside the tag before it (i.e., the paragraph tag)
          if (downLink) {
            downLink.setAttribute('href', `#fn:${match[1]}`);
            const content = tooltip.querySelector('.littlefoot__content');
            const tags = content.children;
            if (tags.length > 0) {
              // find the last tag that isn't this link itself
              let lastTag = tags[tags.length - 1];
              if (lastTag === downLink) {
                lastTag = tags[tags.length - 2];
              }
              lastTag.appendChild(downLink);
            }
          }
        }
        // Littlefoot cloned the footnote's HTML into this popover before MathJax
        // typeset the page, so any math inside is still raw TeX. Now that the
        // popover is in the DOM, typeset it once (the same node is reused across
        // hovers, so the dataset flag prevents redundant re-typesetting).
        if (window.MathJax && MathJax.typesetPromise && !tooltip.dataset.mathTypeset) {
          // 'pending' guards against a second typeset while this one is in flight;
          // it flips to 'done' on success, or is cleared on failure so a transient
          // MathJax error can be retried on the next hover rather than latching the
          // popover on raw TeX.
          tooltip.dataset.mathTypeset = 'pending';
          MathJax.typesetPromise([tooltip]).then(function () {
            tooltip.dataset.mathTypeset = 'done';
            // Only widen popovers that actually rendered math (see the
            // .littlefoot__popover.has-math rule). Text-only footnotes keep the
            // default width.
            if (tooltip.querySelector('mjx-container')) {
              tooltip.classList.add('has-math');
              const content = tooltip.querySelector('.littlefoot__content');
              const wrapper = tooltip.querySelector('.littlefoot__wrapper');
              // Only widen on non-mobile; below 768px littlefoot uses a full-width
              // bottom sheet that we must not override.
              if (content && window.matchMedia('(min-width: 768px)').matches) {
                // Size the popover to the widest rendered equation rather than a
                // fixed width. Display math doesn't wrap (prose does), so the widest
                // mjx-container is what would otherwise overflow. Add the content's
                // horizontal padding, the vertical scrollbar width, and a small
                // safety margin so the equation clears the edges; clamp between
                // littlefoot's 22em default and 90vw.
                let widest = 0;
                tooltip.querySelectorAll('mjx-container').forEach(function (eq) {
                  widest = Math.max(widest, eq.getBoundingClientRect().width);
                });
                const cs = getComputedStyle(content);
                const padding = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
                const scrollbar = content.offsetWidth - content.clientWidth;
                const emPx = parseFloat(getComputedStyle(tooltip).fontSize);
                const defaultWidth = 22 * emPx;
                const natural = Math.ceil(widest) + padding + scrollbar + 8;
                // Ceiling: never wider than 90vw, and never more than 60em even on
                // an ultra-wide monitor (a runaway formula scrolls within the box).
                const maxWidth = Math.min(window.innerWidth * 0.9, 60 * emPx);
                const target = Math.max(defaultWidth, Math.min(natural, maxWidth));
                // Littlefoot's resize() pinned the wrapper's inline max-width to the
                // narrow pre-widen content width; clear it so the content can expand
                // to the new width (re-firing resize alone would just re-pin narrow).
                if (wrapper) wrapper.style.maxWidth = '';
                tooltip.style.width = Math.round(target) + 'px';
              }
              // Fire window resize+scroll so littlefoot re-runs its own resize() and
              // reposition() against the new width, so the wider box stays on-screen
              // and the arrow re-centers — reusing littlefoot's geometry rather than
              // duplicating it. (These events also nudge a few cheap, idempotent
              // resize/scroll listeners elsewhere, with no visible effect since
              // scroll position and viewport size are unchanged.)
              window.dispatchEvent(new Event('resize'));
              window.dispatchEvent(new Event('scroll'));
            }
          }).catch(function (err) {
            // Clear the flag so a transient failure can be retried on the next hover.
            delete tooltip.dataset.mathTypeset;
            console.error('MathJax typeset of footnote popover failed:', err);
          });
        }
      },
      buttonTemplate: `<button
        aria-label="Footnote <% number %>"
        class="littlefoot__button"
        id="<% reference %>"
        />
        <span class="fn-ref-raw">[<% reference %>]</span>
      </button>`,
      contentTemplate: `<aside
          alt="Footnote <% number %>"
          class="littlefoot__popover"
          id="fncontent:<% id %>"
        >
          <div class="littlefoot__wrapper">
            <div class="littlefoot__content">
              <% content %>
              <a data-footnote-ref="<% reference %>" class="a-fn-ref-raw" aria-label="Back to reference <% number %>"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640" style="height: 1rem" aria-hidden="true">
                <path d="M297.4 566.6C309.9 579.1 330.2 579.1 342.7 566.6L502.7 406.6C515.2 394.1 515.2 373.8 502.7 361.3C490.2 348.8 469.9 348.8 457.4 361.3L352 466.7L352 96C352 78.3 337.7 64 320 64C302.3 64 288 78.3 288 96L288 466.7L182.6 361.3C170.1 348.8 149.8 348.8 137.3 361.3C124.8 373.8 124.8 394.1 137.3 406.6L297.3 566.6z"/>
              </svg></a>
            </div>
          </div>
          <div class="littlefoot__tooltip"></div>
        </aside>`
    });
    // Down arrow from: Font Awesome Free v7.0.0 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc. */
    transformFootnoteReferences();
    markLastFootnotesInGroupsByParagraph();
    wrapFootnotesPrecedingCommasInNoWrapSpans();
    addSpacesBetweenFootnotes();
    scrollDownToFootnotesOnClick();
  });
</script>



</body>
</html>
