        <div class="row">
          <div class="col-12 col-xl-5 col-lg-6 col-sm-5 mb-4">
            <h4>Resources</h4>
            <ul>
              <li><a href="/research">Research</a></li>
              <li><a href="/notes">Notes</a></li>
