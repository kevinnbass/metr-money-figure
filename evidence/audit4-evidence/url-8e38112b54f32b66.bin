  .content .robot-excerpt-container li::marker {
    color: var(--bs-body-color);
  }

  .robot-excerpt-container:has(.robot-icon + p) .robot-icon {
    margin-top: 25px;
  }

  /* The source document keeps a few board strings green even inside a blue
     quote, so allow an explicit opt-out from the rule below. */
  /* Timestamps in the signing-key table read badly when broken across lines. */
  .signing-key-table td:nth-child(3) {
    white-space: nowrap;
  }
  .content .board,
  .content .board code {
    color: #188038;
  }
  /* Code nested inside a quote takes that quote's color, not the green default. */
  .content .robot-excerpt-container code,
  .content .cot code,
  .content .cot-paraphrase code {
    color: inherit;
  }
  /* Some transcripts need bold or italic markup to render, which a
     pre/code block can't do, so those are plain paragraphs or list items
     instead — restore the monospace look with a font-family rather than
     a code element. ".content p" sets a sans-serif font at equal
     specificity, so qualify with ".content" too to win the cascade. */
  .content .robot-excerpt-container > p,
  .content .robot-excerpt-container li {
    font-family: var(--bs-font-monospace);
  }
  /* The robot icon's position (both the gap next to it and its vertical
     alignment) is tuned against .content .highlight pre's own
     `padding: 26px`, which plain paragraphs/lists don't have. Match it
     so the icon lines up the same way it does for a <pre> block. */
  .content .robot-excerpt-container > p {
