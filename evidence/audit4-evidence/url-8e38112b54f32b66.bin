  /* The source document colors agent text by what it is: message-board text,
     agent identifiers and commands in green, verbatim chain-of-thought in blue,
     and paraphrased chain-of-thought (the {braces}) in a darker blue. Green is
     the default for monospace here; the two blues are opt-in.
     This also supersedes Bootstrap's pink standalone <code>, which it only
     resets to inherit when the code is nested in a <pre>. */
  .content code,
  .content .robot-excerpt-container {
