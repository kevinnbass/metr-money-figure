});
</script></div></div><main id="main" class="page_main"><section data-wf--section--variant="inherit" class="u-section"><div data-wf--spacer--variant="none" class="u-section-spacer u-ignore-trim"></div><div class="u-container  "><div data-wf--layout--variant="breakout" class="u-layout-wrapper w-variant-4fee4cc0-701f-2817-944f-2c0261b9c2f3"><div class="u-layout w-variant-4fee4cc0-701f-2817-944f-2c0261b9c2f3"><div class="u-layout-column-1 w-variant-4fee4cc0-701f-2817-944f-2c0261b9c2f3  "><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div><div data-number="20" data-wf--typography-heading--variant="h2" class="u-heading w-variant-433d40c6-c261-f13f-c899-61d2cadf150f w-richtext"><h1>FAR.AI is an AI security research and adoption non-profit</h1></div><div data-number="60" data-wf--typography-paragraph--variant="inherit" class="u-text u-rich-text w-richtext"><p>We facilitate technical breakthroughs, foster global collaboration and advance global understanding of AI risks and solutions</p></div><div class="u-button-wrapper"><div class="u-display-contents"><div data-wf--button-main--variant="primary" data-button=" " data-trigger="hover focus" class="button_main_wrap"><div data-wf--clickable--variant="focus-ring-outside" class="clickable_wrap u-cover-absolute"><a aria-label="Join our team" href="/careers" class="clickable_link w-inline-block"></a></div><div class="button_main_element"><div class="button_main_icon u-hide-if-empty"></div><div aria-hidden="true" class="button_main_text u-text-style-main">Join our team</div><div class="button_main_icon u-hide-if-empty"></div></div></div><div><div data-wf--button-main--variant="secondary" data-button=" " data-trigger="hover focus" class="button_main_wrap"><div data-wf--clickable--variant="focus-ring-outside" class="clickable_wrap u-cover-absolute"><a aria-label="Donate now" href="https://www.every.org/far-ai-inc?utm_campaign=donate-link#/donate" target="_blank" class="clickable_link w-inline-block"></a></div><div class="button_main_element w-variant-e85564cd-af30-a478-692b-71732aefb3ab"><div class="button_main_icon u-hide-if-empty"></div><div aria-hidden="true" class="button_main_text u-text-style-main">Donate now</div><div class="button_main_icon u-hide-if-empty"></div></div></div></div></div></div><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></div><div class="u-layout-column-2 w-variant-4fee4cc0-701f-2817-944f-2c0261b9c2f3 u-ratio-1-1"><div data-wf--visual-image--variant="wide-16-9" class="u-image-wrapper w-variant-27d05669-180c-3169-9b64-0eda31f8d4d3"><img src="https://cdn.prod.website-files.com/6a53dbc6fa4e1a57fd55a002/6aa28cf35b506f25190da260_e056fb4c8308674c3ae17fee5709e650_About%20Hero%20Image.jpg" loading="lazy" alt="" sizes="(max-width: 1920px) 100vw, 1920px" srcset="https://cdn.prod.website-files.com/6a53dbc6fa4e1a57fd55a002/6aa28cf35b506f25190da260_e056fb4c8308674c3ae17fee5709e650_About%20Hero%20Image-p-500.jpg 500w, https://cdn.prod.website-files.com/6a53dbc6fa4e1a57fd55a002/6aa28cf35b506f25190da260_e056fb4c8308674c3ae17fee5709e650_About%20Hero%20Image-p-800.jpg 800w, https://cdn.prod.website-files.com/6a53dbc6fa4e1a57fd55a002/6aa28cf35b506f25190da260_e056fb4c8308674c3ae17fee5709e650_About%20Hero%20Image-p-1080.jpg 1080w, https://cdn.prod.website-files.com/6a53dbc6fa4e1a57fd55a002/6aa28cf35b506f25190da260_e056fb4c8308674c3ae17fee5709e650_About%20Hero%20Image.jpg 1456w" class="u-image"/></div></div></div></div></div><div data-wf--spacer--variant="none" class="u-section-spacer u-ignore-trim"></div></section><section data-wf--section--variant="brand" class="u-section w-variant-25bf08d9-3196-322b-5616-019ac7f0f4f7"><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div><div class="u-container  "><div data-wf--layout--variant="columns" class="u-layout-wrapper"><div class="u-layout w-variant-558793eb-2b07-490b-9842-2d7e6f6bf325"><div class="u-layout-column-1 u-align-self-start"><div data-number="20" data-wf--typography-heading--variant="h2" class="u-heading w-variant-433d40c6-c261-f13f-c899-61d2cadf150f w-richtext"><h2>Why FAR.AI Exists</h2></div></div><div class="u-layout-column-2 w-variant-558793eb-2b07-490b-9842-2d7e6f6bf325  "><div data-number="60" data-wf--typography-paragraph--variant="inherit" class="u-text u-rich-text w-richtext"><p>At FAR.AI, we are motivated by the potential risks posed by rapid advances in AI capabilities. We work to ensure advanced AI is trustworthy,  secure and beneficial for everyone.</p><p>Our goal is to close the research-adoption gap by developing solutions to high-leverage technical safety challenges and scaling them to real-world deployment. Our approach emphasizes tight empirical feedback loops on real-world manifestations of large-scale AI risks.</p></div></div></div></div></div><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div></section><section data-wf--section--variant="inherit" class="u-section"><div data-wf--spacer--variant="main" class="u-section-spacer w-variant-60a7ad7d-02b0-6682-95a5-2218e6fd1490 u-ignore-trim"></div><div class="u-container  "><div data-wf--layout--variant="stack" class="u-layout-wrapper"><div class="u-layout"><div class="u-layout-column-1  "><div data-number="20" data-wf--typography-heading--variant="h2" class="u-heading w-variant-433d40c6-c261-f13f-c899-61d2cadf150f w-richtext"><h2>Our Operating Model</h2></div></div><div class="u-layout-column-2  "><div data-wf--grid--settings-variant="default" STYLE="" data-number="12" class="u-grid-wrapper u-gap-0"><div role="none" data-large-columns="3" data-medium-columns="1" data-small-columns="0" data-xsmall-columns="0" class="u-grid"><div class="card_primary_wrap"><div class="card_primary_group"><div class="card_primary_element"><div data-wf--icon-by-brand--variant="green" class="card_primary_icon w-variant-a70cd728-ab58-44a2-63b3-85db85238b34"><div class="card_primary_icon-slot"><div aria-hidden="true" data-wf--icon--variant="full" class="u-icon w-embed"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
