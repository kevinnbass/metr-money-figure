<script src="https://cdn.jsdelivr.net/npm/lenis@1.2.3/dist/lenis.min.js"></script>
<script>
  const lenis = new Lenis({ autoRaf: true });
  window.lenis = lenis;

  // 8rem, computed from the real root font-size
  const rem = parseFloat(getComputedStyle(document.documentElement).fontSize);
  const OFFSET = -8 * rem; // negative = lands lower, clearing your sticky header

  document.addEventListener('click', (e) => {
    const link = e.target.closest('a[href^="#"]');
    if (!link) return;
    const id = link.getAttribute('href').slice(1);
    if (!id) return;                 // ignore a bare "#"
    const target = document.getElementById(id);
    if (!target) return;
    e.preventDefault();
    e.stopPropagation();             // kills Webflow's jQuery scroll handler
    lenis.scrollTo(target, { offset: OFFSET });
  }, true);                          // ← capture phase is what makes this win

</script>

