.slider_offset { --slide-count: var(--lg); --lg: 3; --md: var(--lg); --sm: var(--md); --xs: var(--sm); }
@container (width < 53em) {
  * {
    --_responsive---large: 0;
    --_responsive---medium: 1;
    --contents-medium: contents;
    --flex-medium: flex;
    --none-medium: none;
    --column-medium: column;
    --row-medium: row;
