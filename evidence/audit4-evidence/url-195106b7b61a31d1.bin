:51 GMT+0000 (UTC)","date":{"publishedAt":"2026-09-13T22:59:19.000Z","createdAt":"2026-09-13T22:59:18.000Z","modifiedAt":"2026-09-13T23:13:51.000Z"},"primaryImage":{"id":"vidimg584505356","headline":{"primary":null},"altText":null,"caption":null,"url":{"primary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg"},"imageUrl":{"aims":"https://media14.s-nbcnews.com/i/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg","cloudinary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg","telemundo":null},"source":null,"authors":[],"height":null,"width":null,"graphicContent":false},"teaseImage":{"id":"vidimg584505356","headline":{"primary":null},"altText":null,"caption":null,"url":{"primary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg"},"imageUrl":{"aims":"https://media14.s-nbcnews.com/i/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg","cloudinary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340354373_wnn_jki_nfl_prediction_markets_260913_S3_1920x1080-6sj6gh.jpg","telemundo":null},"source":null,"authors":[],"height":null,"width":null,"graphicContent":false},"url":{"canonical":"https://www.nbcnews.com/nightly-news/video/could-this-nfl-season-be-the-biggest-yet-for-prediction-markets-269795397950","primary":"https://www.nbcnews.com/nightly-news/video/could-this-nfl-season-be-the-biggest-yet-for-prediction-markets-269795397950","short":"https://www.nbcnews.com/nightly-news/video/could-this-nfl-season-be-the-biggest-yet-for-prediction-markets-269795397950","slug":"could-this-nfl-season-be-the-biggest-yet-for-prediction-markets-269795397950"},"relatedUrl":nu