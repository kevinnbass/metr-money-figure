37 GMT+0000 (UTC)","description":{"primary":null},"id":"nctx24138","isCurated":false,"name":"Sports","path":"nbcnews/section/sports","pageRoute":"/","slug":"sports","type":"taxonomy","taxonomyType":"section","url":{"primary":null}}],"primaryVertical":{"name":"News"},"primarySection":null,"primaryTopic":null},"hasCaptions":true,"closedCaptioning":{"smptett":null,"srt":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/09/1789340354373_wnn_jki_nfl_prediction_markets_260913.srt","webvtt":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/09/1789340354373_wnn_jki_nfl_prediction_markets_260913.vtt"},"videoAssets":[{"assetType":"EMP","format":"M3U","publicUrl":"http://link.theplatform.com/s/rksNhC/5KuDcO4Ldn3B","height":1080,"width":1920,"assetDuration":118.119,"bitrate":4288000},{"assetType":"akamaiMp4","format":"MPEG4","publicUrl":"http://link.theplatform.com/s/rksNhC/UEn5I_waTzt2","height":1080,"width":1920,"assetDuration":118.119,"bitrate":4288097}]},{"type":"video","id":"mmvo269796933616","contentRules":{"contentClassifications":["UNRESTRICTED"]},"unibrow":{"logo":null,"taxonomyPath":null,"text":"Nightly News","url":{"primary":null}},"mpxMetadata":{"id":"269796933616","guid":"wnn_kod_trump_ireland_criticism_260913","externalAdvertiserId":"wnn_kod_trump_ireland_criticism_260913"},"datePublished":"Sun Sep 13 2026 22:58:22 GMT+0000 (UTC)","dateCreated":"Sun Sep 13 2026 22:58:22 GMT+0000 (UTC)","dateModified":"Sun Sep 13 2026 23:13:51 GMT+0000 (UTC)","date":{"publishedAt":"2026-09-13T22:58:22.000Z","createdAt":"2026-09-13T22:58:22.000Z","modifiedAt":"2026-09-13T23:13:51.000Z"},"primaryImage":{"id":"vidimg2366290112","headline":{"primary":null},"altText":null,"caption":null,"url":{"primary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg"},"imageUrl":{"aims":"https://media14.s-nbcnews.com/i/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg","cloudinary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg","telemundo":null},"source":null,"authors":[],"height":null,"width":null,"graphicContent":false},"teaseImage":{"id":"vidimg2366290112","headline":{"primary":null},"altText":null,"caption":null,"url":{"primary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg"},"imageUrl":{"aims":"https://media14.s-nbcnews.com/i/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg","cloudinary":"https://media-cldnry.s-nbcnews.com/image/upload/mpx/2704722219/2026_09/1789340298523_wnn_kod_trump_ireland_criticism_260913_S3_1920x1080-dvgb8m.jpg","telemundo":null},"source":null,"authors":[],"height":null,"width":null,"graphicContent":false},"url":{"canonical":"https://www.nbcnews.com/nightly-news/video/trump-ireland-comments-draws-criticism-overseas-269796933616","primary":"https://www.nbcnews.com/nightly-news/video/trump-ireland-comments-draws-criticism-overseas-269796933616","short":"https://www.nbcnews.com/nightly-news/video/trump-ireland-comments-draws-criticism-overseas-269796933616","slug":"trump-ireland-comments-draws-criticism-overseas-269796933616"},"relatedUrl":null,"relatedContentLink":{"text":null,"url":null},"duration":"PT57S","nativeAd":false,"videoType":"broadcast","sentiment":"neutral","headline":{"primary":"Trump Ireland comments draws criticism overseas","tease":"Trump Ireland comments draws criticism overseas","social":"Trump Ireland comments draws criticism overseas"},"description":{"primary":"President Trump said Saturday he would “love” ⁠to see Ireland unify with the U.K.’s Northern Ireland, remarks that received immediate pushback from unionists in the region. NBC News’ Kelly O’Donnell reports."},"publisher":{"name":"nbcnews"},"source":{"name":"Nightly News","roles":[]},"taxonomy":{"additionalTerms":[{"dateCreated":"Thu Sep 16 2021 03:36:46 GMT+0000 (UTC)","dateModified":"Thu Sep 16 2021 03:36:46 GMT+0000 (UTC)","description":{"primary":null},"id":"nctx19","isCurated":true,"name":"Nightly News","path":"nbcnews/show/nightly-news","pageRoute":"/nightly-news","slug":"nightly-news","type":"taxonomy","taxonomyType":"show","url":{"primary":"https://www.nbcnews.com/nightly-news"}}],"primaryVertical":{"name":"News"},"primarySection":null,"primaryTopic":null},"hasCaptions":true,"closedCaptioning":{"smptett":null,"srt":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/09/1789340298523_wnn_kod_trump_ireland_criticism_260913.srt","webvtt":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/captions/2026/09/1789340298523_wnn_kod_trump_ireland_criticism_260913.vtt"},"videoAssets":[{"assetType":"EMP","format":"M3U","publicUrl":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/wnn_kod_trump_ireland_criticism_260913/1/abs/index.m3u8","height":1080,"width":1920,"assetDuration":56.79,"bitrate":4132000},{"assetType":"akamaiMp4","format":"MPEG4","publicUrl":"https://prodamdnewsencoding.akamaized.net/NBC_News_Digital/nbcnews/video/2026/09/1789340298523_wnn_kod_trump_ireland_criticism_260913_6.mp4","height":1080,"width":1920,"assetDuration":56.79,"bitrate":4132362}]},{"type":"video","id":"mmvo269796421746","contentRules":{"contentClassifications":["UNRESTRICTED"]},"unibrow":{"logo":null,"taxonomyPath":null,"text":"Nightly News","url":{"primary":null}},"mpxMetadata":{"id":"269796421746","guid":"wnn_ag_airplanescares_260913","externalAdvertiserId":"wnn_ag_airplanescares_260913"},"datePublished":"Sun Sep 13 2026 22:44:20 GMT+0000 (UTC)","dateCreated":"Sun Sep 13 2026 22:44:19 GMT+0000 (UTC)","dateModified":"Sun Sep 13 2026 23:13:51 GMT+0000 (UTC)","date":{"publishedAt":"2026-09-13T22:44:20.000Z","createdAt":"2026-