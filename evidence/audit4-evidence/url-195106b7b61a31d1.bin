2"></path><path d="M35.88 23.3904C39.0296 23.3904 41.0336 20.8845 40.141 17.8807C39.5317 15.8425 36.6696 13.8686 33.7688 15.8039L22.3848 23.3904H35.88Z" fill="#05AC3F"></path><path d="M28.8204 5.73708L22.9804 19.0779L21.3112 7.48783C21.0966 5.91302 23.7785 4.94324 23.7785 4.94324C23.5339 4.39828 22.6886 4.40687 22.6886 4.40687H20.8778H20.8735C20.586 1.55763 23.1735 -0.519228 25.9669 0.115843C28.7175 0.725168 29.713 3.71172 28.8204 5.73708Z" fill="#6E55DC"></path><path d="M19.4644 4.59143C19.885 1.64779 17.246 -0.532058 14.3925 0.115887C11.6419 0.729503 10.6464 3.71606 11.5389 5.74142L17.379 19.0822L19.4644 4.59143Z" fill="#EF1541"></path><path d="M16.9129 21.2663L11.3088 8.49197C9.99577 5.53116 6.52004 5.16213 4.60196 6.89999C3.25028 8.12293 2.20327 11.4571 5.22415 13.4738L16.9129 21.2663Z" fill="#FF7112"></path><path d="M35.136 13.4738C38.1569 11.457 37.1099 8.12292 35.7582 6.89569C33.8401 5.16212 30.3644 5.52685 29.0513 8.48766L23.4473 21.262L35.136 13.4738Z" fill="#069DE0"></path><path d="M117.772 15.6579C115.52 17.5803 114.086 18.6659 110.838 18.6659H110.701C106.23 18.6659 103.462 15.1945 103.462 11.9805C103.462 8.29452 106.723 5.2951 110.727 5.2951C113.953 5.32513 115.661 7.05441 116.481 7.89116L116.61 8.0199L120.377 4.25666C119.957 3.83614 116.743 0.00427246 110.765 0.00427246C103.882 0.00427246 98.1668 5.23073 98.1367 11.9548C98.1367 18.4814 103.625 23.9696 110.701 23.9997C116.026 23.9997 118.721 21.8241 121.222 19.6829L117.772 15.6579Z" fill="black"></path><path d="M96.0643 16.2158C96.0643 22.4163 91.0996 23.3904 87.9929 23.3904H74.7422V0.596436H87.98C92.0393 0.596436 95.2833 2.90072 95.2833 7.22178C95.2833 9.3587 93.7772 10.5387 92.6315 11.1223C94.5195 12.0663 96.0643 13.4609 96.0643 16.2158ZM79.5868 4.87459V9.18707C79.5868 9.18707 86.5425 9.18707 87.4007 9.18707C88.6923 9.18707 90.1083 8.65068 90.1083 7.04584C90.1083 5.441 89.0055 4.87459 87.2205 4.87459C86.2035 4.87459 79.5868 4.87459 79.5868 4.87459ZM90.9151 16.2158C90.9151 14.0273 89.0914 13.4609 87.319