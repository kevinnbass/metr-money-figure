{"code":200,"message":"OK","tweet":{"url":"https://x.com/METR_Evals/status/2082644379895050339","id":"2082644379895050339","text":"We have reached an agreement with OpenAI to conduct an independent review, with Redwood Research, of the model behavior observed during the Hugging Face incident. We will publish a blog post that describes the terms of our engagement, the scope covered, and tentative conclusions.","raw_text":{"text":"We have reached an agreement with OpenAI to conduct an independent review, with Redwood Research, of the model behavior observed during the Hugging Face incident. We will publish a blog post that describes the terms of our engagement, the scope covered, and tentative conclusions.","display_text_range":[0,280],"facets":[]},"author":{"screen_name":"METR_Evals","url":"https://x.com/METR_Evals","id":"1706770561903497216","followers":53201,"following":39,"likes":1484,"media_count":175,"name":"METR","description":"We work to scientifically measure whether and when AI systems might threaten catastrophic harm to society. Nonprofit.","raw_description":{"text":"We work to scientifically measure whether and when AI systems might threaten catastrophic harm to society. Nonprofit.","facets":[]},"location":"Berkeley, CA","banner_url":"https://pbs.twimg.com/profile_banners/1706770561903497216/1724202300","avatar_url":"https://pbs.twimg.com/profile_images/2021827383431757824/AeVvT0rU_200x200.jpg","joined":"Tue Sep 26 20:39:57 +0000 2023","protected":false,"website":{"url":"http://metr.org","display_url":"metr.org"},"verification":{"verified":true,"verified_at":null,"type":"organization"},"avatar_color":null},"replies":46,"retweets":254,"likes":2358,"bookmarks":333,"quotes":66,"created_at":"Thu Jul 30 01:48:08 +0000 2026","created_timestamp":1785376088,"views":252309,"is_note_tweet":false,"community_note":null,"lang":"en","replying_to":null,"replying_to_status":null,"source":"Twitter Web App","twitter_card":"tweet","color":null,"provider":"twitter","reposted_