4)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","medium":"https:\/\/f10.pmo.ee\/_ZVdowaIIlUM6agMASwmvY1ZqbA=\/540x960\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","large":"https:\/\/f10.pmo.ee\/b_RJg4llRsto5CfytJhqEsF5cBw=\/1080x1920\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","butterfly":"https:\/\/f10.pmo.ee\/So1JqThjhlKdin9Am4mJuqkxGDI=\/1080x0\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"},"landscape":{"xxsmall":"https:\/\/f10.pmo.ee\/J9LHemxpNWR9QE066zA-ab0cpjE=\/0x50\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","xsmall":"https:\/\/f10.pmo.ee\/Hnu5pF1Ikwd3r5KI6_yTDfc6ZjQ=\/0x155\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","small":"https:\/\/f10.pmo.ee\/EExBH8U4bAhoX_82rAOSwvzBRDY=\/480x270\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","medium":"https:\/\/f10.pmo.ee\/Fp6iAPaupMY8Dx4KVHpzmxPpK4M=\/960x540\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","large":"https:\/\/f10.pmo.ee\/QDIwFEspvjR7oqlqv-TYZG9Yed8=\/1920x1080\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","branding":"https:\/\/f10.pmo.ee\/J6pklh0-M1wCJiaD5b_dqyvCuoI=\/0x60\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","tvnetTraffic":"https:\/\/f10.pmo.ee\/Cwp4B5ymzRqDRJOBjlcUu1PoJyA=\/140x93\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","pmTv":"https:\/\/f10.pmo.ee\/DH2PN_Dwsx8FDuZdEJBnWwp2CwU=\/538x422\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","pmTv2":"https:\/\/f10.pmo.ee\/H_uV766JhNJsNJMjqjrjDuvMAf4=\/525x500\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"}},"title":{"et":"Jaan Tallinn","ru":"","en":"","lv":""},"meta":{"isEmbedded":false},"terms":[],"thumbor":{"host":"f10.pmo.ee","path":"nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","focalAreas":[{"topLeftX":1017,"topLeftY":499,"bottomRightX":1032,"bottomRightY":514}]},"isLead":true,"isLeadMedia":true,"outputFormat":"webp","displaySources":{"sources":{"1x":"\/\/f10.pmo.ee\/cMfCQXGo3Uk9f3gONyZ-qfX55hY=\/721x0\/filters:focal(1017x499:1032x514):format(webp)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","2x":"\/\/f10.pmo.ee\/DhPO-MnfQzpOUJ5dcUlgocFrdQ8=\/1442x0\/filters:focal(1017x499:1032x514):format(webp)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"},"string":"\/\/f10.pmo.ee\/cMfCQXGo3Uk9f3gONyZ-qfX55hY=\/721x0\/filters:focal(1017x499:1032x514):format(webp)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg 1x, \/\/f10.pmo.ee\/DhPO-MnfQzpOUJ5dcUlgocFrdQ8=\/1442x0\/filters:focal(1017x499:1032x514):format(webp)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg 2x"}}],"articleLead":[{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Eelmisel nädalal teatas maailma üks juhtivaid tehisaruettevõtteid Anthropic, et kaasas investoritelt 30 miljardit dollarit, millega kasvatas ettevõtte väärtuse 380 miljardi dollarini.<\/p>","wordCount":19,"isLead":true}],"articleBody":[{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Rahastamisvoorus osalesid peaaegu kõik finantsmaailma raskekahurid nagu Blackstone, BlackRock, Fidelity, JPMorgan Chase, Morgan Stanley, Katari riiklik investeerimisfond ja paljud teised.<\/p>","wordCount":20},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Tegemist oli 2021. aastal asutatud tehisaruarendaja kuuenda rahastamisvooruga.<\/p>","wordCount":7},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Esimese, 2021. aastal toimunud rahastamisvooru, mille käigus kaasati 124 miljonit dollarit, juhtivinvestor oli Skype’i kaasasutaja Jaan Tallinn. Investoriks oli ka Google’i pikaajaline tegevjuht Eric Schmidt.<\/p>","wordCount":23},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Jaan Tallinn osales ka aasta hiljem toimunud rahastamisvoorus, millega kaasati 580 miljonit dollarit, aga mitte enam juhtivinvestorina. Selle vooru juhtivinvestoriks oli omal ajal maailma suurima krüptovarade kauplemiskeskkonna FTX suuromanik ja tegevjuht Sam Bankman-Fried, kes mõisteti 2024. aastal terve rea finantskuriteo eest süüdi ja määrati 25 aastat vanglakaristust.<\/p>","wordCount":44},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Enne viimast oli vähemalt meie jaoks üheks märkimisväärsemaks rahakaasamiseks eelmise aasta septembris lõpuleviidud F seeria voor, millega kaasati 13 miljardit dollarit ning ettevõtte väärtuseks kujunes 183 miljardit dollarit.<\/p>","wordCount":26},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Ehkki Jaan Tallinn pole soostunud ütlema, kui suur tema osalus ettevõttes on andis iduettevõtte 183 miljardi dollariline väärtus aluse spekuleerida, et temast võis saada Kristo Käärmanni, Taavet Hinrikuse ja Markus Villigu kõrval meie neljas miljardär.<\/p>","wordCount":34},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Kuid edukas rahastamisvoor (The Wall Street kirjutas jaanuari alguses, et algselt oli ettevõttel kaasata kümme miljardit dollarit) ei olnud ainus sündmus, millega Anthropic viimastel nädalatel tähelepanu on äratanud.<\/p>","wordCount":28},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Meediakära tekitas Anthropicu Ameerika jalgpalliliiga finaalvõistlusel Super Bowl näidatud reklaam, kus pilati OpenAI väljatöötatud tehisarurakendust ChatGPT.<\/p>","wordCount":16},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Kuid kaks nädalat tagasi põhjustas Anthropic Ameerika Ühendriikide börsidel müügilaine pärast seda kui välja tulu ettevõtte uus tööriist, mis tekitas tarkvaraettevõtete investorites paanika, sest kardetakse, et Anthropicu ettevõtetele mõeldud tarkvaratööriist asendab paljude tarkvaraettevõtete rakendusi.<\/p>","wordCount":34},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Nüüd kus Anthropicu väärtus on kerkinud 380 miljardi dollarini, tekib taas küsimus, kui suure osa sellest kuulub Jaan Tallinnale.<\/p>","wordCount":18},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Pärast eelmise aasta sügisel toimunud rahastamisvooru ütles Tallinn Äripäevale: «Praeguse <i>series F<\/i> ja <i>series A<\/i> vahel on olnud mitu Metaplaneti osalust tublisti lahjendavat raundi.» Metaplanet on Jaan Tallinnale kuuluv investeerimisettevõte.<\/p>","wordCount":30},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">Samas on Tallinnal ilmselt piisavalt suur osalus, et ta võiks olla ka ettevõtte nõukogu liige, aga on nõukogu vaatleja.<\/p>","wordCount":19},{"type":"htmlElement","html":"<p class=\"MsoNoSpacing\">«Ma nimelt ei tahtnud nõukogu liikmeks astuda, kuna mu põhitöö on ikka AI-riskide vähendamine, seetõttu ei tahtnud ma olla nii tugevalt seotud ühe sellise juhtiva ettevõttega,» ütles Tallinn jaanuari alguses Äripäeva raadiole.<\/p>","wordCount":32},{"type":"htmlElement","html":"<p>Nüüd kus Jaan Tallinna osalus on sügisega võrreldes kaks korda väärtuslikum, võib üsna kindlalt oletada, et ta on miljardär, vähemalt paberil.<\/p>","wordCount":21},{"type":"htmlElement","html":"<figure class=\"table\"><div class=\"tableScrollContainer\"><table><tbody><tr><td colspan=\"4\">Anthropicu rahastamisvoorud<\/td><\/tr><tr><td>Aeg<\/td><td>rahastuse voor<\/td><td>Kaasatud summa, USD<\/td><td>Ettevõtte väärtus, USD<\/td><\/tr><tr><td>Mai 2021<\/td><td>A seeria<\/td><td>124 mln.<\/td><td> <\/td><\/tr><tr><td>Aprill 2022<\/td><td>B seeria<\/td><td>580 mln.<\/td><td> <\/td><\/tr><tr><td>Mai 2023<\/td><td>C seeria<\/td><td>450 mln.<\/td><td> <\/td><\/tr><tr><td>Märts 2025<\/td><td>E seeria<\/td><td>3,5 mld.<\/td><td>61,5<\/td><\/tr><tr><td>Sept. 2025<\/td><td>F seeria<\/td><td>13 mld.<\/td><td>183<\/td><\/tr><tr><td>Veebr. 2026<\/td><td>G seeria<\/td><td>30 mld.<\/td><td>380<\/td><\/tr><tr class=\"table-footer\"><td colspan=\"4\">Intellizence<\/td><\/tr><\/tbody><\/table><\/div><\/figure>","wordCount":31}],"authors":[{"id":73014,"email":"tonis.oja@post