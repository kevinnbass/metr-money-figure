":"https:\/\/f10.pmo.ee\/Fp6iAPaupMY8Dx4KVHpzmxPpK4M=\/960x540\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","large":"https:\/\/f10.pmo.ee\/QDIwFEspvjR7oqlqv-TYZG9Yed8=\/1920x1080\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","branding":"https:\/\/f10.pmo.ee\/J6pklh0-M1wCJiaD5b_dqyvCuoI=\/0x60\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","tvnetTraffic":"https:\/\/f10.pmo.ee\/Cwp4B5ymzRqDRJOBjlcUu1PoJyA=\/140x93\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","pmTv":"https:\/\/f10.pmo.ee\/DH2PN_Dwsx8FDuZdEJBnWwp2CwU=\/538x422\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","pmTv2":"https:\/\/f10.pmo.ee\/H_uV766JhNJsNJMjqjrjDuvMAf4=\/525x500\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"}},"title":{"et":"Jaan Tallinn","ru":"","en":"","lv":""},"meta":{"isEmbedded":false},"terms":[],"thumbor":{"host":"f10.pmo.ee","path":"nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","focalAreas":[{"topLeftX":1017,"topLeftY":499,"bottomRightX":1032,"bottomRightY":514}]},"outputFormat":"webp"},"isArchived":false};
    
