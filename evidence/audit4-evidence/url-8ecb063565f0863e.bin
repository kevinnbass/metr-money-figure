 Tallinna osalusega Anthropicu väärtus on nüüd enam kui kolmandik triljonit","domain":"majandus.postimees.ee","paidArticle":false,"superArticle":false,"longRead":false,"isAudioInLead":false}},"showSuperArticleBadge":false,"superArticleAnimationUrl":false,"ogImage":{"id":17359967,"type":"image","role":null,"dateCreated":"2025-12-26T00:00:00+02:00","author":{"name":"Konstantin Sednev"},"imageType":0,"imageTypeText":null,"sources":{"square":{"xxsmall":"https:\/\/f10.pmo.ee\/hlk1MWBZ5WEcuxIzLzBhOhu6xno=\/50x50\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","xsmall":"https:\/\/f10.pmo.ee\/0GnfCrMVz6n1ys6CREKBWHzx82A=\/155x155\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","medium":"https:\/\/f10.pmo.ee\/63wYqK0YpMd67ETm4KR7rfqU7iA=\/650x650\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","large":"https:\/\/f10.pmo.ee\/bLbxo3fg9V_dfAx16rtjdh6hWl8=\/1080x1080\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"},"portrait":{"small":"https:\/\/f10.pmo.ee\/VE082nxTnjksNzcDj0RUD3ORU0I=\/270x480\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","medium":"https:\/\/f10.pmo.ee\/_ZVdowaIIlUM6agMASwmvY1ZqbA=\/540x960\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","large":"https:\/\/f10.pmo.ee\/b_RJg4llRsto5CfytJhqEsF5cBw=\/1080x1920\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","butterfly":"https:\/\/f10.pmo.ee\/So1JqThjhlKdin9Am4mJuqkxGDI=\/1080x0\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg"},"landscape":{"xxsmall":"https:\/\/f10.pmo.ee\/J9LHemxpNWR9QE066zA-ab0cpjE=\/0x50\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","xsmall":"https:\/\/f10.pmo.ee\/Hnu5pF1Ikwd3r5KI6_yTDfc6ZjQ=\/0x155\/filters:focal(1017x499:1032x514)\/nginx\/o\/2025\/12\/26\/17359967t1h5594.jpg","small":"https:\/\/f10.pmo.ee\/E