a5f\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showMeta\":false,\"showHighlight\":true,\"showCategory\":false,\"showBookmark\":true,\"analyticsId\":\"artikli-jalus_investori-toimetaja-valik-artikli-all\",\"className\":\"$undefined\",\"priorityImage\":false,\"headline\":[\"Baltic Workboatsi osalusega Soome börsifirma tüürib maksejõuetuse poole\"],\"headlinePlain\":\"Baltic Workboatsi osalusega Soome börsifirma tüürib maksejõuetuse poole\",\"lead\":[\"Eesti laevatootja Baltic Workboatsi (BWB) osalusega Soome kaitsetööstuse börsifirma Summa Defence on jõudnud olukorda, kus ettevõtte juhatuse hinnangul on käibekapital saanud otsa ja likviidsus järsult halvenenud. \"],\"highlight\":\"$undefined\",\"url\":\"/uudised/2026/09/14/baltic-workboatsi-osalusega-soome-borsifirma-tuurib-maksejouetuse-poole\",\"date\":\"2026-09-14T08:43:29.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=2c2e5b28-9587-5718-8e2a-a10857e22a52\",\"alt\":\"Summa Defence’i gruppi kuuluv Uudenkaupungin Työvene Oy teeb Saksamaa mereväele tänavu laeva.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/news\",\"label\":\"Uudised\"},\"icon\":\"chart\",\"badges\":[]}]}],[\"$\",\"$1\",\"7023fb52-a46f-4ef3-b4a6-d1c885dbfb93\",{\"children\":[\"$\",\"$L89\",null,{\"id\":\"7023fb52-a46f-4ef3-b4a6-d1c885dbfb93\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showMeta\":false,\"showHighlight\":true,\"showCategory\":false,\"showBookmark\":true,\"analyticsId\":\"artikli-jalus_investori-toimetaja-valik-artikli-all\",\"className\":\"$undefined\",\"priorityImage\":false,\"headline\":[\"Novo Nordisk uuendab brändi ja muudab nime \"],\"headlinePlain\":\"Novo Nordisk uuendab brändi ja muudab nime\",\"lead\":[\"Taani ravimifirma Novo Nordisk muudab nime ja logo ning hakkab edaspidi kasutama nime Novo. Uut brändi esitletakse investoritele 21. septembri investorpäeval Londonis.\"],\"highlight\":\"$undefined\",\"url\":\"/borsiuudised/2026/09/14/novo-nordisk-uuendab-brandi-ja-muudab-nime\",\"date\":\"2026-09-14T08:56:34.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=1d261319-d434-5583-808d-584fb166d031\",\"alt\":\"Taani ravimihiiu nimemuutusega kaasneb ka värskendatud logo. Ettevõtte logol olev Apise pull pööratakse teistpidi nii, et see vaatab edaspidi paremale.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/bors\",\"label\":\"Börsiuudised\"},\"icon\":\"chart\",\"badges\":[]}]}],[\"$\",\"$1\",\"c8a72c04-9e4b-44d3-96a9-a30d4bd465e1\",{\"children\":[\"$\",\"$L89\",null,{\"id\":\"c8a72c04-9e4b-44d3-96a9-a30d4bd465e1\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showMeta\":false,\"showHighlight\":true,\"showCategory\":false,\"showBookmark\":true,\"analyticsId\":\"artikli-jalus_investori-toimetaja-valik-artikli-all\",\"className\":\"$undefined\",\"priorityImage\":false,\"headline\":\"$La2\",\"headlinePlain\":\"OpenAI ei lähe tänavu börsile, Altman viitab ohutusriskidele\",\"lead\":\"$La3\",\"highlight\":\"$undefined\",\"url\":\"/borsiuudised/2026/09/13/openai-ei-lahe-tanavu-borsile-altman-viitab-ohutusriskidele\",\"date\":\"2026-09-13T06:53:34.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=aa1db90d-578f-51b7-a32f-189186559469\",\"alt\":\"Hoiatustele on lisanud kaalu juhtumid, kus AI-agendid on käitunud ettearvamatult ja tunginud välistesse infosüsteemidesse.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/bors\",\"label\":\"Börsiuudised\"},\"icon\":\"$undefined\",\"badges\":[]}]}],\"$La4\"]]}]]}]\n92:[\"$\",\"$L86\",\"828009df-d733-4011-8099-07792857d3e5\",{\"moduleType\":\"ad\",\"children\":[\"$\",\"$L80\",null,{\"type\":\"Module\",\"position\":2}]}]\n93:[\"$\",\"$L86\",\"6ce23756-0278-4235-9d3e-d30eedca426e\",{\"moduleType\":\"horizontal_articles\",\"children\":[null,[\"$\",\"$L88\",null,{\"children\":[[\"$\",\"$L89\",\"8750fbdd-8c2c-4f2e-b74d-0d597ccaf74d\",{\"id\":\"8750fbdd-8c2c-4f2e-b74d-0d597ccaf74d\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showHighlight\":true,\"analyticsId\":\"artikli-jalus_ap-operatiivne-2\",\"priorityImage\":false,\"showMeta\":false,\"showCategory\":false,\"showBookmark\":true,\"headline\":[\"Autokoolide maksuskeemid võtavad ausatelt tegijatelt töö\"],\"headlinePlain\":\"Autokoolide maksuskeemid võtavad ausatelt tegijatelt töö\",\"lead\":[\"Suuremad autokoolid on pahased riigi peale, et aastaid kestnud kõlvatule konkurentsile pole piiri pandud, maksu- ja tolliameti sõnul aga töö käib.\"],\"highlight\":\"$undefined\",\"url\":\"/suur-lugu/2026/09/11/autokoolide-maksuskeemid-votavad-ausatelt-tegijatelt-too\",\"date\":\"2026-09-14T03:00:00.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=76964074-fd76-5f82-b297-a31428053640\",\"alt\":\"Eesti autokoolide liidu presidendi, Tapa Autokool OÜ juhatuse liikme ja omaniku Neeme Külmalliku sõnul pole enamikul Eesti autokoolidel töölepinguga sõiduõpetajaid ning sektoris lokkab ebaaus konkurents.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/bigstory\",\"label\":\"Suur lugu\"},\"icon\":\"chart\",\"badges\":[]}],[\"$\",\"$L89\",\"5526b7f7-dd97-486a-948a-99c1119d0d2a\",{\"id\":\"5526b7f7-dd97-486a-948a-99c1119d0d2a\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showHighlight\":true,\"analyticsId\":\"artikli-jalus_ap-operatiivne-2\",\"priorityImage\":false,\"showMeta\":false,\"showCategory\":false,\"showBookmark\":true,\"headline\":[\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\"],\"headlinePlain\":\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\",\"lead\":[\"2024. aastal pühkis kindral Martin Herem käed kaitseväe juhataja raskest tööst puhtaks, pani ukse enda järel kinni ja lahkus vaba mehena. Nüüd naaseb ta pauguga sinnasamma ministeeriumisse, mille aeglust omal ajal siunas, et ise ministrina teisiti teha.\"],\"highlight\":\"$undefined\",\"url\":\"/uudised/2026/09/11/kindral-heremi-naasmine-voimukoridori-toi-esimese-ohvri-kas-ta-demokraatia-jaoks-hea-on-kahtlen\",\"date\":\"2026-09-12T03:00:00.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=98cf779f-ddbb-5eae-b3a2-1374044c0a7b\",\"alt\":\"Pärast Hanno Pevkuri kahimist tuli peaminister Kristen Michalil Martin Heremi (pildil) avangus ohverdada ka kaitseministeeriumi kantsler Kaimo Kuusk.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/news\",\"label\":\"Uudised\"},\"icon\":\"$undefined\",\"badges\":[]}],[\"$\",\"$L89\",\"db598e40-b4e9-4513-8152-b3a9b739657b\",{\"id\":\"db598e40-b4e9-4513-8152-b3a9b739657b\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showHighlight\":true,\"analyticsId\":\"artikli-jalus_ap-operatiivne-2\",\"priorityImage\":false,\"showMeta\":false,\"showCategory\":false,\"showBookmark\":true,\"headline\":[\"Tippettevõtja idee loob jõukatele uue viisi tuua miljardeid Eestisse\"],\"headlinePlain\":\"Tippettevõtja idee loob jõukatele uue viisi tuua miljardeid Eestisse\",\"lead\":[\"Rikaste perede vara hoidmiseks tahab valitsus luua uue vormi sihtasutusest, et see tooks riiki miljardeid. Maksureeglid on aga lahendamata.\"],\"highlight\":\"$undefined\",\"url\":\"/uudised/2026/09/09/tippettevotja-idee-loob-joukatele-uue-viisi-tuua-miljardeid-eestisse\",\"date\":\"2026-09-09T03:00:00.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=df725bf8-f00d-5986-ad23-37c10639cad8\",\"alt\":\"Ühiskond on liikumas faasi, kus inimestel on palju vara tekkinud, sõnas Martin Villig.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/news\",\"label\":\"Uudised\"},\"icon\":\"$undefined\",\"badges\":[]}],[\"$\",\"$L89\",\"6a779fae-9032-4c49-94b8-3dbed34c88e9\",{\"id\":\"6a779fae-9032-4c49-94b8-3dbed34c88e9\",\"channels\":[\"aripaev\"],\"showImage\":true,\"showVideo\":true,\"showHighlight\":true,\"analyticsId\":\"artikli-jalus_ap-operatiivne-2\",\"priorityImage\":false,\"showMeta\":false,\"showCategory\":false,\"showBookmark\":true,\"headline\":\"$La5\",\"headlinePlain\":\"“Terve armee advokaate.” Auditihiiglane tõi Baltcapi vastu raskekahurväe\",\"lead\":\"$La6\",\"highlight\":\"$La7\",\"url\":\"/uudised/2026/09/08/terve-armee-advokaate-auditihiiglane-toi-baltcapi-vastu-raskekahurvae\",\"date\":\"2026-09-08T15:22:31.000Z\",\"image\":{\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=07aeb99a-287a-58aa-b830-33eb14e5e534\",\"alt\":\"PwC Eesti äriühingu kõrval on suures tsiviilasjas kostjaks ka Ühendkuningriigis tegutsev PricewaterhouseCoopers.\"},\"video\":\"$undefined\",\"category\":{\"url\":\"/c/news\",\"label\":\"Uudised\"},\"icon\":\"$undefined\",\"badges\":[]}],\"$La8\",\"$La9\",\"$Laa\",\"$Lab\"]}],\"$undefined\"]}]\nad:T447,\u003cp\u003eEesti jalgpallikoondise peatreener Jürgen Henn rääkis tänavu veebruaris toimunud Gaselli Kongressil, kuidas tulla toime kaotusvaluga ning mis on ühist jalgpalli meeskonnal ja ettevõttel.\u003c/p\u003e\u003cp\u003e\"Kui meeskond kaotab, siis ma vaatan mängu umbes kuus korda ning lähen magama hommikul viis või neli,\" lausus Henn. \"Ma saan vastused kätte ja püstitan uued eesmärgid,\" lisas ta.\u003c/p\u003e\u003cp\u003eMuuhulgas rääkis Henn, kuidas ta pärast võitu tunneb, et see on meeskonna võit, aga kaotuse puhul kipub süüdistama iseennast. \"Kui mängija saab vigastada, siis ma vaatan ka kõigepealt iseendale otsa\".\u003c/p\u003e\u003cp\u003eLisaks jagas peatreener seda, millised on tema juhtimistaktikad ja äranägemised, et koostöö erinevate iseloomude vahel töötaks. \"Parim meeskond ei ole lihtsalt parimad mängijad, vaid koos peavad olema õiged tüübid,\" tõdes Henn.\u003c/p\u003e\u003cp\u003eJuttu tuli ka sellest, kuidas läbi hirmu motiveerimine võib teinekord toimida, miks ettevõtted peavad Eesti sporti toetama ja kui suur investor on Jürgen Henn.\u003c/p\u003e\u003cp\u003eJutuajamist vedas ajakirjanik Brent Pere.\u003c/p\u003e\u003cp\u003eFoto: Andras Kralla\u003c/p\u003e94:[\"$\",\"$L86\",\"bcaf7c20-a3cf-4df7-8984-70ff2f417703\",{\"moduleType\":\"radio_podcasts_and_video\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Podcastid\"}],[\"$\",\"$L88\",null,{\"children\":[[\"$\",\"$Lac\",\"01M2FH2EK9J859YVAY4WAJ2WPT\",{\"id\":\"01M2FH2EK9J859YVAY4WAJ2WPT\",\"channels\":\"$undefined\",\"headline\":[\"Jürgen Henn vaatab kaotatud mängu kuus korda ja läheb varavalges magama: saan siis vastused kätte\"],\"headlinePlain\":\"Jürgen Henn vaatab kaotatud mängu kuus korda ja läheb varavalges magama: saan siis vastused kätte\",\"url\":\"/raadio/episood/1409-lavajutud\",\"date\":\"2026-09-14T13:00:00.000Z\",\"image\":{\"authorPlain\":null,\"type\":\"image\",\"objectId\":null,\"width\":null,\"height\":null,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=258834f0-a7f4-5495-b35b-720cfeb802d4\",\"text\":null,\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Jürgen Henn vaatab kaotatud mängu kuus korda ja läheb varavalges magama: saan siis vastused kätte\"},\"category\":{\"url\":\"/raadio/saatesarjad/lavajutud\",\"label\":[\"Lavajutud\"]},\"badges\":[{\"kind\":\"pro\"}],\"icon\":\"audio\",\"media\":{\"id\":\"01M2FH2EK9J859YVAY4WAJ2WPT\",\"type\":\"audio\",\"title\":\"Jürgen Henn vaatab kaotatud mängu kuus korda ja läheb varavalges magama: saan siis vastused kätte\",\"permalink\":\"/raadio/episood/1409-lavajutud\",\"mediaUrl\":\"https://ap-cms-podcasts-v2.s3.amazonaws.com/01M2FH2EK9J859YVAY4WAJ2WPT/1789375147-01f55c2d4d690d6fc607757a53d11902-short.mp3\",\"kind\":\"default\",\"showPaywall\":true,\"access\":{\"pro\":true,\"subscriber\":false,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":false},\"publishDate\":\"2026-09-14T13:00:00.000Z\",\"meta\":{\"show\":{\"id\":\"5bab6ce8aff8e3000f855317\",\"permalink\":\"/raadio/saatesarjad/lavajutud\",\"title\":\"Lavajutud\"},\"tags\":[{\"name\":\"Ettevõtlus\"},{\"name\":\"Juhtimine\"},{\"name\":\"Kultuur\"},{\"name\":\"Sport\"}],\"description\":\"$ad\",\"imageUrl\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=258834f0-a7f4-5495-b35b-720cfeb802d4\",\"authors\":[{\"name\":\"Joonas-Hendrik Mägi\"}],\"chapters\":null}},\"analyticsId\":\"artikli-jalus_raadio-ja-podcastid-artikli-all\",\"layout\":\"player\",\"showPlayer\":true,\"showImage\":true,\"showHighlight\":true,\"priorityImage\":false,\"showMeta\":false,\"showCategory\":true,\"showBookmark\":true}],[\"$\",\"$Lac\",\"01M2FJE3Z4DF7N160B88YVGY2Z\",{\"id\":\"01M2FJE3Z4DF7N160B88YVGY2Z\",\"channels\":\"$undefined\",\"headline\":[\"Analüütik: Eesti väljavaade on poole aastaga märgatavalt paranenud\"],\"headlinePlain\":\"Analüütik: Eesti väljavaade on poole aastaga märgatavalt paranenud\",\"url\":\"/raadio/episood/analuutik-eesti-valjavaade-on-poole-aastaga-margatavalt-paranenud\",\"date\":\"2026-09-14T09:00:00.000Z\",\"image\":{\"authorPlain\":null,\"type\":\"image\",\"objectId\":null,\"width\":null,\"height\":null,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=c3adc724-db7f-5dbb-8dff-b78ccb4b3840\",\"text\":null,\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Analüütik: Eesti väljavaade on poole aastaga märgatavalt paranenud\"},\"category\":{\"url\":\"/raadio/saatesarjad/hommikuprogramm\",\"label\":\"$Lae\"},\"badges\":[],\"icon\":\"audio\",\"media\":{\"id\":\"01M2FJE3Z4DF7N160B88YVGY2Z\",\"type\":\"audio\",\"title\":\"Analüütik: Eesti väljavaade on poole aastaga märgatavalt paranenud\",\"permalink\":\"/raadio/episood/analuutik-eesti-valjavaade-on-poole-aastaga-margatavalt-paranenud\",\"mediaUrl\":\"https://ap-cms-podcasts-v2.s3.amazonaws.com/01M2FJE3Z4DF7N160B88YVGY2Z/1789376594-434acb8abea811e089020c81fb7fd641-short.mp3\",\"kind\":\"default\",\"showPaywall\":true,\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"publishDate\":\"2026-09-14T09:00:00.000Z\",\"meta\":{\"show\":{\"id\":\"5b966f85e5225f000f8a05e6\",\"permalink\":\"/raadio/saatesarjad/hommikuprogramm\",\"title\":\"Hommikuprogramm\"},\"tags\":[{\"name\":\"Eksport\"},{\"name\":\"Majandus\"}],\"description\":\"\u003cp\u003eEesti majandusel ei ole viimasel aastal läinud nii kehvasti, kui on tunnetatud, ja pika aja järel on taas põhjust oodata paremat ettevõtlus- ja nõudluskeskkonda, ütles Pärnu raamatupidamiskonverentsil rahandusministeeriumi analüütik Madis Aben.\u003c/p\u003e\u003cp\u003eKõige selgemad märgid on Soome ja Rootsi, kus majanduskasvu väljavaated on ootamatult positiivsed. Just Põhjamaade ja eriti nende ehitussektori nõrkus oli Eesti languse põhjus, seega toob sealne pööre kasu ka meile, rääkis Madis Aben.\u003c/p\u003e\u003cp\u003eKodumaist nõudlust toetab Abeni sõnul maksuküüru kaotamine, mis jätab tarbijatele kätte umbes 700 miljonit eurot, ning tarbijate ja ettevõtjate kindlustunne on alates maist tõusuteel. Abeni sõnum ettevõtjale on, et väljavaated on paremad kui pool aastat tagasi ja Eesti majandusel ei saa minna teisiti kui naabritel.\u003c/p\u003e\u003cp\u003eKüsis Mare Timian.\u003c/p\u003e\u003cp\u003eFoto autor: Liis Treimann\u003c/p\u003e\",\"imageUrl\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=c3adc724-db7f-5dbb-8dff-b78ccb4b3840\",\"authors\":[{\"name\":\"Mare Timian\"},{\"name\":\"Stiine Reintam\"}],\"chapters\":null}},\"analyticsId\":\"artikli-jalus_raadio-ja-podcastid-artikli-all\",\"layout\":\"player\",\"showPlayer\":true,\"showImage\":true,\"showHighlight\":true,\"priorityImage\":false,\"showMeta\":false,\"showCategory\":true,\"showBookmark\":true}],\"$Laf\",\"$Lb0\",\"$Lb1\",\"$Lb2\"]}],\"$Lb3\"]}]\n95:[\"$\",\"$L86\",\"c5ccd136-834f-4d57-9db2-5a9e06380cd5\",{\"moduleType\":\"carousel\",\"children\":\"$Lb4\"}]\n96:[\"$\",\"$L86\",\"9ba21636-3291-4859-8bde-6c9527f21fe6\",{\"moduleType\":\"user_hub\",\"children\":[\"$\",\"$Lb5\",null,{\"module\":{\"type\":\"user_hub\",\"configuration\":{\"label\":\"Minu Äripäev\",\"button\":null,\"color\":\"white\"},\"id\":\"9ba21636-3291-4859-8bde-6c9527f21fe6\",\"label\":\"MinuÄP\",\"gaId\":\"artikli-jalus_minuap\"},\"priorityImages\":false,\"access\":\"public\",\"channelId\":\"aripaev\",\"adsPositionFrom\":{\"Module\":1}}]}]\n97:[\"$\",\"$L86\",\"2f844513-0231-48b6-b5ce-41a646a9d92f\",{\"moduleType\":\"parallel\",\"children\":[\"$\",\"$Lb6\",null,{\"layout\":\"parallel\",\"children\":[[\"$\",\"$Lb7\",null,{\"requests\":[{\"type\":\"articles_most_read\",\"id\":\"\",\"limit\":6,\"segment\":\"all\",\"strategy\":\"default\",\"data\":[{\"timeframe\":\"last-day\",\"data\":[{\"permalink\":\"/uudised/2026/09/11/eesti-uus-limonaad-aratab-valismaal-huvi-see-on-poorane-kui-palju-on-meid-kusitud\",\"publishStartDate\":\"2026-09-13T06:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"e2650585-e4b6-4a24-898f-09d913a8ac32\",\"version\":22,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\"}]},\"headlinePlain\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane. \"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane.\",\"image\":{\"authorPlain\":\"Erakogu\",\"type\":\"image\",\"objectId\":\"0f779d87-ea86-5842-89ed-d3c31a694afc\",\"width\":6905,\"height\":4536,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=0f779d87-ea86-5842-89ed-d3c31a694afc\",\"text\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"84679d1a-80a6-4e51-af32-97dd908053e1\",\"type\":\"SubscriptionTag\",\"name\":\"Joogitööstus\",\"slug\":\"joogitoostus\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"47f75744-a8ac-45b7-9468-74cec207a09f\",\"type\":\"SubscriptionTag\",\"name\":\"Juhtimine\",\"slug\":\"juhtimine\"},{\"id\":\"f26c6715-f81e-4fe2-8d59-7c4ade6f8055\",\"type\":\"SubscriptionTag\",\"name\":\"Eksport\",\"slug\":\"eksport\"},{\"id\":\"b2f0fa43-48fc-4795-9444-1f58776fefb2\",\"type\":\"InfopankOrganisation\",\"externalId\":\"437470\",\"name\":\"FILLY CO OÜ\"},{\"id\":\"2733cb15-581e-41d2-9d8b-9dc656a95465\",\"type\":\"InfopankOrganisation\",\"externalId\":\"18341\",\"name\":\"GKR TRADE OÜ\"},{\"id\":\"76eddd2d-57ce-427e-a302-42ec44362d43\",\"type\":\"InfopankPerson\",\"externalId\":\"160735\",\"name\":\"Gert-Kristjan Rungi\"},{\"id\":\"3ae46e39-60dc-41a0-8a0e-0d5586d8f616\",\"type\":\"InfopankPerson\",\"externalId\":\"589711\",\"name\":\"Keili Sükijainen\"}],\"marketInstruments\":[]},{\"permalink\":\"/intervjuu/2026/08/31/karmen-joller-eestis-on-arste-ja-odesid-kes-tegelikult-ei-tohiks-tootada\",\"publishStartDate\":\"2026-09-13T07:30:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"ac711a9f-b68b-4b8e-b6fb-a07f8bba711f\",\"version\":26,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Karmen Joller: Eestis on arste ja õdesid, kes tegelikult ei tohiks töötada\"}]},\"headlinePlain\":\"Karmen Joller: Eestis on arste ja õdesid, kes tegelikult ei tohiks töötada\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Sotsiaalminister Karmen Joller nõustub, et Eesti tervishoiusüsteem on alarahastatud, kuid leiab, et probleeme ei saa lahendada lihtsalt lisaraha eraldamisega, kui samal ajal ei tehta struktuurseid reforme, näiteks ei tegeleta arstide ja õdedega, kes ei tohiks oma ametis töötada.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Sotsiaalminister Karmen Joller nõustub, et Eesti tervishoiusüsteem on alarahastatud, kuid leiab, et probleeme ei saa lahendada lihtsalt lisaraha eraldamisega, kui samal ajal ei tehta struktuurseid reforme, näiteks ei tegeleta arstide ja õdedega, kes ei tohiks oma ametis töötada.\",\"image\":{\"authorPlain\":\"Kiur Kaasik\",\"type\":\"image\",\"objectId\":\"4f3797e2-2364-5fb4-89f9-d294815acf7c\",\"width\":1600,\"height\":1066,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=4f3797e2-2364-5fb4-89f9-d294815acf7c\",\"text\":\"Minister Karmen Joller.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Minister Karmen Joller.\"},\"updated\":null,\"category\":{\"id\":\"interview\",\"slug\":\"intervjuu\",\"name\":\"Intervjuu\"},\"options\":{},\"tags\":[{\"id\":\"79d8f0c6-4a72-43bf-a19a-1612550af130\",\"type\":\"SubscriptionTag\",\"name\":\"Meditsiin\",\"slug\":\"meditsiin\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/12/miljon-muumata-hiina-elektriautot-teeb-uleilmse-autoturu-narviliseks\",\"publishStartDate\":\"2026-09-12T09:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"9479725b-aae6-469e-b78f-9194a7124be6\",\"version\":8,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Miljon müümata Hiina elektriautot teeb üleilmse autoturu närviliseks\"}]},\"headlinePlain\":\"Miljon müümata Hiina elektriautot teeb üleilmse autoturu närviliseks\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Üha rohkem Hiina elektriautosid jääb müümata ja see survestab ka teiste tootjate hindu ja kasumlikkust.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Üha rohkem Hiina elektriautosid jääb müümata ja see survestab ka teiste tootjate hindu ja kasumlikkust.\",\"image\":{\"authorPlain\":\"Imago/Scanpix\",\"type\":\"image\",\"objectId\":\"579ec135-7c80-5bda-8ed3-86332e60f5a5\",\"width\":4000,\"height\":2666,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=579ec135-7c80-5bda-8ed3-86332e60f5a5\",\"text\":\"Eksporti ootavad autod Hiinas Shanghai sadamas.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Eksporti ootavad autod Hiinas Shanghai sadamas.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"39935bd8-4af4-417e-ad40-edf036372c0d\",\"type\":\"SubscriptionTag\",\"name\":\"Autotööstus\",\"slug\":\"autotoostus\"},{\"id\":\"74693368-f846-45ab-8373-953ee7013216\",\"type\":\"SubscriptionTag\",\"name\":\"Hiina\",\"slug\":\"hiina\"},{\"id\":\"a7303673-3897-43fd-9069-075e3c9d9045\",\"type\":\"SubscriptionTag\",\"name\":\"Tesla\",\"slug\":\"tesla\"},{\"id\":\"ab80efff-2f37-445a-b8e4-b480394b36e4\",\"type\":\"SubscriptionTag\",\"name\":\"Euroopa Liit\",\"slug\":\"euroopa-liit\"},{\"id\":\"49d63c32-5711-4717-96a8-d19df435552c\",\"type\":\"SubscriptionTag\",\"name\":\"Globaalne pilk\",\"slug\":\"globaalne-pilk\"},{\"id\":\"c41de961-97e4-42f2-a4ef-4d03567dd903\",\"type\":\"SubscriptionTag\",\"name\":\"Logistika\",\"slug\":\"logistika\"},{\"id\":\"ff594c9b-ce80-43c8-815b-f39cd42aaf21\",\"type\":\"SubscriptionTag\",\"name\":\"Volkswagen\",\"slug\":\"volkswagen\"},{\"id\":\"61ed8901-6d90-4878-8985-bbc13051301b\",\"type\":\"SubscriptionTag\",\"name\":\"Kaubandussõda\",\"slug\":\"kaubandussoda\"},{\"id\":\"c7446f8d-ec68-410a-863a-4e6b46d901b4\",\"type\":\"SubscriptionTag\",\"name\":\"Transport\",\"slug\":\"transport\"},{\"id\":\"ea03b277-3b98-4590-ab26-e982817c2a0d\",\"type\":\"SubscriptionTag\",\"name\":\"Konkurents\",\"slug\":\"konkurents\"},{\"id\":\"56325102-cd07-4c6d-97e8-954a35f501ad\",\"type\":\"SubscriptionTag\",\"name\":\"Euroopa\",\"slug\":\"euroopa\"},{\"id\":\"637f56d1-9da9-4c6e-aae8-570407f706ea\",\"type\":\"SubscriptionTag\",\"name\":\"Autod\",\"slug\":\"autod\"},{\"id\":\"643a7c4d-0b04-43a7-8a98-abe0298cd382\",\"type\":\"SubscriptionTag\",\"name\":\"Dagens Industri\",\"slug\":\"dagens-industri\"}],\"marketInstruments\":[]},{\"permalink\":\"/suur-lugu/2026/09/11/luksuskleidi-parast-lennatakse-californiast-tallinna-meid-leidnud-kliendid-ei-kusi-miks-see-toode-maksab-nii-palju\",\"publishStartDate\":\"2026-09-12T08:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":true,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"9695eafe-c507-43f5-876b-5cfbdd8c40c7\",\"version\":20,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Luksuskleidi pärast lennatakse Californiast Tallinna. \\\"Meid leidnud kliendid ei küsi, miks see toode maksab nii palju\\\"\"}]},\"headlinePlain\":\"Luksuskleidi pärast lennatakse Californiast Tallinna. \\\"Meid leidnud kliendid ei küsi, miks see toode maksab nii palju\\\"\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"“Minagi arvasin, et rahvusvahelise moeäri tegemiseks tuleb New Yorki kolida. Ainult seal jõudvat inimesteni, aga kliendid võivad ka Eestisse tulla ja tulevad,” ütleb disainer Mariliis Pikkar, Marimo Fashion brändi looja.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"“Minagi arvasin, et rahvusvahelise moeäri tegemiseks tuleb New Yorki kolida. Ainult seal jõudvat inimesteni, aga kliendid võivad ka Eestisse tulla ja tulevad,” ütleb disainer Mariliis Pikkar, Marimo Fashion brändi looja.\",\"image\":{\"authorPlain\":\"Marko Mumm\",\"type\":\"image\",\"objectId\":\"b8f151fb-1952-5218-82e6-b32104cc02c9\",\"width\":5806,\"height\":3993,\"alignment\":\"fullscreen\",\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=b8f151fb-1952-5218-82e6-b32104cc02c9\",\"text\":\"“See on keeruline nišš. Mina aga kvaliteedis alla ei anna, et teha midagi odavamalt,” räägib disainer ja Marimo looja Mariliis Pikkar.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"“See on keeruline nišš. Mina aga kvaliteedis alla ei anna, et teha midagi odavamalt,” räägib disainer ja Marimo looja Mariliis Pikkar.\"},\"updated\":null,\"category\":{\"id\":\"bigstory\",\"slug\":\"suur-lugu\",\"name\":\"Suur lugu\"},\"options\":{\"embed\":true},\"tags\":[{\"id\":\"8058cfda-3696-4400-977f-1aba3a170359\",\"type\":\"SubscriptionTag\",\"name\":\"Loomemajandus\",\"slug\":\"loomemajandus\"},{\"id\":\"1bfe4e78-edf0-4c29-9159-a1c3c3e21339\",\"type\":\"SubscriptionTag\",\"name\":\"Disain\",\"slug\":\"disain\"},{\"id\":\"530e4c09-4fd0-47c9-938b-dfa5c8485b21\",\"type\":\"SubscriptionTag\",\"name\":\"Tööturg\",\"slug\":\"tooturg\"},{\"id\":\"e5774b97-41ee-4c60-b72e-59c3db021472\",\"type\":\"SubscriptionTag\",\"name\":\"Koondamine\",\"slug\":\"koondamine\"},{\"id\":\"13cb6d04-eb65-44ac-a514-daf2cb6799f5\",\"type\":\"SubscriptionTag\",\"name\":\"Keskkond\",\"slug\":\"keskkond\"},{\"id\":\"b14aaa61-809b-4cdf-b230-7f97ba95655c\",\"type\":\"SubscriptionTag\",\"name\":\"Rõivatööstus\",\"slug\":\"roivatoostus\"},{\"id\":\"ff8a0479-e3fb-4b46-be32-8b40c26b8107\",\"type\":\"SubscriptionTag\",\"name\":\"Kestlikkus\",\"slug\":\"kestlikkus\"},{\"id\":\"ffaac89b-ba94-4e6d-9af1-8b504c831d2d\",\"type\":\"SubscriptionTag\",\"name\":\"e-kaubandus\",\"slug\":\"ekaubandus\"},{\"id\":\"e295df9f-718e-428c-9fee-b0b038c54b48\",\"type\":\"SubscriptionTag\",\"name\":\"Turundus\",\"slug\":\"turundus\"},{\"id\":\"7a9652a1-0092-4884-8808-651fc40bded9\",\"type\":\"SubscriptionTag\",\"name\":\"tekstiilitööstus\",\"slug\":\"tekstiilitoostus\"},{\"id\":\"48244fae-22a5-49b3-ad9b-918c5dc1e4c4\",\"type\":\"SubscriptionTag\",\"name\":\"kasv\",\"slug\":\"kasv\"},{\"id\":\"4ed0dc7e-effa-48c9-87a1-46be7d6d2822\",\"type\":\"SubscriptionTag\",\"name\":\"Tallinn\",\"slug\":\"tallinn\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"a3f313c5-90c8-4dc4-b7ac-beb7edf172fe\",\"type\":\"SubscriptionTag\",\"name\":\"Turism\",\"slug\":\"turism\"},{\"id\":\"654b6531-a5c3-4107-b431-3ee7dbeb83b0\",\"type\":\"InfopankPerson\",\"externalId\":\"152543\",\"name\":\"Mariliis Pikkar\"},{\"id\":\"91ca9d01-2687-4297-880d-b331831f18b1\",\"type\":\"InfopankOrganisation\",\"externalId\":\"43262\",\"name\":\"MARIMO FASHION OÜ\"},{\"id\":\"3fdffbcf-1047-48ef-b38b-d9993fa3947b\",\"type\":\"InfopankOrganisation\",\"externalId\":\"99431\",\"name\":\"TALLINNA TEHNIKAÜLIKOOL AVOIG\"}],\"marketInstruments\":[]},{\"permalink\":\"/suur-lugu/2026/09/13/ma-armastan-iga-vaikest-lehekest-tallinna-elanikud-kasvatavad-korterite-ees-pooraseid-aedu\",\"publishStartDate\":\"2026-09-13T03:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":true,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"aec91f4d-0763-4534-b965-83b1db184129\",\"version\":47,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"“Ma armastan iga väikest lehekest.” Tallinna elanikud kasvatavad korterite ees pööraseid aedu \"}]},\"headlinePlain\":\"“Ma armastan iga väikest lehekest.” Tallinna elanikud kasvatavad korterite ees pööraseid aedu\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"“Ma ei taha, et tänav oleks vaid see koht, mida mööda lähen parki. Ma tahan, et kui ma juba uksest välja tulen, oleks ümberringi roheline,“ ütleb Kaire Sõmer. Kuigi ta elab kortermajas, peab ta ilusat aeda.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"“Ma ei taha, et tänav oleks vaid see koht, mida mööda lähen parki. Ma tahan, et kui ma juba uksest välja tulen, oleks ümberringi roheline,“ ütleb Kaire Sõmer. Kuigi ta elab kortermajas, peab ta ilusat aeda.\",\"image\":{\"authorPlain\":\"Liis Treimann\",\"type\":\"image\",\"objectId\":\"5295fb2d-a1cb-5991-9d8e-9b11682b5567\",\"width\":6000,\"height\":4000,\"alignment\":\"fullscreen\",\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=5295fb2d-a1cb-5991-9d8e-9b11682b5567\",\"text\":\"Larissa sai sel aastal 80aastaseks, ta hoolitseb oma maja ees olevate peenarde eest juba 30 aastat.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Larissa sai sel aastal 80aastaseks, ta hoolitseb oma maja ees olevate peenarde eest juba 30 aastat.\"},\"updated\":null,\"category\":{\"id\":\"bigstory\",\"slug\":\"suur-lugu\",\"name\":\"Suur lugu\"},\"options\":{\"gallery\":true},\"tags\":[{\"id\":\"4ed0dc7e-effa-48c9-87a1-46be7d6d2822\",\"type\":\"SubscriptionTag\",\"name\":\"Tallinn\",\"slug\":\"tallinn\"},{\"id\":\"380c73bb-e9ec-4f0b-9e04-5a741e177537\",\"type\":\"SubscriptionTag\",\"name\":\"Kohalik elu\",\"slug\":\"kohalik-elu\"},{\"id\":\"35ec3b3d-c537-4473-8518-4d07ba320126\",\"type\":\"SubscriptionTag\",\"name\":\"Loodus\",\"slug\":\"loodus\"},{\"id\":\"191f4e59-b1cd-4b4e-88ba-9c2420fcd33b\",\"type\":\"SubscriptionTag\",\"name\":\"Linnaruum\",\"slug\":\"linnaruum\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/11/nadala-lood-150-000-eurone-laud-trumpi-poja-ohtusoogile-ja-kaos-luksusklubis\",\"publishStartDate\":\"2026-09-12T11:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"a88b9e8b-00a3-4416-bbd2-9557d5ad0c5b\",\"version\":8,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Nädala lood: 150 000-eurone laud Trumpi poja õhtusöögile ja kaos luksusklubis\"}]},\"headlinePlain\":\"Nädala lood: 150 000-eurone laud Trumpi poja õhtusöögile ja kaos luksusklubis\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Lõppeval nädalal tõusid Äripäeva lugudest enim esile lood luksusklubi töötajatest, Trumpi poja õhtusöögi ühe koha maksumusest ning kuidas tuntud poliitiku juhitud ühistu võib langeda pankrotti \"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Lõppeval nädalal tõusid Äripäeva lugudest enim esile lood luksusklubi töötajatest, Trumpi poja õhtusöögi ühe koha maksumusest ning kuidas tuntud poliitiku juhitud ühistu võib langeda pankrotti\",\"image\":{\"authorPlain\":\"AP/Scanpix\",\"type\":\"image\",\"objectId\":\"f86c0c1b-2f5d-53aa-a5fe-5315866dcc90\",\"width\":4885,\"height\":3257,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=f86c0c1b-2f5d-53aa-a5fe-5315866dcc90\",\"text\":\"Donald Trump Jr.-ga Eestis peetud eksklusiivse õhtusöögi ühe koha hinnaks pakuti kutse järgi kuni 150 000 eurot.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Donald Trump Jr.-ga Eestis peetud eksklusiivse õhtusöögi ühe koha hinnaks pakuti kutse järgi kuni 150 000 eurot.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"ac76baaf-1772-4db4-8c93-212903357b43\",\"type\":\"SubscriptionTag\",\"name\":\"Raha\",\"slug\":\"raha\"},{\"id\":\"bb04ab71-b0e1-487d-8287-5b74492c2187\",\"type\":\"SubscriptionTag\",\"name\":\"Kohus\",\"slug\":\"kohus\"},{\"id\":\"7e61226f-5616-476e-bcf2-246e38973765\",\"type\":\"SubscriptionTag\",\"name\":\"Pankrot\",\"slug\":\"pankrot\"},{\"id\":\"12059e51-cbd0-4eea-ba13-1040761a336b\",\"type\":\"SubscriptionTag\",\"name\":\"Donald Trump\",\"slug\":\"donald-trump\"},{\"id\":\"03a7c01c-4654-4369-8b7e-460710169b0e\",\"type\":\"SubscriptionTag\",\"name\":\"HoReCa\",\"slug\":\"horeca\"},{\"id\":\"939832c8-95c9-453a-9ed8-bca537923bb4\",\"type\":\"SubscriptionTag\",\"name\":\"Meedia ja reklaam\",\"slug\":\"meedia-ja-reklaam\"},{\"id\":\"b3ed1ad1-caa8-4059-a95a-ba7b2f2814aa\",\"type\":\"SubscriptionTag\",\"name\":\"Farmaatsia\",\"slug\":\"farmaatsia\"},{\"id\":\"2c26be27-e4d9-4ce7-8f80-ad1829f9d517\",\"type\":\"SubscriptionTag\",\"name\":\"Geopoliitika\",\"slug\":\"geopoliitika\"},{\"id\":\"f0a1f548-d393-4ba1-9001-aa9119881586\",\"type\":\"SubscriptionTag\",\"name\":\"auditeerimine\",\"slug\":\"auditeerimine\"},{\"id\":\"1043cdd5-cfb8-4402-843e-a48929252653\",\"type\":\"SubscriptionTag\",\"name\":\"USA\",\"slug\":\"usa\"}],\"marketInstruments\":[]}]},{\"timeframe\":\"last-3-days\",\"data\":[{\"permalink\":\"/uudised/2026/09/11/eesti-uus-limonaad-aratab-valismaal-huvi-see-on-poorane-kui-palju-on-meid-kusitud\",\"publishStartDate\":\"2026-09-13T06:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"e2650585-e4b6-4a24-898f-09d913a8ac32\",\"version\":22,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\"}]},\"headlinePlain\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane. \"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane.\",\"image\":{\"authorPlain\":\"Erakogu\",\"type\":\"image\",\"objectId\":\"0f779d87-ea86-5842-89ed-d3c31a694afc\",\"width\":6905,\"height\":4536,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=0f779d87-ea86-5842-89ed-d3c31a694afc\",\"text\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"84679d1a-80a6-4e51-af32-97dd908053e1\",\"type\":\"SubscriptionTag\",\"name\":\"Joogitööstus\",\"slug\":\"joogitoostus\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"47f75744-a8ac-45b7-9468-74cec207a09f\",\"type\":\"SubscriptionTag\",\"name\":\"Juhtimine\",\"slug\":\"juhtimine\"},{\"id\":\"f26c6715-f81e-4fe2-8d59-7c4ade6f8055\",\"type\":\"SubscriptionTag\",\"name\":\"Eksport\",\"slug\":\"eksport\"},{\"id\":\"b2f0fa43-48fc-4795-9444-1f58776fefb2\",\"type\":\"InfopankOrganisation\",\"externalId\":\"437470\",\"name\":\"FILLY CO OÜ\"},{\"id\":\"2733cb15-581e-41d2-9d8b-9dc656a95465\",\"type\":\"InfopankOrganisation\",\"externalId\":\"18341\",\"name\":\"GKR TRADE OÜ\"},{\"id\":\"76eddd2d-57ce-427e-a302-42ec44362d43\",\"type\":\"InfopankPerson\",\"externalId\":\"160735\",\"name\":\"Gert-Kristjan Rungi\"},{\"id\":\"3ae46e39-60dc-41a0-8a0e-0d5586d8f616\",\"type\":\"InfopankPerson\",\"externalId\":\"589711\",\"name\":\"Keili Sükijainen\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/11/kindral-heremi-naasmine-voimukoridori-toi-esimese-ohvri-kas-ta-demokraatia-jaoks-hea-on-kahtlen\",\"publishStartDate\":\"2026-09-12T03:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"5526b7f7-dd97-486a-948a-99c1119d0d2a\",\"version\":31,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\"}]},\"headlinePlain\":\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"2024. aastal pühkis kindral Martin Herem käed kaitseväe juhataja raskest tööst puhtaks, pani ukse enda järel kinni ja lahkus vaba mehena. Nüüd naaseb ta pauguga sinnasamma ministeeriumisse, mille aeglust omal ajal siunas, et ise ministrina teisiti teha.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"2024. aastal pühkis kindral Martin Herem käed kaitseväe juhataja raskest tööst puhtaks, pani ukse enda järel kinni ja lahkus vaba mehena. Nüüd naaseb ta pauguga sinnasamma ministeeriumisse, mille aeglust omal ajal siunas, et ise ministrina teisiti teha.\",\"image\":{\"authorPlain\":\"Kiur Kaasik/Delfi Meedia/Scanpix\",\"type\":\"image\",\"objectId\":\"98cf779f-ddbb-5eae-b3a2-1374044c0a7b\",\"width\":5298,\"height\":3311,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=98cf779f-ddbb-5eae-b3a2-1374044c0a7b\",\"text\":\"Pärast Hanno Pevkuri kahimist tuli peaminister Kristen Michalil Martin Heremi (pildil) avangus ohverdada ka kaitseministeeriumi kantsler Kaimo Kuusk.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Pärast Hanno Pevkuri kahimist tuli peaminister Kristen Michalil Martin Heremi (pildil) avangus ohverdada ka kaitseministeeriumi kantsler Kaimo Kuusk.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"393e6028-0bbb-46ff-8715-658c389d3085\",\"type\":\"SubscriptionTag\",\"name\":\"Poliitika\",\"slug\":\"poliitika\"},{\"id\":\"70ea6cf6-fdb5-47c0-9a77-e6cfd5f9ed21\",\"type\":\"SubscriptionTag\",\"name\":\"Riigikogu\",\"slug\":\"riigikogu\"},{\"id\":\"4f51101e-857b-45a0-bab6-99de7e1f1ac5\",\"type\":\"SubscriptionTag\",\"name\":\"Julgeolek\",\"slug\":\"julgeolek\"},{\"id\":\"42037e87-3aec-4e75-b37c-a4f0e6a8dfdd\",\"type\":\"SubscriptionTag\",\"name\":\"Kaitsetööstus\",\"slug\":\"kaitsetoostus\"},{\"id\":\"100e51bf-9bb4-48ba-a295-81b5685b73e7\",\"type\":\"SubscriptionTag\",\"name\":\"Valitsus\",\"slug\":\"valitsus\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/11/tuntud-poliitikust-arimees-laks-pankrotti\",\"publishStartDate\":\"2026-09-11T13:16:02.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"19fb134e-6a8e-4ea0-a9bf-84365e4291c0\",\"version\":3,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Tuntud poliitikust ärimees läks pankrotti\"}]},\"headlinePlain\":\"Tuntud poliitikust ärimees läks pankrotti\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Kohus kuulutas välja kunagise Tallinna linnapea, Isamaa poliitikust ärimehe Tõnis Paltsi pankroti.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Kohus kuulutas välja kunagise Tallinna linnapea, Isamaa poliitikust ärimehe Tõnis Paltsi pankroti.\",\"image\":{\"authorPlain\":\"Liis Treimann\",\"type\":\"image\",\"objectId\":\"0cc9e743-7a6b-5b6d-ae0a-5211a80cc3a6\",\"width\":4990,\"height\":3311,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=0cc9e743-7a6b-5b6d-ae0a-5211a80cc3a6\",\"text\":\"Tõnis Palts oli mõni aasta tagasi Levikomi saneerimisavaldusega kohtus, kuid telekomifirma läks hiljuti pankrotti. Nüüd kuulutas kohus välja ka Paltsi pankroti.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Tõnis Palts oli mõni aasta tagasi Levikomi saneerimisavaldusega kohtus, kuid telekomifirma läks hiljuti pankrotti. Nüüd kuulutas kohus välja ka Paltsi pankroti.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"bb04ab71-b0e1-487d-8287-5b74492c2187\",\"type\":\"SubscriptionTag\",\"name\":\"Kohus\",\"slug\":\"kohus\"},{\"id\":\"7e61226f-5616-476e-bcf2-246e38973765\",\"type\":\"SubscriptionTag\",\"name\":\"Pankrot\",\"slug\":\"pankrot\"},{\"id\":\"393e6028-0bbb-46ff-8715-658c389d3085\",\"type\":\"SubscriptionTag\",\"name\":\"Poliitika\",\"slug\":\"poliitika\"},{\"id\":\"63e8c116-0680-4195-9d4e-602d221b008c\",\"type\":\"SubscriptionTag\",\"name\":\"Ukraina\",\"slug\":\"ukraina\"},{\"id\":\"2f672cd6-36ca-46b4-9e2c-4a6a2df9c89b\",\"type\":\"SubscriptionTag\",\"name\":\"telekom\",\"slug\":\"telekom\"},{\"id\":\"bb3c7cf6-0b35-4242-84a1-b79607d6f65a\",\"type\":\"InfopankPerson\",\"externalId\":\"45147\",\"name\":\"Tõnis Palts\"},{\"id\":\"bea746b7-5c0f-4115-8cad-aa2aaf6dd1cf\",\"type\":\"InfopankPerson\",\"externalId\":\"128915\",\"name\":\"Andrias Palmits\"},{\"id\":\"067b4dda-d1b1-471f-a540-97a6ed43ac40\",\"type\":\"InfopankPerson\",\"externalId\":\"3372\",\"name\":\"Parvel Pruunsild\"},{\"id\":\"d731f074-b12d-48ab-830f-52db97161be7\",\"type\":\"InfopankOrganisation\",\"externalId\":\"142226\",\"name\":\"LEVIKOM EESTI OÜ\"},{\"id\":\"534fac8e-4b6c-491d-8530-67820ed265fe\",\"type\":\"InfopankOrganisation\",\"externalId\":\"166079\",\"name\":\"VARALAEN AS\"},{\"id\":\"a1692fa8-43fe-44dd-bf5b-b76c3d69f215\",\"type\":\"InfopankOrganisation\",\"externalId\":\"57232\",\"name\":\"PAMBOS HOLDINGS OÜ\"},{\"id\":\"d6677b7d-7d79-4740-8f1d-c7bf8d736cff\",\"type\":\"InfopankOrganisation\",\"externalId\":\"205713\",\"name\":\"ISAMAA ERAKOND MTÜ\"}],\"marketInstruments\":[]},{\"permalink\":\"/suur-lugu/2026/09/11/luksuskleidi-parast-lennatakse-californiast-tallinna-meid-leidnud-kliendid-ei-kusi-miks-see-toode-maksab-nii-palju\",\"publishStartDate\":\"2026-09-12T08:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":true,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"9695eafe-c507-43f5-876b-5cfbdd8c40c7\",\"version\":20,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Luksuskleidi pärast lennatakse Californiast Tallinna. \\\"Meid leidnud kliendid ei küsi, miks see toode maksab nii palju\\\"\"}]},\"headlinePlain\":\"Luksuskleidi pärast lennatakse Californiast Tallinna. \\\"Meid leidnud kliendid ei küsi, miks see toode maksab nii palju\\\"\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"“Minagi arvasin, et rahvusvahelise moeäri tegemiseks tuleb New Yorki kolida. Ainult seal jõudvat inimesteni, aga kliendid võivad ka Eestisse tulla ja tulevad,” ütleb disainer Mariliis Pikkar, Marimo Fashion brändi looja.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"“Minagi arvasin, et rahvusvahelise moeäri tegemiseks tuleb New Yorki kolida. Ainult seal jõudvat inimesteni, aga kliendid võivad ka Eestisse tulla ja tulevad,” ütleb disainer Mariliis Pikkar, Marimo Fashion brändi looja.\",\"image\":{\"authorPlain\":\"Marko Mumm\",\"type\":\"image\",\"objectId\":\"b8f151fb-1952-5218-82e6-b32104cc02c9\",\"width\":5806,\"height\":3993,\"alignment\":\"fullscreen\",\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=b8f151fb-1952-5218-82e6-b32104cc02c9\",\"text\":\"“See on keeruline nišš. Mina aga kvaliteedis alla ei anna, et teha midagi odavamalt,” räägib disainer ja Marimo looja Mariliis Pikkar.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"“See on keeruline nišš. Mina aga kvaliteedis alla ei anna, et teha midagi odavamalt,” räägib disainer ja Marimo looja Mariliis Pikkar.\"},\"updated\":null,\"category\":{\"id\":\"bigstory\",\"slug\":\"suur-lugu\",\"name\":\"Suur lugu\"},\"options\":{\"embed\":true},\"tags\":[{\"id\":\"8058cfda-3696-4400-977f-1aba3a170359\",\"type\":\"SubscriptionTag\",\"name\":\"Loomemajandus\",\"slug\":\"loomemajandus\"},{\"id\":\"1bfe4e78-edf0-4c29-9159-a1c3c3e21339\",\"type\":\"SubscriptionTag\",\"name\":\"Disain\",\"slug\":\"disain\"},{\"id\":\"530e4c09-4fd0-47c9-938b-dfa5c8485b21\",\"type\":\"SubscriptionTag\",\"name\":\"Tööturg\",\"slug\":\"tooturg\"},{\"id\":\"e5774b97-41ee-4c60-b72e-59c3db021472\",\"type\":\"SubscriptionTag\",\"name\":\"Koondamine\",\"slug\":\"koondamine\"},{\"id\":\"13cb6d04-eb65-44ac-a514-daf2cb6799f5\",\"type\":\"SubscriptionTag\",\"name\":\"Keskkond\",\"slug\":\"keskkond\"},{\"id\":\"b14aaa61-809b-4cdf-b230-7f97ba95655c\",\"type\":\"SubscriptionTag\",\"name\":\"Rõivatööstus\",\"slug\":\"roivatoostus\"},{\"id\":\"ff8a0479-e3fb-4b46-be32-8b40c26b8107\",\"type\":\"SubscriptionTag\",\"name\":\"Kestlikkus\",\"slug\":\"kestlikkus\"},{\"id\":\"ffaac89b-ba94-4e6d-9af1-8b504c831d2d\",\"type\":\"SubscriptionTag\",\"name\":\"e-kaubandus\",\"slug\":\"ekaubandus\"},{\"id\":\"e295df9f-718e-428c-9fee-b0b038c54b48\",\"type\":\"SubscriptionTag\",\"name\":\"Turundus\",\"slug\":\"turundus\"},{\"id\":\"7a9652a1-0092-4884-8808-651fc40bded9\",\"type\":\"SubscriptionTag\",\"name\":\"tekstiilitööstus\",\"slug\":\"tekstiilitoostus\"},{\"id\":\"48244fae-22a5-49b3-ad9b-918c5dc1e4c4\",\"type\":\"SubscriptionTag\",\"name\":\"kasv\",\"slug\":\"kasv\"},{\"id\":\"4ed0dc7e-effa-48c9-87a1-46be7d6d2822\",\"type\":\"SubscriptionTag\",\"name\":\"Tallinn\",\"slug\":\"tallinn\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"a3f313c5-90c8-4dc4-b7ac-beb7edf172fe\",\"type\":\"SubscriptionTag\",\"name\":\"Turism\",\"slug\":\"turism\"},{\"id\":\"654b6531-a5c3-4107-b431-3ee7dbeb83b0\",\"type\":\"InfopankPerson\",\"externalId\":\"152543\",\"name\":\"Mariliis Pikkar\"},{\"id\":\"91ca9d01-2687-4297-880d-b331831f18b1\",\"type\":\"InfopankOrganisation\",\"externalId\":\"43262\",\"name\":\"MARIMO FASHION OÜ\"},{\"id\":\"3fdffbcf-1047-48ef-b38b-d9993fa3947b\",\"type\":\"InfopankOrganisation\",\"externalId\":\"99431\",\"name\":\"TALLINNA TEHNIKAÜLIKOOL AVOIG\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/12/miljon-muumata-hiina-elektriautot-teeb-uleilmse-autoturu-narviliseks\",\"publishStartDate\":\"2026-09-12T09:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"9479725b-aae6-469e-b78f-9194a7124be6\",\"version\":8,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Miljon müümata Hiina elektriautot teeb üleilmse autoturu närviliseks\"}]},\"headlinePlain\":\"Miljon müümata Hiina elektriautot teeb üleilmse autoturu närviliseks\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Üha rohkem Hiina elektriautosid jääb müümata ja see survestab ka teiste tootjate hindu ja kasumlikkust.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Üha rohkem Hiina elektriautosid jääb müümata ja see survestab ka teiste tootjate hindu ja kasumlikkust.\",\"image\":{\"authorPlain\":\"Imago/Scanpix\",\"type\":\"image\",\"objectId\":\"579ec135-7c80-5bda-8ed3-86332e60f5a5\",\"width\":4000,\"height\":2666,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=579ec135-7c80-5bda-8ed3-86332e60f5a5\",\"text\":\"Eksporti ootavad autod Hiinas Shanghai sadamas.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Eksporti ootavad autod Hiinas Shanghai sadamas.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"39935bd8-4af4-417e-ad40-edf036372c0d\",\"type\":\"SubscriptionTag\",\"name\":\"Autotööstus\",\"slug\":\"autotoostus\"},{\"id\":\"74693368-f846-45ab-8373-953ee7013216\",\"type\":\"SubscriptionTag\",\"name\":\"Hiina\",\"slug\":\"hiina\"},{\"id\":\"a7303673-3897-43fd-9069-075e3c9d9045\",\"type\":\"SubscriptionTag\",\"name\":\"Tesla\",\"slug\":\"tesla\"},{\"id\":\"ab80efff-2f37-445a-b8e4-b480394b36e4\",\"type\":\"SubscriptionTag\",\"name\":\"Euroopa Liit\",\"slug\":\"euroopa-liit\"},{\"id\":\"49d63c32-5711-4717-96a8-d19df435552c\",\"type\":\"SubscriptionTag\",\"name\":\"Globaalne pilk\",\"slug\":\"globaalne-pilk\"},{\"id\":\"c41de961-97e4-42f2-a4ef-4d03567dd903\",\"type\":\"SubscriptionTag\",\"name\":\"Logistika\",\"slug\":\"logistika\"},{\"id\":\"ff594c9b-ce80-43c8-815b-f39cd42aaf21\",\"type\":\"SubscriptionTag\",\"name\":\"Volkswagen\",\"slug\":\"volkswagen\"},{\"id\":\"61ed8901-6d90-4878-8985-bbc13051301b\",\"type\":\"SubscriptionTag\",\"name\":\"Kaubandussõda\",\"slug\":\"kaubandussoda\"},{\"id\":\"c7446f8d-ec68-410a-863a-4e6b46d901b4\",\"type\":\"SubscriptionTag\",\"name\":\"Transport\",\"slug\":\"transport\"},{\"id\":\"ea03b277-3b98-4590-ab26-e982817c2a0d\",\"type\":\"SubscriptionTag\",\"name\":\"Konkurents\",\"slug\":\"konkurents\"},{\"id\":\"56325102-cd07-4c6d-97e8-954a35f501ad\",\"type\":\"SubscriptionTag\",\"name\":\"Euroopa\",\"slug\":\"euroopa\"},{\"id\":\"637f56d1-9da9-4c6e-aae8-570407f706ea\",\"type\":\"SubscriptionTag\",\"name\":\"Autod\",\"slug\":\"autod\"},{\"id\":\"643a7c4d-0b04-43a7-8a98-abe0298cd382\",\"type\":\"SubscriptionTag\",\"name\":\"Dagens Industri\",\"slug\":\"dagens-industri\"}],\"marketInstruments\":[]},{\"permalink\":\"/intervjuu/2026/08/31/karmen-joller-eestis-on-arste-ja-odesid-kes-tegelikult-ei-tohiks-tootada\",\"publishStartDate\":\"2026-09-13T07:30:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"ac711a9f-b68b-4b8e-b6fb-a07f8bba711f\",\"version\":26,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Karmen Joller: Eestis on arste ja õdesid, kes tegelikult ei tohiks töötada\"}]},\"headlinePlain\":\"Karmen Joller: Eestis on arste ja õdesid, kes tegelikult ei tohiks töötada\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Sotsiaalminister Karmen Joller nõustub, et Eesti tervishoiusüsteem on alarahastatud, kuid leiab, et probleeme ei saa lahendada lihtsalt lisaraha eraldamisega, kui samal ajal ei tehta struktuurseid reforme, näiteks ei tegeleta arstide ja õdedega, kes ei tohiks oma ametis töötada.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Sotsiaalminister Karmen Joller nõustub, et Eesti tervishoiusüsteem on alarahastatud, kuid leiab, et probleeme ei saa lahendada lihtsalt lisaraha eraldamisega, kui samal ajal ei tehta struktuurseid reforme, näiteks ei tegeleta arstide ja õdedega, kes ei tohiks oma ametis töötada.\",\"image\":{\"authorPlain\":\"Kiur Kaasik\",\"type\":\"image\",\"objectId\":\"4f3797e2-2364-5fb4-89f9-d294815acf7c\",\"width\":1600,\"height\":1066,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=4f3797e2-2364-5fb4-89f9-d294815acf7c\",\"text\":\"Minister Karmen Joller.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Minister Karmen Joller.\"},\"updated\":null,\"category\":{\"id\":\"interview\",\"slug\":\"intervjuu\",\"name\":\"Intervjuu\"},\"options\":{},\"tags\":[{\"id\":\"79d8f0c6-4a72-43bf-a19a-1612550af130\",\"type\":\"SubscriptionTag\",\"name\":\"Meditsiin\",\"slug\":\"meditsiin\"}],\"marketInstruments\":[]}]},{\"timeframe\":\"last-week\",\"data\":[{\"permalink\":\"/uudised/2026/09/11/eesti-uus-limonaad-aratab-valismaal-huvi-see-on-poorane-kui-palju-on-meid-kusitud\",\"publishStartDate\":\"2026-09-13T06:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"e2650585-e4b6-4a24-898f-09d913a8ac32\",\"version\":22,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\"}]},\"headlinePlain\":\"Eesti uus limonaad äratab välismaal huvi. “See on pöörane, kui palju on meid küsitud”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane. \"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Suvega üle poole miljoni purgi limonaadi müünud Filly on silma paistnud ka Eestist kaugemal. Kuigi uus jook oli algselt mõeldud vaid koduturule, peavad joogiäri asutajad vaikselt laienemise plaane.\",\"image\":{\"authorPlain\":\"Erakogu\",\"type\":\"image\",\"objectId\":\"0f779d87-ea86-5842-89ed-d3c31a694afc\",\"width\":6905,\"height\":4536,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=0f779d87-ea86-5842-89ed-d3c31a694afc\",\"text\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Fillyl endal tehast ei ole, limonaadid valmivad Lääne-Virumaal perefirma Vinkymoni juures. Fotol Filly omanikud Eva Kaarin Rungi, Keili Sükijainen ja Gert-Kristjan Rungi.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"84679d1a-80a6-4e51-af32-97dd908053e1\",\"type\":\"SubscriptionTag\",\"name\":\"Joogitööstus\",\"slug\":\"joogitoostus\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"47f75744-a8ac-45b7-9468-74cec207a09f\",\"type\":\"SubscriptionTag\",\"name\":\"Juhtimine\",\"slug\":\"juhtimine\"},{\"id\":\"f26c6715-f81e-4fe2-8d59-7c4ade6f8055\",\"type\":\"SubscriptionTag\",\"name\":\"Eksport\",\"slug\":\"eksport\"},{\"id\":\"b2f0fa43-48fc-4795-9444-1f58776fefb2\",\"type\":\"InfopankOrganisation\",\"externalId\":\"437470\",\"name\":\"FILLY CO OÜ\"},{\"id\":\"2733cb15-581e-41d2-9d8b-9dc656a95465\",\"type\":\"InfopankOrganisation\",\"externalId\":\"18341\",\"name\":\"GKR TRADE OÜ\"},{\"id\":\"76eddd2d-57ce-427e-a302-42ec44362d43\",\"type\":\"InfopankPerson\",\"externalId\":\"160735\",\"name\":\"Gert-Kristjan Rungi\"},{\"id\":\"3ae46e39-60dc-41a0-8a0e-0d5586d8f616\",\"type\":\"InfopankPerson\",\"externalId\":\"589711\",\"name\":\"Keili Sükijainen\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/08/tuntud-poliitiku-juhitud-uhistu-vajub-pohja-volausaldajad-vihjavad-kantimisele\",\"publishStartDate\":\"2026-09-08T03:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"e6b341d1-636b-4470-bb4b-c790e5f212a7\",\"version\":67,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Tuntud poliitiku juhitud ühistu vajub põhja, võlausaldajad vihjavad kantimisele\"}]},\"headlinePlain\":\"Tuntud poliitiku juhitud ühistu vajub põhja, võlausaldajad vihjavad kantimisele\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Hoiu-laenuühistu Kodumaa Kapitali vara liikus enne pankrotiasja värskelt püsti pandud firma kätte, võlausaldajad kahtlustavad pahatahtlikkust.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Hoiu-laenuühistu Kodumaa Kapitali vara liikus enne pankrotiasja värskelt püsti pandud firma kätte, võlausaldajad kahtlustavad pahatahtlikkust.\",\"image\":{\"authorPlain\":\"Eero Vabamägi/Postimees/Scanpix\",\"type\":\"image\",\"objectId\":\"29086398-30f8-5052-abf7-e227acaaf215\",\"width\":3000,\"height\":2000,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=29086398-30f8-5052-abf7-e227acaaf215\",\"text\":\"Kodumaa Kapitali HLÜ-d aastaid juhtinud poliitik Tõnis Kõiv taandus juhatusest enne krahhi, kuid tegutseb siiani taustal.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Kodumaa Kapitali HLÜ-d aastaid juhtinud poliitik Tõnis Kõiv taandus juhatusest enne krahhi, kuid tegutseb siiani taustal.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"bb04ab71-b0e1-487d-8287-5b74492c2187\",\"type\":\"SubscriptionTag\",\"name\":\"Kohus\",\"slug\":\"kohus\"},{\"id\":\"7e61226f-5616-476e-bcf2-246e38973765\",\"type\":\"SubscriptionTag\",\"name\":\"Pankrot\",\"slug\":\"pankrot\"},{\"id\":\"b501b23a-589b-43ba-ba6d-f4c6f81ef3a8\",\"type\":\"InfopankOrganisation\",\"externalId\":\"105476\",\"name\":\"KODUMAA KAPITALI HLÜ TÜH\"},{\"id\":\"b210e78e-a832-4fdf-96f4-efd51f39c58a\",\"type\":\"InfopankPerson\",\"externalId\":\"940141\",\"name\":\"Tõnis Kõiv\"},{\"id\":\"9d2ae501-5583-4392-b32a-fef3d2551f67\",\"type\":\"InfopankOrganisation\",\"externalId\":\"617618\",\"name\":\"KODUMAA VALDUS OÜ\"},{\"id\":\"fc242253-b927-47d2-a8dc-ce03a953c5c0\",\"type\":\"InfopankOrganisation\",\"externalId\":\"322583\",\"name\":\"KODUMAA LAENUD OÜ\"},{\"id\":\"9366e33c-de7a-4077-bd8d-b77156f9c1df\",\"type\":\"InfopankOrganisation\",\"externalId\":\"618975\",\"name\":\"USALDUSFOND KODUMAA FOND UÜ\"},{\"id\":\"ba95a551-2a46-4cb2-a659-079fea522183\",\"type\":\"InfopankPerson\",\"externalId\":\"34310\",\"name\":\"Ervin Nurmela\"},{\"id\":\"a8562c84-8cd8-4eb3-b9bd-d6c6fe001210\",\"type\":\"InfopankPerson\",\"externalId\":\"1016175\",\"name\":\"Toomas Saarna\"},{\"id\":\"effdc989-e832-4b30-a015-ee5f6f211da6\",\"type\":\"InfopankPerson\",\"externalId\":\"71635\",\"name\":\"Maria Mägi-Rohtmets\"},{\"id\":\"96e01557-da97-40db-9c4b-fd3c3ba52e5a\",\"type\":\"InfopankPerson\",\"externalId\":\"63970\",\"name\":\"Kiur Lootus\"},{\"id\":\"0dc95e1d-047c-4f01-8e91-6508b00a3738\",\"type\":\"InfopankPerson\",\"externalId\":\"31710\",\"name\":\"Mirjam-Mari Marastu\"},{\"id\":\"a7517f22-96c5-441f-b3ee-d00c4ce6eb1b\",\"type\":\"SubscriptionTag\",\"name\":\"Likvideerimine\",\"slug\":\"likvideerimine\"},{\"id\":\"5bd47787-9925-4c06-bff0-6e2f6dfb6e4e\",\"type\":\"SubscriptionTag\",\"name\":\"Seadused\",\"slug\":\"seadused\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/07/luksusklubi-tootajad-kogesid-ebaoiglust-ja-kaost-ma-ei-soovi-end-too-parast-maha-matta\",\"publishStartDate\":\"2026-09-07T03:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":true,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"f9e7a8cd-bc6b-44a9-a592-962073b1412c\",\"version\":36,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Luksusklubi töötajad kogesid ebaõiglust ja kaost. “Ma ei soovi end töö pärast maha matta”\"}]},\"headlinePlain\":\"Luksusklubi töötajad kogesid ebaõiglust ja kaost. “Ma ei soovi end töö pärast maha matta”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Kõrge palga ja ahvatlevate boonustega klubisse Bombay tööle värvatud inimestele avanes luksusliku meelelahutusasutuse kulisside taga hoopis teistsugune maailm.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Kõrge palga ja ahvatlevate boonustega klubisse Bombay tööle värvatud inimestele avanes luksusliku meelelahutusasutuse kulisside taga hoopis teistsugune maailm.\",\"image\":{\"authorPlain\":\"Johannes Idasaar/Delfi Meedia/Scanpix\",\"type\":\"image\",\"objectId\":\"83e81e73-6193-5b26-a29d-000af9a32b5e\",\"width\":2048,\"height\":1365,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=83e81e73-6193-5b26-a29d-000af9a32b5e\",\"text\":\"Osa baaripersonali tööst seisnes Bombays toimuvate ürituste teenindamises – näiteks pokkeriturniiridel või luksuslikel pidudel.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Osa baaripersonali tööst seisnes Bombays toimuvate ürituste teenindamises – näiteks pokkeriturniiridel või luksuslikel pidudel.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{\"gallery\":true},\"tags\":[{\"id\":\"6bd5bf36-94a2-426e-872a-048a8beac0a4\",\"type\":\"InfopankOrganisation\",\"externalId\":\"467744\",\"name\":\"BOMBAY GROUP OÜ\"},{\"id\":\"ce35954c-82e7-4f73-a455-284020179f40\",\"type\":\"InfopankOrganisation\",\"externalId\":\"283520\",\"name\":\"BOMBAY CLUB AND RESORT OÜ\"},{\"id\":\"817f303b-99d4-449f-96fa-cdafe5f6b6fb\",\"type\":\"InfopankOrganisation\",\"externalId\":\"471632\",\"name\":\"BURMAN HOTEL OÜ\"},{\"id\":\"a3a98ef4-9a8d-4926-b1fb-9f1d33b96854\",\"type\":\"InfopankOrganisation\",\"externalId\":\"246815\",\"name\":\"TÖÖINSPEKTSIOON TRAS\"},{\"id\":\"7f13413c-3695-4676-9e2b-3225abf62861\",\"type\":\"SubscriptionTag\",\"name\":\"Tööandja\",\"slug\":\"tooandja\"},{\"id\":\"5a88d011-8b2a-4230-8523-602fbea92ed3\",\"type\":\"SubscriptionTag\",\"name\":\"Tööjõud\",\"slug\":\"toojoud\"},{\"id\":\"58a96625-89bd-497d-b8fb-f6619ac1b607\",\"type\":\"SubscriptionTag\",\"name\":\"töökeskkond\",\"slug\":\"tookeskkond\"},{\"id\":\"b0387573-68b9-4885-be23-e16e3b089427\",\"type\":\"SubscriptionTag\",\"name\":\"Töökiusamine\",\"slug\":\"tookiusamine\"},{\"id\":\"03a7c01c-4654-4369-8b7e-460710169b0e\",\"type\":\"SubscriptionTag\",\"name\":\"HoReCa\",\"slug\":\"horeca\"},{\"id\":\"e8c7b37f-8ab1-4c24-a66a-e9a5abc072f5\",\"type\":\"SubscriptionTag\",\"name\":\"Meelelahutus\",\"slug\":\"meelelahutus\"},{\"id\":\"307134ec-d9f1-4746-9c6b-7215540573c7\",\"type\":\"InfopankPerson\",\"externalId\":\"25287\",\"name\":\"Dajana Tiitsaar\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/02/pensioniiga-touseb-kuid-sund-uksi-inimesi-tool-ei-hoia-vanemaealised-tahavad-luhemat-tooaega\",\"publishStartDate\":\"2026-09-06T12:43:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"648a3ecc-e1c0-4277-b374-43472f6d9ee9\",\"version\":11,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Pensioniiga tõuseb, kuid sund üksi inimesi tööl ei hoia: vanemaealised tahavad lühemat tööaega\"}]},\"headlinePlain\":\"Pensioniiga tõuseb, kuid sund üksi inimesi tööl ei hoia: vanemaealised tahavad lühemat tööaega\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Eestis tõuseb vanaduspensioniiga 2029. aastal 65 aasta ja nelja kuuni. Taani värske uuring näitab aga, et üksnes pensioniea nihutamisest ei pruugi inimeste kauem tööl hoidmiseks piisata: vanemaealised ootavad tööandjalt eelkõige lühemat tööaega, rohkem puhkust ja paindlikku töökorraldust. \"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Eestis tõuseb vanaduspensioniiga 2029. aastal 65 aasta ja nelja kuuni. Taani värske uuring näitab aga, et üksnes pensioniea nihutamisest ei pruugi inimeste kauem tööl hoidmiseks piisata: vanemaealised ootavad tööandjalt eelkõige lühemat tööaega, rohkem puhkust ja paindlikku töökorraldust.\",\"image\":{\"authorPlain\":\"Liis Treimann\",\"type\":\"image\",\"objectId\":\"b1ec1833-9520-5c0a-b6c1-af848a77faa2\",\"width\":4159,\"height\":2773,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=b1ec1833-9520-5c0a-b6c1-af848a77faa2\",\"text\":\"Iga neljas üle 60aastane taanlane plaanib tööturule jääda. Võimalik, et see näitab, et kõiki ei pea selleks tõusva pensionieaga sundima.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Iga neljas üle 60aastane taanlane plaanib tööturule jääda. Võimalik, et see näitab, et kõiki ei pea selleks tõusva pensionieaga sundima.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"535f4b38-64a8-4a76-b12e-6946e97aa642\",\"type\":\"SubscriptionTag\",\"name\":\"Pension\",\"slug\":\"pension\"},{\"id\":\"530e4c09-4fd0-47c9-938b-dfa5c8485b21\",\"type\":\"SubscriptionTag\",\"name\":\"Tööturg\",\"slug\":\"tooturg\"},{\"id\":\"03c21282-1c2a-4469-a113-6cf6cc161c85\",\"type\":\"SubscriptionTag\",\"name\":\"puhkus\",\"slug\":\"puhkus\"},{\"id\":\"7f38ac12-0d7e-4832-89c0-c846c171c549\",\"type\":\"SubscriptionTag\",\"name\":\"Sotsiaalministeerium\",\"slug\":\"sotsiaalministeerium\"},{\"id\":\"c4366527-e928-4164-bc95-daf39894ac21\",\"type\":\"SubscriptionTag\",\"name\":\"Palgad\",\"slug\":\"palgad\"},{\"id\":\"1664f2eb-bf62-41d1-8152-6097b31cce0d\",\"type\":\"SubscriptionTag\",\"name\":\"Elu ja edu\",\"slug\":\"elu-ja-edu\"},{\"id\":\"8b361e09-895b-417d-8fb9-f4c1bfcacc53\",\"type\":\"InfopankPerson\",\"externalId\":\"295700\",\"name\":\"Ulla Saar\"},{\"id\":\"ce092963-e6c4-434f-90fd-7a9901702b3d\",\"type\":\"InfopankOrganisation\",\"externalId\":\"75355\",\"name\":\"SOTSIAALMINISTEERIUM TRAS\"},{\"id\":\"fdb4e1bd-bdcf-42f6-9c1e-591ba1e16f8c\",\"type\":\"InfopankOrganisation\",\"externalId\":\"171054\",\"name\":\"EESTI TÖÖTUKASSA AVOIG\"},{\"id\":\"2d91574e-d3ba-4d94-9da5-4e1a3d7f5d79\",\"type\":\"InfopankOrganisation\",\"externalId\":\"80777\",\"name\":\"RAHANDUSMINISTEERIUM TRAS\"},{\"id\":\"54167fd4-78cd-484a-ad39-61774f70ce87\",\"type\":\"SubscriptionTag\",\"name\":\"Borsen\",\"slug\":\"borsen\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/11/kindral-heremi-naasmine-voimukoridori-toi-esimese-ohvri-kas-ta-demokraatia-jaoks-hea-on-kahtlen\",\"publishStartDate\":\"2026-09-12T03:00:00.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"5526b7f7-dd97-486a-948a-99c1119d0d2a\",\"version\":31,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\"}]},\"headlinePlain\":\"Kindral Heremi naasmine võimukoridori tõi esimese ohvri. “Kas ta demokraatia jaoks hea on? Kahtlen”\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"2024. aastal pühkis kindral Martin Herem käed kaitseväe juhataja raskest tööst puhtaks, pani ukse enda järel kinni ja lahkus vaba mehena. Nüüd naaseb ta pauguga sinnasamma ministeeriumisse, mille aeglust omal ajal siunas, et ise ministrina teisiti teha.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"2024. aastal pühkis kindral Martin Herem käed kaitseväe juhataja raskest tööst puhtaks, pani ukse enda järel kinni ja lahkus vaba mehena. Nüüd naaseb ta pauguga sinnasamma ministeeriumisse, mille aeglust omal ajal siunas, et ise ministrina teisiti teha.\",\"image\":{\"authorPlain\":\"Kiur Kaasik/Delfi Meedia/Scanpix\",\"type\":\"image\",\"objectId\":\"98cf779f-ddbb-5eae-b3a2-1374044c0a7b\",\"width\":5298,\"height\":3311,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=98cf779f-ddbb-5eae-b3a2-1374044c0a7b\",\"text\":\"Pärast Hanno Pevkuri kahimist tuli peaminister Kristen Michalil Martin Heremi (pildil) avangus ohverdada ka kaitseministeeriumi kantsler Kaimo Kuusk.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Pärast Hanno Pevkuri kahimist tuli peaminister Kristen Michalil Martin Heremi (pildil) avangus ohverdada ka kaitseministeeriumi kantsler Kaimo Kuusk.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"393e6028-0bbb-46ff-8715-658c389d3085\",\"type\":\"SubscriptionTag\",\"name\":\"Poliitika\",\"slug\":\"poliitika\"},{\"id\":\"70ea6cf6-fdb5-47c0-9a77-e6cfd5f9ed21\",\"type\":\"SubscriptionTag\",\"name\":\"Riigikogu\",\"slug\":\"riigikogu\"},{\"id\":\"4f51101e-857b-45a0-bab6-99de7e1f1ac5\",\"type\":\"SubscriptionTag\",\"name\":\"Julgeolek\",\"slug\":\"julgeolek\"},{\"id\":\"42037e87-3aec-4e75-b37c-a4f0e6a8dfdd\",\"type\":\"SubscriptionTag\",\"name\":\"Kaitsetööstus\",\"slug\":\"kaitsetoostus\"},{\"id\":\"100e51bf-9bb4-48ba-a295-81b5685b73e7\",\"type\":\"SubscriptionTag\",\"name\":\"Valitsus\",\"slug\":\"valitsus\"}],\"marketInstruments\":[]},{\"permalink\":\"/uudised/2026/09/11/tuntud-poliitikust-arimees-laks-pankrotti\",\"publishStartDate\":\"2026-09-11T13:16:02.000Z\",\"previewVideo\":null,\"hasEmbed\":false,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"19fb134e-6a8e-4ea0-a9bf-84365e4291c0\",\"version\":3,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":false,\"freemium\":false,\"public\":false,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Tuntud poliitikust ärimees läks pankrotti\"}]},\"headlinePlain\":\"Tuntud poliitikust ärimees läks pankrotti\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Kohus kuulutas välja kunagise Tallinna linnapea, Isamaa poliitikust ärimehe Tõnis Paltsi pankroti.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Kohus kuulutas välja kunagise Tallinna linnapea, Isamaa poliitikust ärimehe Tõnis Paltsi pankroti.\",\"image\":{\"authorPlain\":\"Liis Treimann\",\"type\":\"image\",\"objectId\":\"0cc9e743-7a6b-5b6d-ae0a-5211a80cc3a6\",\"width\":4990,\"height\":3311,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=0cc9e743-7a6b-5b6d-ae0a-5211a80cc3a6\",\"text\":\"Tõnis Palts oli mõni aasta tagasi Levikomi saneerimisavaldusega kohtus, kuid telekomifirma läks hiljuti pankrotti. Nüüd kuulutas kohus välja ka Paltsi pankroti.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Tõnis Palts oli mõni aasta tagasi Levikomi saneerimisavaldusega kohtus, kuid telekomifirma läks hiljuti pankrotti. Nüüd kuulutas kohus välja ka Paltsi pankroti.\"},\"updated\":null,\"category\":{\"id\":\"news\",\"slug\":\"uudised\",\"name\":\"Uudised\"},\"options\":{},\"tags\":[{\"id\":\"bb04ab71-b0e1-487d-8287-5b74492c2187\",\"type\":\"SubscriptionTag\",\"name\":\"Kohus\",\"slug\":\"kohus\"},{\"id\":\"7e61226f-5616-476e-bcf2-246e38973765\",\"type\":\"SubscriptionTag\",\"name\":\"Pankrot\",\"slug\":\"pankrot\"},{\"id\":\"393e6028-0bbb-46ff-8715-658c389d3085\",\"type\":\"SubscriptionTag\",\"name\":\"Poliitika\",\"slug\":\"poliitika\"},{\"id\":\"63e8c116-0680-4195-9d4e-602d221b008c\",\"type\":\"SubscriptionTag\",\"name\":\"Ukraina\",\"slug\":\"ukraina\"},{\"id\":\"2f672cd6-36ca-46b4-9e2c-4a6a2df9c89b\",\"type\":\"SubscriptionTag\",\"name\":\"telekom\",\"slug\":\"telekom\"},{\"id\":\"bb3c7cf6-0b35-4242-84a1-b79607d6f65a\",\"type\":\"InfopankPerson\",\"externalId\":\"45147\",\"name\":\"Tõnis Palts\"},{\"id\":\"bea746b7-5c0f-4115-8cad-aa2aaf6dd1cf\",\"type\":\"InfopankPerson\",\"externalId\":\"128915\",\"name\":\"Andrias Palmits\"},{\"id\":\"067b4dda-d1b1-471f-a540-97a6ed43ac40\",\"type\":\"InfopankPerson\",\"externalId\":\"3372\",\"name\":\"Parvel Pruunsild\"},{\"id\":\"d731f074-b12d-48ab-830f-52db97161be7\",\"type\":\"InfopankOrganisation\",\"externalId\":\"142226\",\"name\":\"LEVIKOM EESTI OÜ\"},{\"id\":\"534fac8e-4b6c-491d-8530-67820ed265fe\",\"type\":\"InfopankOrganisation\",\"externalId\":