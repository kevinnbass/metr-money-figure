ull,{\"className\":\"body\",\"children\":[\"$\",\"$L2\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$7a\",\"errorStyles\":[],\"errorScripts\":[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/0_v7k2ha70ce5.js?dpl=bee90855ef2d9416055a5907684cd7ee7ef2f433\",\"async\":true}]],\"template\":[\"$\",\"$L3\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[\"$\",\"$L7b\",null,{}],[]],\"forbidden\":\"$undefined\",\"unauthorized\":\"$undefined\"}]}],[\"$\",\"$L7c\",null,{}],[\"$\",\"$L7d\",null,{}]]}]}]]}]}]]}]}]}]}]}]}]}]}]}]}]\n62:[\"$\",\"$L7e\",null,{\"id\":\"article-footer\",\"layout\":\"compact\",\"variationId\":\"f7a2974d-76e9-451f-b8ad-9fa65302456e\",\"module\":{\"type\":\"ai_chat\",\"configuration\":{\"openAiRequest\":\"\",\"layout\":\"white_narrow\",\"subtitle\":\"Küsi Äripäevalt\",\"description\":\"Tehisaru vastab sinu küsimustele Äripäevas ja kõigis teemaveebides ilmunud artiklite põhjal.\",\"questionsBlock\":{\"title\":\"\",\"questions\":[{\"question\":\"Milline on Jaan Tallinna roll AI turvalisuse tagamisel globaliseeruvas maailmas?\"},{\"question\":\"Kuidas Jaan Tallinna investeeringud mõjutavad tehnoloogiasektori arengut Eestis ja maailmas?\"},{\"question\":\"Kas ja miks peaks AI arendustempo aeglustuma, nagu Jaan Tallinn soovitab?\"},{\"question\":\"Milline mõju on Jaan Tallinna tegevusel Eesti tehnoloogiaettevõtete innovatsiooni ja koostöövõimekusele?\"}]},\"footer\":\"Äripäeva tehisaru otsib vastuseid artiklitest, mis on ilmunud Äripäevas, selle 14 teemaveebis ning Imelises Teaduses, Imelises Ajaloos ja Kalastajas viimase viie aasta jooksul. Vastuseid koostab tehisarusüsteem, mitte inimene. Tehisaru võib teha vigu, seepärast soovitame alati tutvuda originaaltekstidega, millele on vastuse juures viidatud. Äripäeva toimetus ei kontrolli tehisaru antavaid vastuseid, kuid võib neid vaadata hiljem, et teenust arendada.\",\"buttonLabel\":\"Uus küsimus\"},\"id\":\"\",\"label\":\"AI Chat\",\"gaId\":\"\"}}]\n63:[\"$\",\"div\",null,{\"className\":\"article-footer__left\",\"children\":false}]\n64:[\"$\",\"div\",null,{\"className\":\"article-footer__right\"}]\n65:[\"$\",\"$L7f\",null,{\"width\":\"limited\",\"children\":[\"$\",\"$L80\",null,{\"type\":\"Module\",\"position\":1}]}]\n66:[\"$\",\"$L81\",null,{\"articles\":[{\"permalink\":\"/uudised/2025/12/17/aripaeva-aasta-ettevotja-selgub-10-nominendi-hulgast-anna-oma-haal\",\"publishStartDate\":\"2025-12-17T07:30:00.000Z\",\"previewVideo\":null,\"hasEmbed\":true,\"hasGallery\":false,\"hasVideo\":false,\"type\":\"articleLink\",\"id\":\"2be53a73-e240-4497-a44c-8afb204ec563\",\"version\":31,\"channels\":[\"aripaev\"],\"access\":{\"pro\":true,\"subscriber\":true,\"investor\":true,\"freemium\":true,\"public\":true,\"doctor\":true},\"headline\":{\"type\":\"headline\",\"contents\":[{\"type\":\"text\",\"content\":\"Äripäeva aasta ettevõtja selgub 10 nominendi hulgast. Anna oma hääl!\"}]},\"headlinePlain\":\"Äripäeva aasta ettevõtja selgub 10 nominendi hulgast. Anna oma hääl!\",\"leadIn\":{\"contents\":[{\"type\":\"text\",\"content\":\"Äripäeva aasta ettevõtja valimisel jõudis nominentide sekka 10 firmaomanikku, kelle seas on nii rahvusvahelise haardega ettevõtjaid kui ka kohalikul tasandil olulisi tegijaid.\"}],\"type\":\"leadIn\"},\"leadInPlain\":\"Äripäeva aasta ettevõtja valimisel jõudis nominentide sekka 10 firmaomanikku, kelle seas on nii rahvusvahelise haardega ettevõtjaid kui ka kohalikul tasandil olulisi tegijaid.\",\"image\":{\"authorPlain\":\"Liis Treimann\",\"type\":\"image\",\"objectId\":\"e047b473-54ea-5d12-8fcd-1f5e7f2efa87\",\"width\":5606,\"height\":3859,\"alignment\":null,\"url\":\"https://static-img.aripaev.ee/?type=preview\u0026uuid=e047b473-54ea-5d12-8fcd-1f5e7f2efa87\",\"text\":\"Äripäev valis 2024. aasta ettevõtjaks Sunly asutaja ja tegevjuhi Priit Lepasepa.\",\"titleAbove\":null,\"titleBelow\":null,\"alt\":\"Äripäev valis 2024. aasta ettevõtjaks Sunly asutaja ja tegevjuhi Priit Lepasepa.\"},\"updated\